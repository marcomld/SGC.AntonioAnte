@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <i class="bi bi-map-fill text-primary"></i>
            <span class="fw-bold tracking-tight">SGC Antonio Ante</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column pb-4">

        <div class="nav-item px-3 mt-3">
            <NavLink class="nav-link rounded-3" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door me-2"></i> Inicio
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <!-- MÓDULO CATASTRAL -->
                <div class="nav-item-header px-3 mt-4 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.70rem; letter-spacing: 0.5px;">
                    Módulo Catastral
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link rounded-3" href="catastro/predios">
                        <i class="bi bi-house-fill me-2"></i> Predios
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link rounded-3" href="catastro/propietarios">
                        <i class="bi bi-people-fill me-2"></i> Sujetos de Derecho
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link rounded-3" href="catastro/visor">
                        <i class="bi bi-globe-americas me-2"></i> Visor Geográfico
                    </NavLink>
                </div>

                <!-- MÓDULO AVALÚOS -->
                <div class="nav-item-header px-3 mt-4 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.70rem; letter-spacing: 0.5px;">
                    Módulo Avalúos
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link rounded-3" href="administracion/parametros-avaluos">
                        <i class="bi bi-cash-coin me-2"></i> Parámetros Económicos
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="AdminSistemas,SuperAdmin">
            <!-- ADMINISTRACIÓN Y SEGURIDAD -->
            <div class="nav-item-header px-3 mt-4 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.70rem; letter-spacing: 0.5px;">
                Seguridad y Sistema
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link rounded-3" href="seguridad/usuarios">
                    <i class="bi bi-person-badge me-2"></i> Usuarios del GAD
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link rounded-3" href="seguridad/roles">
                    <i class="bi bi-shield-lock me-2"></i> Roles y Permisos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link rounded-3" href="seguridad/departamentos" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-building-fill me-2"></i> Departamentos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link rounded-3" href="seguridad/auditoria">
                    <i class="bi bi-journal-code me-2"></i> Auditoría
                </NavLink>
            </div>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}