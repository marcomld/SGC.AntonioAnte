@page "/nueva-password"
@layout AuthLayout
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using SGC.AntonioAnte.Client.Services.Contracts
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Auth
@using SGC.AntonioAnte.Client.Infrastructure.Security
@inject PasswordRecoveryState RecoveryState
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-light-gray px-3">
    <div class="login-card shadow-lg w-100" style="max-width: 480px;">
        <div class="card-accent-bar"></div>

        <div class="p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="mb-3 d-inline-block p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-shield-check fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark">Nueva Contraseña</h3>
                <p class="text-muted small">Crea una nueva contraseña corporativa segura para: <br /><strong class="text-dark">@restablecerDto.Email</strong></p>
            </div>

            @if (!string.IsNullOrEmpty(errorMensaje))
            {
                <div class="alert alert-danger border-0 shadow-sm small mb-4 d-flex align-items-center" role="alert" style="background-color: #fce8e8; color: #b91c1c;">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                    <div>@errorMensaje</div>
                </div>
            }

            <EditForm Model="@restablecerDto" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="form-floating mb-3 position-relative">
                    <InputText type="@(verPassword ? "text" : "password")" class="form-control bg-primary bg-opacity-10 border-primary border-opacity-25" id="password" placeholder="Nueva Contraseña" @bind-Value="restablecerDto.NuevaPassword" autocomplete="new-password" disabled="@procesando" />
                    <label for="password">Nueva Contraseña Corporativa</label>
                    <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-2 me-2 text-muted z-3 text-decoration-none" @onclick="ToggleVerPassword" tabindex="-1" style="box-shadow: none;">
                        <i class="bi @(verPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                    <ValidationMessage For="@(() => restablecerDto.NuevaPassword)" class="text-danger small mt-1" />
                </div>

                <div class="form-floating mb-4 position-relative">
                    <InputText type="@(verConfirmar ? "text" : "password")" class="form-control" id="confirmPassword" placeholder="Confirmar Contraseña" @bind-Value="confirmarPassword" autocomplete="new-password" disabled="@procesando" />
                    <label for="confirmPassword">Confirmar Contraseña</label>
                    <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-2 me-2 text-muted z-3 text-decoration-none" @onclick="ToggleVerConfirmar" tabindex="-1" style="box-shadow: none;">
                        <i class="bi @(verConfirmar ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>

                <div class="d-grid gap-2 mb-2">
                    <button type="submit" class="btn btn-primary btn-lg shadow-hover fw-semibold" disabled="@procesando">
                        @if (procesando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span> <span>Guardando Cambios...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-circle me-1"></i> Actualizar Contraseña</span>
                        }
                    </button>
                </div>
                
                <div class="text-center mt-3">
                    <button type="button"
                            class="btn btn-link small text-decoration-none
                        text-muted fw-semibold"
                            @onclick="CancelarRecuperacion"
                            disabled="@procesando">
                        Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .bg-light-gray {
        background-color: var(--bg-body, #f8fafc);
    }

    .login-card {
        background-color: var(--bg-surface, #ffffff);
        border-radius: var(--radius-lg, 1rem);
        border: 1px solid var(--border-color, #e2e8f0);
    }

    .card-accent-bar {
        height: 4px;
        width: 100%;
        background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
    }

    .form-control:focus {
        border-color: var(--brand-accent, #2563eb);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }
</style>

@code {
    private ResetPasswordDto restablecerDto = new();
    private string confirmarPassword = string.Empty;
    private string errorMensaje = string.Empty;
    private bool procesando = false;
    private bool verPassword = false;
    private bool verConfirmar = false;

    protected override void OnInitialized()
    {
        if (!RecoveryState.TieneAutorizacion)
        {
            RecoveryState.Limpiar();

            Navigation.NavigateTo(
                "/recuperar-password",
                replace: true);

            return;
        }

        restablecerDto.Email = RecoveryState.Email!;

        restablecerDto.ResetToken =
            RecoveryState.ResetToken!;
    }

    private void ToggleVerPassword() => verPassword = !verPassword;
    private void ToggleVerConfirmar() => verConfirmar = !verConfirmar;

    private async Task HandleValidSubmit()
    {
        if (procesando)
            return;

        if (!RecoveryState.TieneAutorizacion)
        {
            RecoveryState.Limpiar();

            errorMensaje =
                "La autorización ha expirado. " +
                "Inicie una nueva recuperación.";

            return;
        }

        if (string.IsNullOrWhiteSpace(
                restablecerDto.NuevaPassword) ||
            string.IsNullOrWhiteSpace(confirmarPassword))
        {
            errorMensaje =
                "Todos los campos de contraseña son obligatorios.";

            return;
        }

        if (restablecerDto.NuevaPassword != confirmarPassword)
        {
            errorMensaje = "Las contraseñas no coinciden.";
            return;
        }

        procesando = true;
        errorMensaje = string.Empty;

        try
        {
            var resultado =
                await AuthService.RestablecerPasswordAsync(
                    restablecerDto);

            if (resultado.Exitoso)
            {
                RecoveryState.Limpiar();

                restablecerDto = new ResetPasswordDto();
                confirmarPassword = string.Empty;

                await LocalStorage.RemoveItemAsync(
                    "tiempoReenvioCodigo");

                Navigation.NavigateTo(
                    "/login",
                    replace: true);

                return;
            }

            errorMensaje = resultado.Mensaje;
        }
        finally
        {
            procesando = false;
        }
    }

    private void CancelarRecuperacion()
    {
        RecoveryState.Limpiar();

        restablecerDto = new ResetPasswordDto();
        confirmarPassword = string.Empty;

        Navigation.NavigateTo("/login", replace: true);
    }
}