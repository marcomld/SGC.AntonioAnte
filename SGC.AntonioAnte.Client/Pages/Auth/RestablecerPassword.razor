@page "/restablecer-password"
@layout AuthLayout
@implements IDisposable
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using SGC.AntonioAnte.Client.Services.Contracts
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-light-gray px-3">
    <div class="login-card shadow-lg w-100" style="max-width: 480px;">
        <div class="card-accent-bar"></div>

        <div class="p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="mb-3 d-inline-block p-3 rounded-circle bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark">Nueva Contraseña</h3>
                <p class="text-muted small">Ingresa el código seguro de 6 dígitos enviado al correo: <strong class="text-dark">@restablecerDto.Email</strong></p>
            </div>

            <EditForm Model="@restablecerDto" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMensaje))
                {
                    <div class="alert alert-danger border-0 shadow-sm small mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMensaje
                    </div>
                }
                @if (!string.IsNullOrEmpty(mensajeReenvioExitoso))
                {
                    <div class="alert alert-success border-0 shadow-sm small mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @mensajeReenvioExitoso
                    </div>
                }

                <div class="d-flex justify-content-between mb-4">
                    @for (int i = 0; i < 6; i++)
                    {
                        var currentIndex = i;
                        <input @ref="otpInputs[currentIndex]"
                               type="text"
                               inputmode="numeric"
                               class="form-control text-center fw-bold fs-3 otp-input shadow-sm"
                               value="@otpArray[currentIndex]"
                               @oninput="@(e => HandleOtpInput(e, currentIndex))"
                               @onkeydown="@(e => HandleOtpKeyDown(e, currentIndex))"
                               disabled="@procesando" />
                    }
                </div>

                <div class="form-floating mb-3 position-relative">
                    <InputText type="@(verPassword ? "text" : "password")" class="form-control" id="password" placeholder="Nueva Contraseña" @bind-Value="restablecerDto.NuevaPassword" />
                    <label for="password">Nueva Contraseña Corporativa</label>
                    <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-2 me-2 text-muted z-3 text-decoration-none" @onclick="ToggleVerPassword" tabindex="-1" style="box-shadow: none;">
                        <i class="bi @(verPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                    <ValidationMessage For="@(() => restablecerDto.NuevaPassword)" class="text-danger small mt-1" />
                </div>

                <div class="form-floating mb-4 position-relative">
                    <InputText type="@(verConfirmar ? "text" : "password")" class="form-control" id="confirmPassword" placeholder="Confirmar Contraseña" @bind-Value="confirmarPassword" />
                    <label for="confirmPassword">Confirmar Contraseña</label>
                    <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-2 me-2 text-muted z-3 text-decoration-none" @onclick="ToggleVerConfirmar" tabindex="-1" style="box-shadow: none;">
                        <i class="bi @(verConfirmar ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>

                <div class="d-grid gap-2 mb-4">
                    <button type="submit" class="btn btn-primary btn-lg shadow-hover fw-semibold" disabled="@procesando">
                        @if (procesando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span> <span>Validando y Aplicando...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-circle me-1"></i> Actualizar Contraseña</span>
                        }
                    </button>
                </div>

                <div class="text-center mt-2 border-top pt-3">
                    <span class="small text-muted me-1">¿No recibiste el código?</span>
                    @if (TemporizadorActivo)
                    {
                        <span class="small fw-bold text-muted">Reenviar en @FormatearTiempo(reenvioSegundos)</span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-link p-0 small fw-bold text-decoration-none link-accent" @onclick="ReenviarCodigo" disabled="@procesando">
                            Reenviar Código Ahora
                        </button>
                    }
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .bg-light-gray {
        background-color: #f8fafc;
    }

    .login-card {
        background-color: #ffffff;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .card-accent-bar {
        height: 4px;
        width: 100%;
        background: linear-gradient(90deg, var(--brand-accent) 0%, #7c3aed 100%);
    }

    .form-control:focus {
        border-color: var(--brand-accent);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }

    .link-accent {
        color: var(--brand-accent);
        transition: color 0.2s;
    }

        .link-accent:hover {
            color: #1d4ed8;
            text-decoration: underline !important;
        }

    .otp-input {
        width: 3.5rem;
        height: 4rem;
        border-radius: 0.75rem;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        color: var(--brand-primary);
        transition: all 0.2s ease-in-out;
    }

        .otp-input:focus {
            background-color: #ffffff;
            transform: translateY(-2px);
        }

    @@media (max-width: 450px) {
        .otp-input {
            width: 2.8rem;
            height: 3.5rem;
            font-size: 1.5rem !important;
        }
    }
</style>

@code {
    private ResetPasswordDto restablecerDto = new();
    private string confirmarPassword = string.Empty;
    private string errorMensaje = string.Empty;
    private string mensajeReenvioExitoso = string.Empty;
    private bool procesando = false;
    private bool isDisposed = false;

    private bool verPassword = false;
    private bool verConfirmar = false;

    private string[] otpArray = new string[6] { "", "", "", "", "", "" };
    private ElementReference[] otpInputs = new ElementReference[6];

    private const string LLAVE_TIEMPO_RESETEO = "tiempoReenvioCodigo";
    private int reenvioSegundos = 0;
    private bool TemporizadorActivo => reenvioSegundos > 0;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            restablecerDto.Email = Email;
        }

        var finTemporizadorStr = await LocalStorage.GetItemAsync(LLAVE_TIEMPO_RESETEO);
        if (!string.IsNullOrEmpty(finTemporizadorStr) && long.TryParse(finTemporizadorStr, out long tiempoExpiracionUnix))
        {
            var segundosRestantes = (int)(tiempoExpiracionUnix - DateTimeOffset.UtcNow.ToUnixTimeSeconds());
            if (segundosRestantes > 0)
            {
                reenvioSegundos = segundosRestantes;
                _ = IniciarTemporizador();
            }
            else
            {
                reenvioSegundos = 0;
            }
        }
        else
        {
            reenvioSegundos = 120;
            var nuevoTiempoUnix = DateTimeOffset.UtcNow.AddSeconds(120).ToUnixTimeSeconds();
            await LocalStorage.SetItemAsync(LLAVE_TIEMPO_RESETEO, nuevoTiempoUnix.ToString());
            _ = IniciarTemporizador();
        }
    }

    public void Dispose()
    {
        isDisposed = true;
    }

    private void ToggleVerPassword() => verPassword = !verPassword;
    private void ToggleVerConfirmar() => verConfirmar = !verConfirmar;

    // 🚀 CONTROLADOR DE ENTRADA OTP CON SOPORTE PEGAR (CTRL + V)
    private async Task HandleOtpInput(ChangeEventArgs e, int index)
    {
        string val = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrEmpty(val))
        {
            otpArray[index] = string.Empty;
            restablecerDto.Token = string.Join("", otpArray);
            return;
        }

        // 🚀 CASO A: EL USUARIO PEGA EL CÓDIGO (Ej: "123456" o "OTP-123456")
        if (val.Length > 1)
        {
            var soloNumeros = new string(val.Where(char.IsDigit).ToArray());

            for (int k = 0; k < 6; k++)
            {
                if (k < soloNumeros.Length)
                {
                    otpArray[k] = soloNumeros[k].ToString();
                }
            }

            restablecerDto.Token = string.Join("", otpArray);

            int ultimoFoco = Math.Min(soloNumeros.Length, 6) - 1;
            if (ultimoFoco >= 0 && ultimoFoco < 6)
            {
                await otpInputs[ultimoFoco].FocusAsync();
            }
            return;
        }

        // 🚀 CASO B: EL USUARIO ESCRIBE UN SOLO NÚMERO MANUALMENTE
        if (char.IsDigit(val[0]))
        {
            otpArray[index] = val[0].ToString();
            restablecerDto.Token = string.Join("", otpArray);

            if (index < 5)
            {
                await otpInputs[index + 1].FocusAsync();
            }
        }
        else
        {
            otpArray[index] = string.Empty;
            restablecerDto.Token = string.Join("", otpArray);
        }
    }

    private async Task HandleOtpKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otpArray[index]) && index > 0)
        {
            otpArray[index - 1] = string.Empty;
            restablecerDto.Token = string.Join("", otpArray);
            await otpInputs[index - 1].FocusAsync();
        }
    }

    private async Task IniciarTemporizador()
    {
        while (reenvioSegundos > 0 && !isDisposed)
        {
            await Task.Delay(1000);
            if (!isDisposed)
            {
                reenvioSegundos--;
                StateHasChanged();
            }
        }
    }

    private string FormatearTiempo(int segundos)
    {
        return $"{segundos / 60:D2}:{segundos % 60:D2}";
    }

    private async Task ReenviarCodigo()
    {
        procesando = true;
        errorMensaje = string.Empty;
        mensajeReenvioExitoso = string.Empty;

        var dtoCorreo = new ForgotPasswordDto { Email = restablecerDto.Email };
        var resultado = await AuthService.SolicitarRecuperacionAsync(dtoCorreo);

        if (resultado.Exitoso)
        {
            mensajeReenvioExitoso = "Se ha enviado un nuevo código seguro a tu correo institucional.";

            for (int i = 0; i < 6; i++) { otpArray[i] = string.Empty; }
            restablecerDto.Token = string.Empty;

            reenvioSegundos = 120;
            var nuevoTiempoUnix = DateTimeOffset.UtcNow.AddSeconds(120).ToUnixTimeSeconds();
            await LocalStorage.SetItemAsync(LLAVE_TIEMPO_RESETEO, nuevoTiempoUnix.ToString());
            _ = IniciarTemporizador();
        }
        else
        {
            errorMensaje = "Ocurrió un error al intentar reenviar el código. Intente de nuevo más tarde.";
        }
        procesando = false;
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(restablecerDto.Token) || restablecerDto.Token.Length != 6)
        {
            errorMensaje = "Debe ingresar el código de verificación completo de 6 dígitos enviado por el GAD.";
            return;
        }

        if (string.IsNullOrWhiteSpace(restablecerDto.NuevaPassword) || string.IsNullOrWhiteSpace(confirmarPassword))
        {
            errorMensaje = "Todos los campos de contraseña son obligatorios.";
            return;
        }

        if (restablecerDto.NuevaPassword != confirmarPassword)
        {
            errorMensaje = "La nueva contraseña y la confirmación no coinciden entre sí.";
            return;
        }

        procesando = true;
        errorMensaje = string.Empty;
        mensajeReenvioExitoso = string.Empty;

        var resultado = await AuthService.RestablecerPasswordAsync(restablecerDto);

        if (resultado.Exitoso)
        {
            await LocalStorage.RemoveItemAsync(LLAVE_TIEMPO_RESETEO);
            Navigation.NavigateTo("/login");
        }
        else
        {
            errorMensaje = resultado.Mensaje;
        }

        procesando = false;
    }
}