@page "/recuperar-password"
@layout AuthLayout
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using SGC.AntonioAnte.Shared.DTOs.Seguridad
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-light-gray px-3">
    <div class="login-card shadow-lg w-100" style="max-width: 460px;">
        <div class="card-accent-bar"></div>

        <div class="p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="mb-3 d-inline-block p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-envelope-paper-fill fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark">Recuperar Clave</h3>
                <p class="text-muted small">Ingresa tu correo institucional registrado para enviarte un código seguro OTP.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMensaje))
            {
                <div class="alert alert-danger border-0 shadow-sm small mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @errorMensaje
                </div>
            }

            <EditForm Model="@correoDto" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="form-floating mb-4">
                    <InputText id="email" class="form-control" placeholder="usuario@antonioante.gob.ec" @bind-Value="@correoDto.Email" disabled="@procesando" />
                    <label for="email">Correo Electrónico Institucional</label>
                    <ValidationMessage For="@(() => correoDto.Email)" class="text-danger small mt-1" />
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-lg shadow-hover fw-semibold" disabled="@procesando">
                        @if (procesando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Verificando Funcionario...</span>
                        }
                        else
                        {
                            <span>Generar Código Seguro</span>
                        }
                    </button>
                </div>

                <div class="text-center mt-4">
                    <a href="login" class="small text-decoration-none fw-semibold link-accent">
                        <i class="bi bi-arrow-left"></i> Volver al Login
                    </a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .bg-light-gray {
        background-color: #f8fafc;
    }

    .login-card {
        background-color: #ffffff;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .card-accent-bar {
        height: 4px;
        width: 100%;
        background: linear-gradient(90deg, var(--brand-accent) 0%, #7c3aed 100%);
    }

    .link-accent {
        color: var(--brand-accent);
        font-weight: 600;
    }

    .form-control:focus {
        border-color: var(--brand-accent);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
    }
</style>

@code {
    private ForgotPasswordDto correoDto = new();
    private bool procesando = false;
    private string errorMensaje = string.Empty;

    private async Task HandleValidSubmit()
    {
        procesando = true;
        errorMensaje = string.Empty;

        // Invocamos al servicio modificado
        var resultado = await UsuarioService.SolicitarRecuperacionAsync(correoDto);

        if (resultado.Exitoso)
        {
            // Si todo está perfecto en el backend, redirigimos inyectando el parámetro
            Navigation.NavigateTo($"/restablecer-password?email={Uri.EscapeDataString(correoDto.Email)}");
        }
        else
        {
            // AQUÍ SE PINTA EL VERDADERO ERROR DE MAILTRAP/BACKEND TRASPASADO DESDE SWAGGER
            errorMensaje = resultado.Mensaje;
        }

        procesando = false;
    }
}