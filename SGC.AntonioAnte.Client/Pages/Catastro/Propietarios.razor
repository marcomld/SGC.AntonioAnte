@code {
    private ResultadoPaginadoDto<PropietarioDto>? resultadoPaginado = null;
    private bool cargando = true;

    // Filtros
    private string busquedaFiltro = string.Empty;
    private string filtroEstadoTexto = "TODOS";
    private string filtroPersoneriaTexto = "TODOS";
    private int paginaActual = 1;
    private int registrosPorPagina = 10;
    private Timer? _debounceTimer;

    // Toast Corporativo
    private string toastMensaje = string.Empty;
    private bool toastEsExito = true;
    private CancellationTokenSource? toastCts;

    // Modales
    private bool mostrarModalCrear = false;
    private bool procesandoModalCrear = false;
    private string modalCrearErrorMensaje = string.Empty;
    private CreatePropietarioDto modeloCreacion = new();

    private PropietarioDto? propietarioEditando = null;
    private UpdatePropietarioDto modeloEdicion = new();
    private string modalEditarErrorMensaje = string.Empty;
    private bool procesandoModalEditar = false;

    private PropietarioDto? propietarioAEstadoCambiar = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarPropietariosPaginados();
    }

    private async Task CargarPropietariosPaginados()
    {
        cargando = true;
        bool? estadoActivo = filtroEstadoTexto switch
        {
            "ACTIVO" => true,
            "INACTIVO" => false,
            _ => null
        };

        TipoPropietario? tipoProp = filtroPersoneriaTexto switch
        {
            "NATURAL" => TipoPropietario.Natural,
            "JURIDICO" => TipoPropietario.Juridico,
            _ => null
        };

        resultadoPaginado = await PropietarioService.ObtenerPaginadoAsync(
            busquedaFiltro,
            estadoActivo,
            tipoProp,
            paginaActual,
            registrosPorPagina);

        cargando = false;
    }

    private void OnBusquedaKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                paginaActual = 1;
                await CargarPropietariosPaginados();
                StateHasChanged();
            });
        }, null, 350, Timeout.Infinite);
    }

    private async Task OnFiltrosCambiados()
    {
        paginaActual = 1;
        await CargarPropietariosPaginados();
    }

    private async Task LimpiarFiltros()
    {
        busquedaFiltro = string.Empty;
        filtroEstadoTexto = "TODOS";
        filtroPersoneriaTexto = "TODOS";
        paginaActual = 1;
        await CargarPropietariosPaginados();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || (resultadoPaginado != null && nuevaPagina > resultadoPaginado.TotalPaginas)) return;
        paginaActual = nuevaPagina;
        await CargarPropietariosPaginados();
    }

    private async Task OnCambiarRegistrosPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoTam))
        {
            registrosPorPagina = nuevoTam;
            paginaActual = 1;
            await CargarPropietariosPaginados();
        }
    }

    private void AbrirModalCrear()
    {
        modeloCreacion = new CreatePropietarioDto
        {
            TipoPropietario = TipoPropietario.Natural,
            EstadoCivil = EstadoCivil.Soltero
        };
        modalCrearErrorMensaje = string.Empty;
        mostrarModalCrear = true;
    }

    private void CerrarModalCrear() => mostrarModalCrear = false;

    private async Task GuardarNuevoPropietario()
    {
        procesandoModalCrear = true;
        modalCrearErrorMensaje = string.Empty;

        try
        {
            var resultado = await PropietarioService.CrearAsync(modeloCreacion);

            if (resultado.Exitoso)
            {
                CerrarModalCrear();
                await CargarPropietariosPaginados();
                await MostrarToast("Propietario registrado correctamente.", true);
            }
            else
            {
                modalCrearErrorMensaje = resultado.Mensaje ?? "No se pudo registrar el propietario.";
            }
        }
        catch (Exception ex)
        {
            modalCrearErrorMensaje = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            procesandoModalCrear = false;
        }
    }

    private void AbrirModalEditar(PropietarioDto propietario)
    {
        modalEditarErrorMensaje = string.Empty;
        propietarioEditando = propietario;
        modeloEdicion = new UpdatePropietarioDto
        {
            Nombres = propietario.Nombres,
            Apellidos = propietario.Apellidos,
            RazonSocial = propietario.RazonSocial,
            EstadoCivil = propietario.EstadoCivil,
            Email = propietario.Email,
            Telefono = propietario.Telefono
        };
    }

    private void CerrarModalEditar()
    {
        propietarioEditando = null;
        modalEditarErrorMensaje = string.Empty;
        modeloEdicion = new UpdatePropietarioDto();
    }

    private async Task GuardarEdicion()
    {
        if (propietarioEditando == null) return;

        procesandoModalEditar = true;
        modalEditarErrorMensaje = string.Empty;

        var resultado = await PropietarioService.ActualizarAsync(propietarioEditando.Id, modeloEdicion);

        if (resultado.Exitoso)
        {
            CerrarModalEditar();
            await CargarPropietariosPaginados();
            await MostrarToast("Datos del propietario actualizados correctamente.", true);
        }
        else
        {
            modalEditarErrorMensaje = resultado.Mensaje ?? "No se pudo actualizar la información.";
        }

        procesandoModalEditar = false;
    }

    private void SolicitarCambioEstado(PropietarioDto propietario)
    {
        propietarioAEstadoCambiar = propietario;
    }

    private async Task ConfirmarCambioEstado()
    {
        if (propietarioAEstadoCambiar == null) return;

        var p = propietarioAEstadoCambiar;
        propietarioAEstadoCambiar = null;

        var resultado = await PropietarioService.CambiarEstadoAsync(p.Id);

        if (resultado.Exitoso)
        {
            await CargarPropietariosPaginados();
            await MostrarToast(resultado.Mensaje ?? "Estado del propietario actualizado correctamente.", true);
        }
        else
        {
            await MostrarToast(resultado.Mensaje ?? "No se pudo cambiar el estado del propietario.", false);
        }
    }

    private async Task MostrarToast(string mensaje, bool esExito = true)
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        toastMensaje = mensaje;
        toastEsExito = esExito;
        StateHasChanged();

        try
        {
            await Task.Delay(4000, toastCts.Token);
            toastMensaje = string.Empty;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void OcultarToast() => toastMensaje = string.Empty;

    private string ShortGuid(Guid id) => id.ToString().Length > 8 ? id.ToString().Substring(0, 8) + "..." : id.ToString();

    private static string FormatearEstadoCivil(EstadoCivil estado) => estado switch
    {
        EstadoCivil.Soltero => "Soltero/a",
        EstadoCivil.Casado => "Casado/a",
        EstadoCivil.Divorciado => "Divorciado/a",
        EstadoCivil.Viudo => "Viudo/a",
        EstadoCivil.UnionDeHecho => "Unión de Hecho",
        _ => "N/A"
    };
}