@page "/catastro/propietarios"
@using System.Threading
@using Microsoft.AspNetCore.Authorization
@using SGC.AntonioAnte.Client.Services.Catastro.Contracts
@using SGC.AntonioAnte.Domain.Catastro.Enums
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Propietarios
@using SGC.AntonioAnte.Shared.DTOs.Common

@inject IPropietarioService PropietarioService

<div class="container-fluid py-4 animate-fade-in">
    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-person-vcard-fill me-2 text-primary"></i>Sujetos de Derecho (Propietarios)
            </h1>
            <p class="text-muted small mb-0">Administración del padrón catastral de personas naturales y jurídicas del cantón.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm" @onclick="CargarPropietariosPaginados">
                <i class="bi bi-arrow-clockwise"></i> Refrescar
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-hover py-2 fw-semibold" @onclick="AbrirModalCrear">
                <i class="bi bi-person-plus-fill"></i> Registrar Propietario
            </button>
        </div>
    </div>

    <!-- TOAST FLOTANTE CORPORATIVO -->
    @if (!string.IsNullOrEmpty(toastMensaje))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
            <div class="toast show shadow-lg border-0 bg-white" role="alert">
                <div class="toast-header @(toastEsExito ? "bg-success text-white" : "bg-danger text-white") border-0 py-2">
                    <i class="bi @(toastEsExito ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2 fs-6"></i>
                    <strong class="me-auto">@(toastEsExito ? "Éxito" : "Atención")</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="OcultarToast"></button>
                </div>
                <div class="toast-body fw-medium text-dark py-3">
                    @toastMensaje
                </div>
            </div>
        </div>
    }

    <!-- BARRA DE FILTROS -->
    <div class="card border-0 shadow-sm mb-4 bg-white rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-bold mb-1">Búsqueda General</label>
                    <div class="position-relative">
                        <input type="text" class="form-control ps-5 py-2" placeholder="Buscar por cédula, RUC, nombres o razón social..." @bind="busquedaFiltro" @bind:event="oninput" @onkeyup="OnBusquedaKeyUp" />
                        <i class="bi bi-search position-absolute start-0 top-50 translate-middle-y ms-3 text-muted"></i>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Personería</label>
                    <select class="form-select py-2" @bind="filtroPersoneriaTexto" @bind:after="OnFiltrosCambiados">
                        <option value="TODOS">-- Toda Personería --</option>
                        <option value="NATURAL">Persona Natural</option>
                        <option value="JURIDICO">Persona Jurídica</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Estado</label>
                    <select class="form-select py-2" @bind="filtroEstadoTexto" @bind:after="OnFiltrosCambiados">
                        <option value="TODOS">-- Todos los Estados --</option>
                        <option value="ACTIVO">Activos</option>
                        <option value="INACTIVO">Inactivos</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end mt-auto pt-2 pt-md-0">
                    <button class="btn btn-light text-danger border w-100 py-2 fw-semibold" @onclick="LimpiarFiltros" title="Limpiar Filtros">
                        <i class="bi bi-eraser-fill me-1"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE DATOS -->
    <div class="card border-0 shadow-lg bg-white overflow-hidden rounded-4">
        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-4 py-3">Sujeto de Derecho</th>
                        <th class="py-3">Identificación</th>
                        <th class="py-3">Tipo Personería</th>
                        <th class="py-3">Contacto</th>
                        <th class="py-3 text-center">Estado</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted fw-medium">Consultando registros en el servidor...</span>
                            </td>
                        </tr>
                    }
                    else if (resultadoPaginado == null || !resultadoPaginado.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                <span class="small fw-semibold">No se encontraron propietarios que coincidan con los criterios.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in resultadoPaginado.Items)
                        {
                            <tr class="funcionario-row @(p.EstadoActivo ? "" : "table-light opacity-75")">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-table @(p.TipoPropietario == TipoPropietario.Juridico ? "avatar-juridico" : "avatar-natural")">
                                            @if (p.TipoPropietario == TipoPropietario.Natural)
                                            {
                                                <i class="bi bi-person-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-building"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark lh-1 mb-1">@p.NombreCompleto</div>
                                            @if (p.TipoPropietario == TipoPropietario.Natural && p.EstadoCivil != EstadoCivil.NoAplica)
                                            {
                                                <span class="text-muted small" style="font-size: 0.75rem;">Estado Civil: @FormatearEstadoCivil(p.EstadoCivil)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted font-monospace" style="font-size: 0.7rem;">ID: @ShortGuid(p.Id)</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 font-monospace fw-semibold text-secondary">@p.Identificacion</td>
                                <td class="py-3">
                                    @if (p.TipoPropietario == TipoPropietario.Natural)
                                    {
                                        <span class="badge-custom badge-natural">
                                            <i class="bi bi-person-fill me-1"></i> Natural
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom badge-juridica">
                                            <i class="bi bi-building me-1"></i> Jurídica
                                        </span>
                                    }
                                </td>
                                <td class="py-3 small">
                                    @if (!string.IsNullOrWhiteSpace(p.Email))
                                    {
                                        <div><i class="bi bi-envelope text-muted me-1"></i>@p.Email</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.Telefono))
                                    {
                                        <div><i class="bi bi-telephone text-muted me-1"></i>@p.Telefono</div>
                                    }
                                    @if (string.IsNullOrWhiteSpace(p.Email) && string.IsNullOrWhiteSpace(p.Telefono))
                                    {
                                        <span class="text-muted">Sin contacto</span>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    @if (p.EstadoActivo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary rounded-2 btn-action" title="Editar Propietario" @onclick="() => AbrirModalEditar(p)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        @if (p.EstadoActivo)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar Propietario" @onclick="() => SolicitarCambioEstado(p)">
                                                <i class="bi bi-person-x-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Activar Propietario" @onclick="() => SolicitarCambioEstado(p)">
                                                <i class="bi bi-person-check-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- PIE DE TABLA CON PAGINACIÓN SERVER-SIDE -->
        @if (resultadoPaginado != null && resultadoPaginado.TotalRegistros > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Mostrando <strong>@(((paginaActual - 1) * registrosPorPagina) + 1)</strong> a
                    <strong>@(Math.Min(paginaActual * registrosPorPagina, resultadoPaginado.TotalRegistros))</strong> de
                    <strong>@resultadoPaginado.TotalRegistros</strong> propietarios
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Filas:</span>
                        <select class="form-select form-select-sm" style="width: 70px;" value="@registrosPorPagina" @onchange="OnCambiarRegistrosPorPagina">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                        </select>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(resultadoPaginado.TienePaginaAnterior ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(1)" title="Primera página"><i class="bi bi-chevron-double-left"></i></button>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaAnterior ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual - 1)" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-item-text">Página @paginaActual de @resultadoPaginado.TotalPaginas</span>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaSiguiente ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual + 1)" title="Siguiente"><i class="bi bi-chevron-right"></i></button>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaSiguiente ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(resultadoPaginado.TotalPaginas)" title="Última página"><i class="bi bi-chevron-double-right"></i></button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL CREACIÓN PROPIETARIO -->
@if (mostrarModalCrear)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Registrar Sujeto de Derecho</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalCrear" disabled="@procesandoModalCrear"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalCrearErrorMensaje))
                    {
                        <div class="alert alert-danger border-0 shadow-sm small mb-3 rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @modalCrearErrorMensaje
                        </div>
                    }

                    <EditForm Model="@modeloCreacion" OnValidSubmit="GuardarNuevoPropietario">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputSelect id="ddlTipoSujeto" class="form-select" @bind-Value="modeloCreacion.TipoPropietario" disabled="@procesandoModalCrear">
                                        <option value="@TipoPropietario.Natural">Persona Natural</option>
                                        <option value="@TipoPropietario.Juridico">Persona Jurídica</option>
                                    </InputSelect>
                                    <label for="ddlTipoSujeto">Tipo de Personería</label>
                                    <ValidationMessage For="@(() => modeloCreacion.TipoPropietario)" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtIdentificacion" class="form-control" placeholder="Identificación" @bind-Value="modeloCreacion.Identificacion" maxlength="13" disabled="@procesandoModalCrear" />
                                    <label for="txtIdentificacion">@(modeloCreacion.TipoPropietario == TipoPropietario.Natural ? "Cédula / RUC Natural" : "RUC Jurídico / Público")</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Identificacion)" class="text-danger small mt-1" />
                                </div>
                            </div>

                            @if (modeloCreacion.TipoPropietario == TipoPropietario.Natural)
                            {
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputText id="txtNombres" class="form-control" placeholder="Nombres" @bind-Value="modeloCreacion.Nombres" disabled="@procesandoModalCrear" />
                                        <label for="txtNombres">Nombres Completos</label>
                                        <ValidationMessage For="@(() => modeloCreacion.Nombres)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputText id="txtApellidos" class="form-control" placeholder="Apellidos" @bind-Value="modeloCreacion.Apellidos" disabled="@procesandoModalCrear" />
                                        <label for="txtApellidos">Apellidos Completos</label>
                                        <ValidationMessage For="@(() => modeloCreacion.Apellidos)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputSelect id="ddlEstadoCivil" class="form-select" @bind-Value="modeloCreacion.EstadoCivil" disabled="@procesandoModalCrear">
                                            <option value="@EstadoCivil.Soltero">Soltero/a</option>
                                            <option value="@EstadoCivil.Casado">Casado/a</option>
                                            <option value="@EstadoCivil.Divorciado">Divorciado/a</option>
                                            <option value="@EstadoCivil.Viudo">Viudo/a</option>
                                            <option value="@EstadoCivil.UnionDeHecho">Unión de Hecho</option>
                                        </InputSelect>
                                        <label for="ddlEstadoCivil">Estado Civil</label>
                                        <ValidationMessage For="@(() => modeloCreacion.EstadoCivil)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-12">
                                    <div class="form-floating">
                                        <InputText id="txtRazonSocial" class="form-control" placeholder="Razón Social" @bind-Value="modeloCreacion.RazonSocial" disabled="@procesandoModalCrear" />
                                        <label for="txtRazonSocial">Razón Social o Denominación Legal</label>
                                        <ValidationMessage For="@(() => modeloCreacion.RazonSocial)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtEmail" class="form-control" placeholder="correo@ejemplo.com" @bind-Value="modeloCreacion.Email" disabled="@procesandoModalCrear" />
                                    <label for="txtEmail">Correo Electrónico</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Email)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtTelefono" class="form-control" placeholder="0987654321" @bind-Value="modeloCreacion.Telefono" disabled="@procesandoModalCrear" />
                                    <label for="txtTelefono">Teléfono / Celular</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Telefono)" class="text-danger small mt-1" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light fw-semibold text-muted px-4" @onclick="CerrarModalCrear" disabled="@procesandoModalCrear">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold shadow-sm px-4" disabled="@procesandoModalCrear">
                                @if (procesandoModalCrear)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar Propietario</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL EDICIÓN PROPIETARIO -->
@if (propietarioEditando != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Sujeto de Derecho</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEditar" disabled="@procesandoModalEditar"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalEditarErrorMensaje))
                    {
                        <div class="alert alert-danger border-0 shadow-sm small mb-3 rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @modalEditarErrorMensaje
                        </div>
                    }

                    <EditForm Model="@modeloEdicion" OnValidSubmit="GuardarEdicion">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input type="text" class="form-control bg-light font-monospace" value="@propietarioEditando.Identificacion" disabled />
                                    <label>Identificación (No modificable)</label>
                                </div>
                            </div>

                            @if (propietarioEditando.TipoPropietario == TipoPropietario.Natural)
                            {
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputText id="txtEditNombres" class="form-control" @bind-Value="modeloEdicion.Nombres" placeholder="Nombres" disabled="@procesandoModalEditar" />
                                        <label for="txtEditNombres">Nombres Completos</label>
                                        <ValidationMessage For="@(() => modeloEdicion.Nombres)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputText id="txtEditApellidos" class="form-control" @bind-Value="modeloEdicion.Apellidos" placeholder="Apellidos" disabled="@procesandoModalEditar" />
                                        <label for="txtEditApellidos">Apellidos Completos</label>
                                        <ValidationMessage For="@(() => modeloEdicion.Apellidos)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputSelect id="ddlEditEstadoCivil" class="form-select" @bind-Value="modeloEdicion.EstadoCivil" disabled="@procesandoModalEditar">
                                            <option value="@EstadoCivil.Soltero">Soltero/a</option>
                                            <option value="@EstadoCivil.Casado">Casado/a</option>
                                            <option value="@EstadoCivil.Divorciado">Divorciado/a</option>
                                            <option value="@EstadoCivil.Viudo">Viudo/a</option>
                                            <option value="@EstadoCivil.UnionDeHecho">Unión de Hecho</option>
                                        </InputSelect>
                                        <label for="ddlEditEstadoCivil">Estado Civil</label>
                                        <ValidationMessage For="@(() => modeloEdicion.EstadoCivil)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-12">
                                    <div class="form-floating">
                                        <InputText id="txtEditRazonSocial" class="form-control" @bind-Value="modeloEdicion.RazonSocial" placeholder="Razón Social" disabled="@procesandoModalEditar" />
                                        <label for="txtEditRazonSocial">Razón Social</label>
                                        <ValidationMessage For="@(() => modeloEdicion.RazonSocial)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtEditEmail" class="form-control" @bind-Value="modeloEdicion.Email" placeholder="Email" disabled="@procesandoModalEditar" />
                                    <label for="txtEditEmail">Correo Electrónico</label>
                                    <ValidationMessage For="@(() => modeloEdicion.Email)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtEditTelefono" class="form-control" @bind-Value="modeloEdicion.Telefono" placeholder="Teléfono" disabled="@procesandoModalEditar" />
                                    <label for="txtEditTelefono">Teléfono / Celular</label>
                                    <ValidationMessage For="@(() => modeloEdicion.Telefono)" class="text-danger small mt-1" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light fw-semibold text-muted px-4" @onclick="CerrarModalEditar" disabled="@procesandoModalEditar">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold shadow-sm px-4" disabled="@procesandoModalEditar">
                                @if (procesandoModalEditar)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar Cambios</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL CONFIRMACIÓN ACTIVAR / DESACTIVAR (IDÉNTICO A USUARIOS) -->
@if (propietarioAEstadoCambiar != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1080;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        @if (propietarioAEstadoCambiar.EstadoActivo)
                        {
                            <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-person-x-fill fs-2"></i>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-person-check-fill fs-2"></i>
                            </div>
                        }
                    </div>
                    <h5 class="fw-bold text-dark mb-1">¿Estás seguro?</h5>
                    <p class="text-muted small mb-0">
                        @(propietarioAEstadoCambiar.EstadoActivo
                            ? $"Vas a desactivar el registro del propietario {propietarioAEstadoCambiar.NombreCompleto}."
                            : $"Vas a restaurar el registro del propietario {propietarioAEstadoCambiar.NombreCompleto}.")
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-light fw-semibold text-muted px-4" @onclick="() => propietarioAEstadoCambiar = null">Cancelar</button>
                        <button class="btn @(propietarioAEstadoCambiar.EstadoActivo ? "btn-danger" : "btn-success") fw-semibold shadow-sm px-4" @onclick="ConfirmarCambioEstado">
                            Sí, @(propietarioAEstadoCambiar.EstadoActivo ? "Desactivar" : "Activar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

