    // --- SEGMENTOS DPA ---
    private void OnTipoPredioCambiado() => SincronizarClaveDesdeSegmentos();

    private void OnSegmentoInput(ChangeEventArgs e, int segmentoIndex)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var soloNumeros = new string(raw.Where(char.IsDigit).ToArray());

        switch (segmentoIndex)
        {
            case 1: ccProvincia = soloNumeros; break;
            case 2: ccCanton = soloNumeros; break;
            case 3: ccParroquia = soloNumeros; break;
            case 4: ccZona = soloNumeros; break;
            case 5: ccSector = soloNumeros; break;
            case 6: ccManzanaPoligono = soloNumeros; break;
            case 7: ccPredio = soloNumeros; break;
            case 8: ccBloque = soloNumeros; break;
            case 9: ccPiso = soloNumeros; break;
            case 10: ccUnidad = soloNumeros; break;
        }
        SincronizarClaveDesdeSegmentos();
    }

    private void SincronizarClaveDesdeSegmentos()
    {
        if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
            modeloCreacion.ClaveCatastral = $"{ccProvincia}{ccCanton}{ccParroquia}{ccZona}{ccSector}{ccManzanaPoligono}{ccPredio}{ccBloque}{ccPiso}{ccUnidad}".Trim();
        else
            modeloCreacion.ClaveCatastral = $"{ccProvincia}{ccCanton}{ccParroquia}{ccZona}{ccSector}{ccManzanaPoligono}{ccPredio}{ccUnidad}".Trim();
    }

    private void ResetearSegmentos()
    {
        ccProvincia = "10"; ccCanton = "02"; ccParroquia = "50"; ccZona = "01"; ccSector = "01";
        ccManzanaPoligono = "001"; ccPredio = "001"; ccBloque = "000"; ccPiso = "00"; ccUnidad = "000";
    }

    private void ParsearClaveASegmentos(string clave)
    {
        if (string.IsNullOrWhiteSpace(clave) || clave.Length < 19) { ResetearSegmentos(); return; }
        try
        {
            ccProvincia = clave.Length >= 2 ? clave.Substring(0, 2) : "10";
            ccCanton = clave.Length >= 4 ? clave.Substring(2, 2) : "02";
            ccParroquia = clave.Length >= 6 ? clave.Substring(4, 2) : "50";
            ccZona = clave.Length >= 8 ? clave.Substring(6, 2) : "01";
            ccSector = clave.Length >= 10 ? clave.Substring(8, 2) : "01";
            ccManzanaPoligono = clave.Length >= 13 ? clave.Substring(10, 3) : "001";
            ccPredio = clave.Length >= 16 ? clave.Substring(13, 3) : "001";

            if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
            {
                ccBloque = clave.Length >= 19 ? clave.Substring(16, 3) : "000";
                ccPiso = clave.Length >= 21 ? clave.Substring(19, 2) : "00";
                ccUnidad = clave.Length >= 24 ? clave.Substring(21, 3) : "000";
            }
            else { ccUnidad = clave.Length >= 19 ? clave.Substring(16, 3) : "000"; ccBloque = "000"; ccPiso = "00"; }
        }
        catch { }
    }

    // 🔥 GUARDADO INTELIGENTE (CREA O ACTUALIZA) 🔥
    private async Task GuardarFichaCatastral()
    {
        SincronizarClaveDesdeSegmentos();

        if (!FormularioEsValido)
        {
            modalFichaErrorMensaje = "Verifique que todos los datos del terreno estén completos y que los dominios sumen exactamente el 100.00%.";
            return;
        }

        procesandoModalFicha = true;
        modalFichaErrorMensaje = string.Empty;

        try
        {
            OperacionResultadoDto resultado;

            if (esModoEdicion && idPredioEnEdicion.HasValue)
            {
                // Mapeo hacia el DTO de Update (Deltas)
                var fichaActualizar = new UpdateFichaCatastralDto
                {
                    Id = idPredioEnEdicion.Value,
                    Predio = modeloCreacion,
                    Dominios = listaDominiosMemoria.Select(d => new UpdateDominioDto
                    {
                        Id = d.Id,
                        PropietarioId = d.PropietarioId,
                        TipoTenenciaId = d.TipoTenenciaId,
                        PorcentajePropiedad = d.PorcentajePropiedad,
                        Notaria = d.Notaria,
                        FechaInscripcion = DateTime.UtcNow
                    }).ToList(),
                    Bloques = listaBloquesMemoria.Select(b => new UpdateBloqueDto
                    {
                        Id = b.Id,
                        NumeroBloque = b.NumeroBloque,
                        TipoEstructuraId = b.TipoEstructuraId,
                        EstadoConservacionId = b.EstadoConservacionId,
                        NumeroPisos = b.NumeroPisos,
                        AreaConstruccion = b.AreaConstruccion,
                        AnioConstruccion = b.AnioConstruccion
                    }).ToList()
                };

                resultado = await PredioService.ActualizarFichaCompletaAsync(idPredioEnEdicion.Value, fichaActualizar);
            }
            else
            {
                // Mapeo hacia el DTO de Create
                var fichaNueva = new CreateFichaCatastralDto
                {
                    Predio = modeloCreacion,
                    Dominios = listaDominiosMemoria.Select(d => new AddDominioDto
                    {
                        PropietarioId = d.PropietarioId,
                        TipoTenenciaId = d.TipoTenenciaId,
                        PorcentajePropiedad = d.PorcentajePropiedad,
                        Notaria = d.Notaria,
                        FechaInscripcion = DateTime.UtcNow
                    }).ToList(),
                    Bloques = listaBloquesMemoria.Select(b => new AddBloqueDto
                    {
                        NumeroBloque = b.NumeroBloque,
                        TipoEstructuraId = b.TipoEstructuraId,
                        EstadoConservacionId = b.EstadoConservacionId,
                        NumeroPisos = b.NumeroPisos,
                        AreaConstruccion = b.AreaConstruccion,
                        AnioConstruccion = b.AnioConstruccion
                    }).ToList()
                };

                resultado = await PredioService.GuardarFichaCompletaAsync(fichaNueva);
            }

            if (resultado.Exitoso)
            {
                mostrarModalFicha = false;
                await CargarPrediosPaginados();
                await MostrarToast(resultado.Mensaje ?? "Operación completada exitosamente.", true);
            }
            else
            {
                modalFichaErrorMensaje = resultado.Mensaje ?? "Ocurrió un error al procesar la ficha.";
            }
        }
        catch (Exception ex)
        {
            modalFichaErrorMensaje = $"Error inesperado al comunicarse con el servidor: {ex.Message}";
        }
        finally
        {
            procesandoModalFicha = false;
        }
    }

    private void SolicitarCambioEstado(PredioDto predio) => predioAEstadoCambiar = predio;

    private async Task ConfirmarCambioEstado()
    {
        if (predioAEstadoCambiar == null) return;
        var p = predioAEstadoCambiar; predioAEstadoCambiar = null;

        var resultado = await PredioService.CambiarEstadoAsync(p.Id);
        if (resultado.Exitoso) { await CargarPrediosPaginados(); await MostrarToast(resultado.Mensaje ?? "Estado actualizado.", true); }
        else { await MostrarToast(resultado.Mensaje ?? "No se pudo cambiar el estado.", false); }
    }

    private async Task MostrarToast(string mensaje, bool esExito = true)
    {
        toastCts?.Cancel(); toastCts = new CancellationTokenSource();
        toastMensaje = mensaje; toastEsExito = esExito; StateHasChanged();
        try { await Task.Delay(4000, toastCts.Token); toastMensaje = string.Empty; StateHasChanged(); } catch { }
    }

    private void OcultarToast() => toastMensaje = string.Empty;
    private string ShortGuid(Guid id) => id.ToString().Length > 8 ? id.ToString().Substring(0, 8) + "..." : id.ToString();
}