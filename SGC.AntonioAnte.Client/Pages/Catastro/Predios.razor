@page "/catastro/predios"
@using SGC.AntonioAnte.Client.Services.Catastro.Contracts
@using SGC.AntonioAnte.Domain.Catastro.Enums
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Catalogos
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Predios
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Propietarios
@using SGC.AntonioAnte.Shared.DTOs.Common
@using System.Threading

@inject IPredioService PredioService
@inject IPropietarioService PropietarioService
@inject ICatalogoService CatalogoService

<div class="container-fluid py-4 animate-fade-in">
    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-geo-alt-fill me-2 text-primary"></i>Gestión de Predios y Ficha Catastral
            </h1>
            <p class="text-muted small mb-0">Inventario físico, legal y constructivo de los bienes inmuebles del cantón Antonio Ante.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm" @onclick="CargarPrediosPaginados">
                <i class="bi bi-arrow-clockwise"></i> Refrescar
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-hover py-2 fw-semibold" @onclick="AbrirModalCrearFicha">
                <i class="bi bi-plus-circle-fill"></i> Nueva Ficha Catastral
            </button>
        </div>
    </div>

    <!-- TOAST FLOTANTE CORPORATIVO -->
    @if (!string.IsNullOrEmpty(toastMensaje))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
            <div class="toast show shadow-lg border-0 bg-white" role="alert">
                <div class="toast-header @(toastEsExito ? "bg-success text-white" : "bg-danger text-white") border-0 py-2">
                    <i class="bi @(toastEsExito ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2 fs-6"></i>
                    <strong class="me-auto">@(toastEsExito ? "Éxito" : "Atención")</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="OcultarToast"></button>
                </div>
                <div class="toast-body fw-medium text-dark py-3">
                    @toastMensaje
                </div>
            </div>
        </div>
    }

    <!-- BARRA DE FILTROS -->
    <div class="card border-0 shadow-sm mb-4 bg-white rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-bold mb-1">Búsqueda General</label>
                    <div class="position-relative">
                        <input type="text" class="form-control ps-5 py-2" placeholder="Buscar por clave catastral, clave anterior o dirección..." @bind="busquedaFiltro" @bind:event="oninput" @onkeyup="OnBusquedaKeyUp" />
                        <i class="bi bi-search position-absolute start-0 top-50 translate-middle-y ms-3 text-muted"></i>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Clasificación</label>
                    <select class="form-select py-2" @bind="filtroTipoPredioTexto" @bind:after="OnFiltrosCambiados">
                        <option value="TODOS">-- Todos los Tipos --</option>
                        <option value="URBANO">Urbano</option>
                        <option value="RURAL">Rural</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Estado</label>
                    <select class="form-select py-2" @bind="filtroEstadoTexto" @bind:after="OnFiltrosCambiados">
                        <option value="TODOS">-- Todos los Estados --</option>
                        <option value="ACTIVO">Activos</option>
                        <option value="INACTIVO">Inactivos</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end mt-auto pt-2 pt-md-0">
                    <button class="btn btn-light text-danger border w-100 py-2 fw-semibold" @onclick="LimpiarFiltros" title="Limpiar Filtros">
                        <i class="bi bi-eraser-fill me-1"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE PREDIOS -->
    <div class="card border-0 shadow-lg bg-white overflow-hidden rounded-4">
        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-4 py-3">Clave Catastral (DPA)</th>
                        <th class="py-3">Clave Anterior</th>
                        <th class="py-3">Tipo Predio</th>
                        <th class="py-3">Ubicación / Dirección</th>
                        <th class="py-3 text-end">Área Terreno</th>
                        <th class="py-3 text-center">Estado</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted fw-medium">Consultando inventario predial en el servidor...</span>
                            </td>
                        </tr>
                    }
                    else if (resultadoPaginado == null || !resultadoPaginado.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-map display-6 d-block mb-2 opacity-50"></i>
                                <span class="small fw-semibold">No se encontraron predios que coincidan con los criterios de búsqueda.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in resultadoPaginado.Items)
                        {
                            <tr class="funcionario-row @(p.EstadoActivo ? "" : "table-light opacity-75")">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-table @(p.TipoPredio == TipoPredio.Urbano ? "avatar-urbano" : "avatar-rural")">
                                            <i class="bi @(p.TipoPredio == TipoPredio.Urbano ? "bi-buildings-fill" : "bi-tree-fill")"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark font-monospace lh-1 mb-1">@p.ClaveCatastral</div>
                                            <span class="text-muted font-monospace" style="font-size: 0.7rem;">ID: @ShortGuid(p.Id)</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 font-monospace text-secondary">
                                    @(string.IsNullOrWhiteSpace(p.ClaveAnterior) ? "N/A" : p.ClaveAnterior)
                                </td>
                                <td class="py-3">
                                    @if (p.TipoPredio == TipoPredio.Urbano)
                                    {
                                        <span class="badge-custom badge-urbano">
                                            <i class="bi bi-buildings me-1"></i> Urbano
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-custom badge-rural">
                                            <i class="bi bi-tree me-1"></i> Rural
                                        </span>
                                    }
                                </td>
                                <td class="py-3 small text-dark" style="max-width: 250px;">
                                    <div class="text-truncate" title="@p.Direccion">@p.Direccion</div>
                                </td>
                                <td class="py-3 text-end font-monospace">
                                    <div class="fw-bold">@p.AreaTerrenoEscritura.ToString("N2") m²</div>
                                    @if (p.AreaTerrenoGrafica > 0)
                                    {
                                        <div class="text-muted small" style="font-size: 0.7rem;">Gráf: @p.AreaTerrenoGrafica.ToString("N2") m²</div>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    @if (p.EstadoActivo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary rounded-2 btn-action" title="Ver Ficha Catastral" @onclick="() => VerDetallePredio(p)">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        @if (p.EstadoActivo)
                                        {
                                            <button class="btn btn-sm btn-outline-warning rounded-2 btn-action" title="Editar Ficha Catastral" @onclick="() => EditarPredio(p)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }

                                        @if (p.EstadoActivo)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar Predio" @onclick="() => SolicitarCambioEstado(p)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Activar Predio" @onclick="() => SolicitarCambioEstado(p)">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (resultadoPaginado != null && resultadoPaginado.TotalRegistros > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Mostrando <strong>@(((paginaActual - 1) * registrosPorPagina) + 1)</strong> a
                    <strong>@(Math.Min(paginaActual * registrosPorPagina, resultadoPaginado.TotalRegistros))</strong> de
                    <strong>@resultadoPaginado.TotalRegistros</strong> predios
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Filas:</span>
                        <select class="form-select form-select-sm" style="width: 70px;" value="@registrosPorPagina" @onchange="OnCambiarRegistrosPorPagina">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                        </select>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(resultadoPaginado.TienePaginaAnterior ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(1)" title="Primera página"><i class="bi bi-chevron-double-left"></i></button>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaAnterior ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual - 1)" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-item-text">Página @paginaActual de @resultadoPaginado.TotalPaginas</span>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaSiguiente ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual + 1)" title="Siguiente"><i class="bi bi-chevron-right"></i></button>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaSiguiente ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(resultadoPaginado.TotalPaginas)" title="Última página"><i class="bi bi-chevron-double-right"></i></button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<!-- SUPER-MODAL: FICHA CATASTRAL -->
@if (mostrarModalFicha)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark">
                            <i class="bi bi-journal-text me-2 text-primary"></i>
                            @(esModoVisualizacion ? "Ficha Catastral Multifinalitaria" : (esModoEdicion ? "Edición de Ficha Catastral" : "Registro de Nueva Ficha Catastral"))
                        </h5>
                        <p class="text-muted small mb-0">
                            @(esModoEdicion ? "Actualización de información del inventario predial." : "Estructura según la Norma Técnica Nacional de Catastros (MIDUVI).")
                        </p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CerrarModalFicha" disabled="@procesandoModalFicha"></button>
                </div>

                <!-- TABS DE NAVEGACIÓN -->
                <div class="px-4 pt-3">
                    <ul class="nav nav-pills nav-fill gap-2 p-1 bg-light rounded-3 border" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(tabActivo == 1 ? "active fw-bold shadow-sm" : "text-secondary")" @onclick="() => tabActivo = 1" type="button">
                                <i class="bi @(EsTerrenoValido ? "bi-check-circle-fill text-success" : "bi-geo-alt") me-1"></i> 1. Datos del Terreno
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(tabActivo == 2 ? "active fw-bold shadow-sm" : "text-secondary")" @onclick="() => tabActivo = 2" type="button">
                                <i class="bi @(EsDominioValido ? "bi-check-circle-fill text-success" : "bi-people") me-1"></i> 2. Dominios y Propietarios
                                <span class="badge @(TotalPorcentajeDominios == 100.00m ? "bg-success" : (TotalPorcentajeDominios > 100.00m ? "bg-danger" : "bg-warning text-dark")) ms-1 font-monospace">
                                    @TotalPorcentajeDominios.ToString("0.##")%
                                </span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(tabActivo == 3 ? "active fw-bold shadow-sm" : "text-secondary")" @onclick="() => tabActivo = 3" type="button">
                                <i class="bi bi-houses me-1"></i> 3. Edificaciones (Bloques)
                                @if (listaBloquesMemoria.Any())
                                {
                                    <span class="badge bg-primary ms-1 font-monospace">@listaBloquesMemoria.Count</span>
                                }
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalFichaErrorMensaje))
                    {
                        <div class="alert alert-danger border-0 shadow-sm small mb-3 rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @modalFichaErrorMensaje
                        </div>
                    }

                    <EditForm Model="@modeloCreacion" OnValidSubmit="GuardarFichaCatastral">
                        <DataAnnotationsValidator />

                        <!-- TAB 1: DATOS DEL TERRENO -->
                        <div class="@(tabActivo == 1 ? "" : "d-none")">
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <div class="form-floating">
                                        <!-- SE BLOQUEA EN MODO EDICIÓN -->
                                        <InputSelect id="ddlTipoPredioCrear" class="form-select" @bind-Value="modeloCreacion.TipoPredio" @bind-Value:after="OnTipoPredioCambiado" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)">
                                            <option value="@TipoPredio.Urbano">Urbano</option>
                                            <option value="@TipoPredio.Rural">Rural</option>
                                        </InputSelect>
                                        <label for="ddlTipoPredioCrear">Clasificación de Suelo <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-floating">
                                        <InputText id="txtClaveAnterior" class="form-control font-monospace" placeholder="Código anterior" @bind-Value="modeloCreacion.ClaveAnterior" maxlength="50" disabled="@(procesandoModalFicha || esModoVisualizacion)" />
                                        <label for="txtClaveAnterior">Clave Catastral Anterior / Referencial</label>
                                        <ValidationMessage For="@(() => modeloCreacion.ClaveAnterior)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                            </div>

                            <div class="card border border-primary-subtle bg-light-subtle rounded-4 p-3 mb-3 shadow-sm">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-2 gap-2">
                                    <div class="fw-bold text-dark small">
                                        <i class="bi bi-upc-scan me-1 text-primary"></i>
                                        @(modeloCreacion.TipoPredio == TipoPredio.Urbano ? "Estructura Clave Urbana DPA (24 Dígitos)" : "Estructura Clave Rural DPA (19 Dígitos)")
                                        @if (esModoEdicion)
                                        {
                                            <span class="text-danger ms-2" style="font-size:0.65rem;">(Bloqueado por Seguridad Catastral)</span>
                                        }
                                    </div>
                                    <span class="badge @(modeloCreacion.ClaveCatastral.Length == TotalDigitosEsperados ? "bg-primary" : "bg-warning text-dark") font-monospace">
                                        Clave: @(string.IsNullOrWhiteSpace(modeloCreacion.ClaveCatastral) ? "Sin definir" : modeloCreacion.ClaveCatastral) (@modeloCreacion.ClaveCatastral.Length/@TotalDigitosEsperados)
                                    </span>
                                </div>

                                <!-- TODOS LOS INPUTS DPA SE BLOQUEAN EN MODO EDICIÓN -->
                                <div class="row g-2">
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Provincia (2)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="2"
                                               value="@ccProvincia" @oninput="(e) => OnSegmentoInput(e, 1)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Cantón (2)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="2"
                                               value="@ccCanton" @oninput="(e) => OnSegmentoInput(e, 2)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Parroquia (2)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="2"
                                               value="@ccParroquia" @oninput="(e) => OnSegmentoInput(e, 3)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Zona (2)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="2"
                                               value="@ccZona" @oninput="(e) => OnSegmentoInput(e, 4)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Sector (2)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="2"
                                               value="@ccSector" @oninput="(e) => OnSegmentoInput(e, 5)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">
                                            @(modeloCreacion.TipoPredio == TipoPredio.Urbano ? "Manzana (3)" : "Polígono (3)")
                                        </label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="3"
                                               value="@ccManzanaPoligono" @oninput="(e) => OnSegmentoInput(e, 6)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Predio (3)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="3"
                                               value="@ccPredio" @oninput="(e) => OnSegmentoInput(e, 7)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>

                                    @if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
                                    {
                                        <div class="col-6 col-sm-4 col-md-3 col-lg">
                                            <label class="form-label text-muted dpa-label mb-1">Bloque (3)</label>
                                            <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="3"
                                                   value="@ccBloque" @oninput="(e) => OnSegmentoInput(e, 8)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                        </div>
                                        <div class="col-6 col-sm-4 col-md-3 col-lg">
                                            <label class="form-label text-muted dpa-label mb-1">Piso (2)</label>
                                            <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="2"
                                                   value="@ccPiso" @oninput="(e) => OnSegmentoInput(e, 9)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                        </div>
                                    }

                                    <div class="col-6 col-sm-4 col-md-3 col-lg">
                                        <label class="form-label text-muted dpa-label mb-1">Unidad (3)</label>
                                        <input type="text" class="form-control form-control-sm text-center font-monospace fw-bold" maxlength="3"
                                               value="@ccUnidad" @oninput="(e) => OnSegmentoInput(e, 10)" disabled="@(procesandoModalFicha || esModoVisualizacion || esModoEdicion)" />
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => modeloCreacion.ClaveCatastral)" class="text-danger small mt-2" />
                            </div>

                            <!-- ÁREAS Y UBICACIÓN SI SE PUEDEN EDITAR -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputNumber id="numAreaEscritura" class="form-control" placeholder="0.00" @bind-Value="modeloCreacion.AreaTerrenoEscritura" disabled="@(procesandoModalFicha || esModoVisualizacion)" />
                                        <label for="numAreaEscritura">Área Terreno Escritura (m²) <span class="text-danger">*</span></label>
                                        <ValidationMessage For="@(() => modeloCreacion.AreaTerrenoEscritura)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <InputNumber id="numAreaGrafica" class="form-control" placeholder="0.00" @bind-Value="modeloCreacion.AreaTerrenoGrafica" disabled="@(procesandoModalFicha || esModoVisualizacion)" />
                                        <label for="numAreaGrafica">Área Terreno Gráfica / GIS (m²)</label>
                                        <ValidationMessage For="@(() => modeloCreacion.AreaTerrenoGrafica)" class="text-danger small mt-1" />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <InputText id="txtDireccion" class="form-control" placeholder="Dirección" @bind-Value="modeloCreacion.Direccion" disabled="@(procesandoModalFicha || esModoVisualizacion)" />
                                        <label for="txtDireccion">Ubicación / Dirección / Referencia Física <span class="text-danger">*</span></label>
                                        <ValidationMessage For="@(() => modeloCreacion.Direccion)" class="text-danger small mt-1" />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <InputTextArea id="txtPoligonoWkt" class="form-control font-monospace" style="height: 90px;" placeholder="POLYGON((...))" @bind-Value="modeloCreacion.PoligonoWkt" disabled="@(procesandoModalFicha || esModoVisualizacion)" />
                                        <label for="txtPoligonoWkt">Polígono Espacial (Formato WKT OGC)</label>
                                        <ValidationMessage For="@(() => modeloCreacion.PoligonoWkt)" class="text-danger small mt-1" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: DOMINIOS Y PROPIETARIOS -->
                        <div class="@(tabActivo == 2 ? "" : "d-none")">
                            @if (!esModoVisualizacion)
                            {
                                <div class="card border @(dominioEnEdicion != null ? "border-warning bg-warning-subtle" : "bg-light-subtle") rounded-4 p-3 mb-4 shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="fw-bold text-dark small">
                                            <i class="bi @(dominioEnEdicion != null ? "bi-pencil-square text-warning" : "bi-person-plus-fill text-primary") me-1"></i>
                                            @(dominioEnEdicion != null ? "Editando Sujeto de Derecho" : "Vincular Sujeto de Derecho al Predio")
                                        </div>
                                        @if (dominioEnEdicion != null)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="CancelarEdicionDominio">Cancelar Edición</button>
                                        }
                                    </div>

                                    <div class="row g-2 align-items-center mb-3">
                                        <div class="col-md-5">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                                <input type="text" class="form-control font-monospace" placeholder="Cédula / RUC del propietario..."
                                                       @bind="cedulaBusquedaDominio" @onkeyup="OnCedulaBusquedaKeyUp" disabled="@(dominioEnEdicion != null)" />
                                                <button class="btn btn-outline-primary" type="button" @onclick="BuscarPropietarioPorCedula" disabled="@(buscandoPropietario || dominioEnEdicion != null)">
                                                    @if (buscandoPropietario)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                    }
                                                    else
                                                    {

                                                        <span>Buscar</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>

                                        <div class="col-md-7">
                                            @if (propietarioEncontrado != null)
                                            {
                                                <div class="p-2 bg-white rounded border d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <span class="badge bg-primary-subtle text-primary border me-2 font-monospace">@propietarioEncontrado.Identificacion</span>
                                                        <strong class="text-dark small">@propietarioEncontrado.NombreCompleto</strong>
                                                    </div>
                                                    @if (dominioEnEdicion == null)
                                                    {
                                                        <button type="button" class="btn-close btn-sm" @onclick="() => propietarioEncontrado = null"></button>
                                                    }
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(mensajeBusquedaPropietario))
                                            {
                                                <span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>@mensajeBusquedaPropietario</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Ingrese la cédula o RUC para localizar al ciudadano.</span>
                                            }
                                        </div>
                                    </div>

                                    @if (propietarioEncontrado != null)
                                    {
                                        <div class="row g-2 align-items-end pt-2 border-top">
                                            <div class="col-md-4">
                                                <label class="form-label text-muted dpa-label mb-1">Tipo de Tenencia <span class="text-danger">*</span></label>
                                                <select class="form-select form-select-sm" @bind="nuevoDominioTipoTenenciaId">
                                                    <option value="">-- Seleccionar --</option>
                                                    @foreach (var tenencia in tiposTenencia)
                                                    {
                                                        <option value="@tenencia.Id">@tenencia.Nombre</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label text-muted dpa-label mb-1">% Propiedad <span class="text-danger">*</span></label>
                                                <input type="number" step="0.01" class="form-control form-control-sm text-end font-monospace" placeholder="100.00"
                                                       @bind="nuevoDominioPorcentaje" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted dpa-label mb-1">Notaría / Título</label>
                                                <input type="text" class="form-control form-control-sm" placeholder="Ej: Notaría Primera"
                                                       @bind="nuevoDominioNotaria" />
                                            </div>
                                            <div class="col-md-3 d-flex justify-content-end">
                                                <button type="button" class="btn btn-sm @(dominioEnEdicion != null ? "btn-warning text-dark" : "btn-primary") w-100 fw-semibold" @onclick="GuardarDominioEnLista">
                                                    <i class="bi @(dominioEnEdicion != null ? "bi-check2-circle" : "bi-plus-lg") me-1"></i>
                                                    @(dominioEnEdicion != null ? "Actualizar Dominio" : "Asignar Dominio")
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-shield-check text-primary me-2"></i>Propietarios y Derechos Registrados
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="small text-muted fw-semibold">Alícuota Total Asignada:</span>
                                    @if (TotalPorcentajeDominios == 100.00m)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 font-monospace fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i> 100.00% (Completo)
                                        </span>
                                    }
                                    else if (TotalPorcentajeDominios > 100.00m)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-1.5 font-monospace fw-bold shadow-sm">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TotalPorcentajeDominios.ToString("0.00")% (Excede el 100%)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-3 py-1.5 font-monospace fw-bold">
                                            <i class="bi bi-pie-chart-fill me-1"></i> @TotalPorcentajeDominios.ToString("0.00")% (Faltan @((100.00m - TotalPorcentajeDominios).ToString("0.00"))%)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="table-responsive rounded-3 border">
                                <table class="table table-hover align-middle mb-0 custom-table">
                                    <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                                        <tr>
                                            <th class="ps-3 py-2">Identificación</th>
                                            <th class="py-2">Propietario / Razón Social</th>
                                            <th class="py-2">Tipo Tenencia</th>
                                            <th class="py-2 text-end">% Propiedad</th>
                                            <th class="py-2">Notaría</th>
                                            @if (!esModoVisualizacion)
                                            {
                                                <th class="text-end pe-3 py-2">Acciones</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!listaDominiosMemoria.Any())
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted small">
                                                    <i class="bi bi-people display-6 d-block mb-1 opacity-50"></i>
                                                    No se han asignado propietarios a esta ficha predial.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var d in listaDominiosMemoria)
                                            {
                                                <!-- Resalta la fila si está en edición -->
                                                <tr class="@(dominioEnEdicion == d ? "table-warning" : "")">
                                                    <td class="ps-3 font-monospace fw-bold text-secondary">
                                                        @d.Identificacion
                                                        @if (esModoEdicion && d.Id == null)
                                                        {
                                                            <span class="badge bg-success ms-1" style="font-size: 0.6rem;">NUEVO</span>
                                                        }
                                                    </td>
                                                    <td class="fw-semibold text-dark">@d.NombrePropietario</td>
                                                    <td><span class="badge badge-dep text-dark">@d.NombreTipoTenencia</span></td>
                                                    <td class="text-end font-monospace fw-bold text-primary">@d.PorcentajePropiedad.ToString("0.00")%</td>
                                                    <td class="small text-muted">@(string.IsNullOrWhiteSpace(d.Notaria) ? "N/A" : d.Notaria)</td>
                                                    @if (!esModoVisualizacion)
                                                    {
                                                        <td class="text-end pe-3">
                                                            <div class="d-inline-flex gap-1">
                                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-2 py-0 px-2" title="Editar Dominio" @onclick="() => CargarDominioParaEdicion(d)">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-2 py-0 px-2" title="Quitar Dominio" @onclick="() => EliminarDominioDeLista(d)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- TAB 3: EDIFICACIONES Y BLOQUES CONSTRUCTIVOS -->
                        <div class="@(tabActivo == 3 ? "" : "d-none")">
                            @if (!esModoVisualizacion)
                            {
                                <div class="card border @(bloqueEnEdicion != null ? "border-warning bg-warning-subtle" : "bg-light-subtle") rounded-4 p-3 mb-4 shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="fw-bold text-dark small">
                                            <i class="bi @(bloqueEnEdicion != null ? "bi-pencil-square text-warning" : "bi-plus-square-fill text-primary") me-1"></i>
                                            @(bloqueEnEdicion != null ? $"Editando Bloque Constructivo Nro. {bloqueEnEdicion.NumeroBloque}" : "Caracterización de Bloque Constructivo")
                                        </div>
                                        @if (bloqueEnEdicion != null)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="CancelarEdicionBloque">Cancelar Edición</button>
                                        }
                                    </div>

                                    <div class="row g-2 align-items-end">
                                        <div class="col-6 col-md-2">
                                            <label class="form-label text-muted dpa-label mb-1">Nro. Bloque <span class="text-danger">*</span></label>
                                            <input type="number" class="form-control form-control-sm text-center font-monospace fw-bold"
                                                   @bind="nuevoBloqueNumero" min="1" max="99" disabled="@(bloqueEnEdicion != null)" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label text-muted dpa-label mb-1">Tipo Estructura <span class="text-danger">*</span></label>
                                            <select class="form-select form-select-sm" @bind="nuevoBloqueTipoEstructuraId">
                                                <option value="">-- Seleccionar --</option>
                                                @foreach (var est in tiposEstructura)
                                                {
                                                    <option value="@est.Id">@est.Nombre</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label text-muted dpa-label mb-1">Estado Conservación <span class="text-danger">*</span></label>
                                            <select class="form-select form-select-sm" @bind="nuevoBloqueEstadoConservacionId">
                                                <option value="">-- Seleccionar --</option>
                                                @foreach (var cons in estadosConservacion)
                                                {
                                                    <option value="@cons.Id">@cons.Nombre</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label text-muted dpa-label mb-1">Nro. Pisos <span class="text-danger">*</span></label>
                                            <input type="number" class="form-control form-control-sm text-center font-monospace"
                                                   @bind="nuevoBloqueNumeroPisos" min="1" max="50" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label text-muted dpa-label mb-1">Año Const. <span class="text-danger">*</span></label>
                                            <input type="number" class="form-control form-control-sm text-center font-monospace"
                                                   @bind="nuevoBloqueAnioConstruccion" min="1900" max="2100" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label text-muted dpa-label mb-1">Área Construcción (m²) <span class="text-danger">*</span></label>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-end font-monospace" placeholder="0.00"
                                                   @bind="nuevoBloqueAreaConstruccion" />
                                        </div>
                                        <div class="col-md-9 d-flex justify-content-end">
                                            <button type="button" class="btn btn-sm @(bloqueEnEdicion != null ? "btn-warning text-dark" : "btn-primary") px-4 fw-semibold" @onclick="GuardarBloqueEnLista">
                                                <i class="bi @(bloqueEnEdicion != null ? "bi-check2-circle" : "bi-building-add") me-1"></i>
                                                @(bloqueEnEdicion != null ? "Actualizar Bloque" : "Agregar Bloque a la Ficha")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-buildings text-primary me-2"></i>Bloques Constructivos Inventariados
                                </h6>
                                <div class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1.5 font-monospace fw-bold">
                                    Área Total Cubierta: @TotalAreaConstruccion.ToString("N2") m²
                                </div>
                            </div>

                            <div class="table-responsive rounded-3 border">
                                <table class="table table-hover align-middle mb-0 custom-table">
                                    <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                                        <tr>
                                            <th class="ps-3 py-2 text-center">Bloque N°</th>
                                            <th class="py-2">Estructura</th>
                                            <th class="py-2">Estado Conservación</th>
                                            <th class="py-2 text-center">Pisos</th>
                                            <th class="py-2 text-center">Año</th>
                                            <th class="py-2 text-end">Área (m²)</th>
                                            @if (!esModoVisualizacion)
                                            {
                                                <th class="text-end pe-3 py-2">Acciones</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!listaBloquesMemoria.Any())
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted small">
                                                    <i class="bi bi-houses display-6 d-block mb-1 opacity-50"></i>
                                                    No se han registrado edificaciones para este predio (Lote sin construcción).
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var b in listaBloquesMemoria)
                                            {
                                                <tr class="@(bloqueEnEdicion == b ? "table-warning" : "")">
                                                    <td class="ps-3 text-center font-monospace fw-bold text-primary">
                                                        #@b.NumeroBloque
                                                        @if (esModoEdicion && b.Id == null)
                                                        {
                                                            <span class="badge bg-success ms-1" style="font-size: 0.6rem;">NUEVO</span>
                                                        }
                                                    </td>
                                                    <td class="fw-semibold text-dark">@b.NombreTipoEstructura</td>
                                                    <td><span class="badge badge-dep text-dark">@b.NombreEstadoConservacion</span></td>
                                                    <td class="text-center font-monospace">@b.NumeroPisos</td>
                                                    <td class="text-center font-monospace text-secondary">@b.AnioConstruccion</td>
                                                    <td class="text-end font-monospace fw-bold">@b.AreaConstruccion.ToString("N2") m²</td>
                                                    @if (!esModoVisualizacion)
                                                    {
                                                        <td class="text-end pe-3">
                                                            <div class="d-inline-flex gap-1">
                                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-2 py-0 px-2" title="Editar Bloque" @onclick="() => CargarBloqueParaEdicion(b)">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-2 py-0 px-2" title="Quitar Bloque" @onclick="() => EliminarBloqueDeLista(b)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- PIE DEL MODAL -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mt-4 pt-3 border-top gap-2">
                            <div class="small">
                                @if (!esModoVisualizacion)
                                {
                                    @if (!EsTerrenoValido)
                                    {
                                        <span class="text-danger fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>Complete los datos requeridos del terreno (Tab 1).</span>
                                    }
                                    else if (!EsDominioValido)
                                    {
                                        <span class="text-warning text-dark fw-semibold"><i class="bi bi-pie-chart-fill me-1"></i>Debe vincular al menos un propietario y sumar exactamente el 100.00% (Tab 2).</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Ficha validada y lista para ser guardada.</span>
                                    }
                                }
                            </div>
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-light fw-semibold text-muted px-4" @onclick="CerrarModalFicha" disabled="@procesandoModalFicha">
                                    @(esModoVisualizacion ? "Cerrar" : "Cancelar")
                                </button>
                                @if (!esModoVisualizacion)
                                {
                                    <button type="submit" class="btn btn-primary fw-semibold shadow-sm px-4" disabled="@(!FormularioEsValido || procesandoModalFicha || dominioEnEdicion != null || bloqueEnEdicion != null)">
                                        @if (procesandoModalFicha)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-save me-1"></i> <span>@(esModoEdicion ? "Actualizar Ficha" : "Guardar Ficha")</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL CONFIRMACIÓN ACTIVAR / DESACTIVAR PREDIO -->
@if (predioAEstadoCambiar != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1080;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        @if (predioAEstadoCambiar.EstadoActivo)
                        {
                            <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-trash-fill fs-2"></i>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-check-circle-fill fs-2"></i>
                            </div>
                        }
                    </div>
                    <h5 class="fw-bold text-dark mb-1">¿Estás seguro?</h5>
                    <p class="text-muted small mb-0">
                        @(predioAEstadoCambiar.EstadoActivo
                            ? $"Vas a desactivar el predio con clave catastral {predioAEstadoCambiar.ClaveCatastral}."
                            : $"Vas a restaurar el predio con clave catastral {predioAEstadoCambiar.ClaveCatastral}.")
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-light fw-semibold text-muted px-4" @onclick="() => predioAEstadoCambiar = null">Cancelar</button>
                        <button class="btn @(predioAEstadoCambiar.EstadoActivo ? "btn-danger" : "btn-success") fw-semibold shadow-sm px-4" @onclick="ConfirmarCambioEstado">
                            Sí, @(predioAEstadoCambiar.EstadoActivo ? "Desactivar" : "Activar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .backdrop-blur {
        background-color: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
    }

    .custom-table tbody tr {
        transition: background-color 0.15s ease;
    }

        .custom-table tbody tr:hover {
            background-color: #f8fafc;
        }

    .avatar-table {
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .avatar-urbano {
        background-color: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .avatar-rural {
        background-color: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .badge-custom {
        display: inline-flex;
        align-items: center;
