@code {
    private ResultadoPaginadoDto<PredioDto>? resultadoPaginado = null;
    private bool cargando = true;

    // Filtros
    private string busquedaFiltro = string.Empty;
    private string filtroEstadoTexto = "TODOS";
    private string filtroTipoPredioTexto = "TODOS";
    private int paginaActual = 1;
    private int registrosPorPagina = 10;
    private Timer? _debounceTimer;

    // Toast Corporativo
    private string toastMensaje = string.Empty;
    private bool toastEsExito = true;
    private CancellationTokenSource? toastCts;

    // Super-Modal Ficha
    private bool mostrarModalFicha = false;
    private bool procesandoModalFicha = false;
    private bool esModoVisualizacion = false;
    private int tabActivo = 1;
    private string modalFichaErrorMensaje = string.Empty;
    private CreatePredioDto modeloCreacion = new();

    // Segmentos DPA para Clave Catastral Visual
    private string ccProvincia = "10";
    private string ccCanton = "02";
    private string ccParroquia = "50";
    private string ccZona = "01";
    private string ccSector = "01";
    private string ccManzanaPoligono = "001";
    private string ccPredio = "001";
    private string ccBloque = "000";
    private string ccPiso = "00";
    private string ccUnidad = "000";

    private int TotalDigitosEsperados => modeloCreacion.TipoPredio == TipoPredio.Urbano ? 24 : 19;

    // Catálogos cargados en segundo plano
    private List<CatalogoDto> tiposTenencia = new();
    private List<CatalogoDto> tiposEstructura = new();
    private List<CatalogoDto> estadosConservacion = new();

    private PredioDto? predioAEstadoCambiar = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarPrediosPaginados();
        _ = CargarCatalogosEnParalelo();
    }

    private async Task CargarCatalogosEnParalelo()
    {
        try
        {
            var taskTenencia = CatalogoService.ObtenerTiposTenenciaAsync();
            var taskEstructura = CatalogoService.ObtenerTiposEstructuraAsync();
            var taskConservacion = CatalogoService.ObtenerEstadosConservacionAsync();

            await Task.WhenAll(taskTenencia, taskEstructura, taskConservacion);

            tiposTenencia = await taskTenencia;
            tiposEstructura = await taskEstructura;
            estadosConservacion = await taskConservacion;
        }
        catch
        {
            // Silencioso en background
        }
    }

    private async Task CargarPrediosPaginados()
    {
        cargando = true;
        bool? estadoActivo = filtroEstadoTexto switch
        {
            "ACTIVO" => true,
            "INACTIVO" => false,
            _ => null
        };

        TipoPredio? tipoP = filtroTipoPredioTexto switch
        {
            "URBANO" => TipoPredio.Urbano,
            "RURAL" => TipoPredio.Rural,
            _ => null
        };

        resultadoPaginado = await PredioService.ObtenerPaginadoAsync(
            busquedaFiltro,
            estadoActivo,
            tipoP,
            paginaActual,
            registrosPorPagina);

        cargando = false;
    }

    private void OnBusquedaKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                paginaActual = 1;
                await CargarPrediosPaginados();
                StateHasChanged();
            });
        }, null, 350, Timeout.Infinite);
    }

    private async Task OnFiltrosCambiados()
    {
        paginaActual = 1;
        await CargarPrediosPaginados();
    }

    private async Task LimpiarFiltros()
    {
        busquedaFiltro = string.Empty;
        filtroEstadoTexto = "TODOS";
        filtroTipoPredioTexto = "TODOS";
        paginaActual = 1;
        await CargarPrediosPaginados();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || (resultadoPaginado != null && nuevaPagina > resultadoPaginado.TotalPaginas)) return;
        paginaActual = nuevaPagina;
        await CargarPrediosPaginados();
    }

    private async Task OnCambiarRegistrosPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoTam))
        {
            registrosPorPagina = nuevoTam;
            paginaActual = 1;
            await CargarPrediosPaginados();
        }
    }

    private void AbrirModalCrearFicha()
    {
        modeloCreacion = new CreatePredioDto
        {
            TipoPredio = TipoPredio.Urbano
        };

        ResetearSegmentos();
        SincronizarClaveDesdeSegmentos();

        modalFichaErrorMensaje = string.Empty;
        esModoVisualizacion = false;
        tabActivo = 1;
        mostrarModalFicha = true;
    }

    private void VerDetallePredio(PredioDto predio)
    {
        modeloCreacion = new CreatePredioDto
        {
            ClaveCatastral = predio.ClaveCatastral,
            ClaveAnterior = predio.ClaveAnterior,
            TipoPredio = predio.TipoPredio,
            AreaTerrenoEscritura = predio.AreaTerrenoEscritura,
            AreaTerrenoGrafica = predio.AreaTerrenoGrafica,
            Direccion = predio.Direccion,
            PoligonoWkt = predio.PoligonoWkt
        };

        ParsearClaveASegmentos(predio.ClaveCatastral);

        modalFichaErrorMensaje = string.Empty;
        esModoVisualizacion = true;
        tabActivo = 1;
        mostrarModalFicha = true;
    }

    private void CerrarModalFicha() => mostrarModalFicha = false;

    // --- LÓGICA DE CONTROL SEGMENTADO DE CLAVE DPA ---
    private void OnTipoPredioCambiado()
    {
        SincronizarClaveDesdeSegmentos();
    }

    private void OnSegmentoInput(ChangeEventArgs e, int segmentoIndex)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        var soloNumeros = new string(raw.Where(char.IsDigit).ToArray());

        switch (segmentoIndex)
        {
            case 1: ccProvincia = soloNumeros; break;
            case 2: ccCanton = soloNumeros; break;
            case 3: ccParroquia = soloNumeros; break;
            case 4: ccZona = soloNumeros; break;
            case 5: ccSector = soloNumeros; break;
            case 6: ccManzanaPoligono = soloNumeros; break;
            case 7: ccPredio = soloNumeros; break;
            case 8: ccBloque = soloNumeros; break;
            case 9: ccPiso = soloNumeros; break;
            case 10: ccUnidad = soloNumeros; break;
        }

        SincronizarClaveDesdeSegmentos();
    }

    private void SincronizarClaveDesdeSegmentos()
    {
        if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
        {
            modeloCreacion.ClaveCatastral = $"{ccProvincia}{ccCanton}{ccParroquia}{ccZona}{ccSector}{ccManzanaPoligono}{ccPredio}{ccBloque}{ccPiso}{ccUnidad}".Trim();
        }
        else
        {
            modeloCreacion.ClaveCatastral = $"{ccProvincia}{ccCanton}{ccParroquia}{ccZona}{ccSector}{ccManzanaPoligono}{ccPredio}{ccUnidad}".Trim();
        }
    }

    private void ResetearSegmentos()
    {
        ccProvincia = "10";
        ccCanton = "02";
        ccParroquia = "50";
        ccZona = "01";
        ccSector = "01";
        ccManzanaPoligono = "001";
        ccPredio = "001";
        ccBloque = "000";
        ccPiso = "00";
        ccUnidad = "000";
    }

    private void ParsearClaveASegmentos(string clave)
    {
        if (string.IsNullOrWhiteSpace(clave) || clave.Length < 19)
        {
            ResetearSegmentos();
            return;
        }

        try
        {
            ccProvincia = clave.Length >= 2 ? clave.Substring(0, 2) : "10";
            ccCanton = clave.Length >= 4 ? clave.Substring(2, 2) : "02";
            ccParroquia = clave.Length >= 6 ? clave.Substring(4, 2) : "50";
            ccZona = clave.Length >= 8 ? clave.Substring(6, 2) : "01";
            ccSector = clave.Length >= 10 ? clave.Substring(8, 2) : "01";
            ccManzanaPoligono = clave.Length >= 13 ? clave.Substring(10, 3) : "001";
            ccPredio = clave.Length >= 16 ? clave.Substring(13, 3) : "001";

            if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
            {
                ccBloque = clave.Length >= 19 ? clave.Substring(16, 3) : "000";
                ccPiso = clave.Length >= 21 ? clave.Substring(19, 2) : "00";
                ccUnidad = clave.Length >= 24 ? clave.Substring(21, 3) : "000";
            }
            else
            {
                ccUnidad = clave.Length >= 19 ? clave.Substring(16, 3) : "000";
                ccBloque = "000";
                ccPiso = "00";
            }
        }
        catch
        {
            // Respaldo en caso de formato no estándar
        }
    }

    private async Task GuardarFichaCatastral()
    {
        SincronizarClaveDesdeSegmentos();
        procesandoModalFicha = true;
        modalFichaErrorMensaje = string.Empty;

        try
        {
            var resultado = await PredioService.CrearPredioBaseAsync(modeloCreacion);

            if (resultado.Exitoso)
            {
                CerrarModalFicha();
                await CargarPrediosPaginados();
                await MostrarToast("Ficha predial base registrada correctamente.", true);
            }
            else
            {
                modalFichaErrorMensaje = resultado.Mensaje ?? "No se pudo registrar la ficha predial.";
            }
        }
        catch (Exception ex)
        {
            modalFichaErrorMensaje = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            procesandoModalFicha = false;
        }
    }

    private void SolicitarCambioEstado(PredioDto predio)
    {
        predioAEstadoCambiar = predio;
    }

    private async Task ConfirmarCambioEstado()
    {
        if (predioAEstadoCambiar == null) return;

        var p = predioAEstadoCambiar;
        predioAEstadoCambiar = null;

        var resultado = await PredioService.CambiarEstadoAsync(p.Id);

        if (resultado.Exitoso)
        {
            await CargarPrediosPaginados();
            await MostrarToast(resultado.Mensaje ?? "Estado del predio actualizado correctamente.", true);
        }
        else
        {
            await MostrarToast(resultado.Mensaje ?? "No se pudo cambiar el estado del predio.", false);
        }
    }

    private async Task MostrarToast(string mensaje, bool esExito = true)
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        toastMensaje = mensaje;
        toastEsExito = esExito;
        StateHasChanged();

        try
        {
            await Task.Delay(4000, toastCts.Token);
            toastMensaje = string.Empty;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void OcultarToast() => toastMensaje = string.Empty;

    private string ShortGuid(Guid id) => id.ToString().Length > 8 ? id.ToString().Substring(0, 8) + "..." : id.ToString();
}