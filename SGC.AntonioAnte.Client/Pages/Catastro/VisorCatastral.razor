@page "/catastro/visor"
@using System.Threading
@using SGC.AntonioAnte.Client.Services.Catastro.Contracts
@using SGC.AntonioAnte.Domain.Catastro.Enums
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Predios
@implements IDisposable
@inject IPredioService PredioService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<div class="d-flex flex-column position-relative animate-fade-in" style="min-height: calc(100vh - 80px); height: 100%;">

    <!-- Filtros Flotantes -->
    <div class="position-absolute top-0 start-0 m-3 p-3 bg-white shadow-lg rounded-4" style="width: 320px; z-index: 1000;">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-globe-americas text-primary me-2"></i>Visor Cartográfico
        </h5>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold mb-1">Buscar Predio</label>
            <input type="text" class="form-control form-control-sm font-monospace" placeholder="Clave, dueño o dirección..."
                   @bind="busquedaFiltro" @bind:event="oninput" @onkeyup="OnBusquedaKeyUp" />
        </div>

        <div class="mb-3">
            <label class="form-label text-muted small fw-bold mb-1">Capa de Suelo</label>
            <select class="form-select form-select-sm" @bind="tipoPredioFiltro" @bind:after="CargarMapa">
                <option value="">Todas las capas</option>
                <option value="@TipoPredio.Urbano">Solo Urbano</option>
                <option value="@TipoPredio.Rural">Solo Rural</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-1">
            <span class="badge bg-primary-subtle text-primary border rounded-pill font-monospace px-3 py-2">
                @prediosEspaciales.Count predios
            </span>
            <button class="btn btn-sm btn-light border text-danger fw-semibold" @onclick="LimpiarFiltros">
                Limpiar
            </button>
        </div>
    </div>

    <!-- Contenedor del Mapa (Garantizamos ancho y alto) -->
    <div @ref="mapaContenedor" id="mapa-catastral" class="flex-grow-1 rounded-4 shadow-sm border" style="background-color: #f8fafc; min-height: 600px; width: 100%;"></div>

</div>

@code {
    private List<PredioEspacialDto> prediosEspaciales = new();
    private string busquedaFiltro = string.Empty;
    private TipoPredio? tipoPredioFiltro = null;
    private Timer? _debounceTimer;

    // 🔹 Referencia Nativa al DOM
    private ElementReference mapaContenedor;
    private DotNetObjectReference<VisorCatastral>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Respiro mínimo para asegurar el repintado del DOM en WASM
            await Task.Delay(50);

            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("visorGIS.setDotNetRef", _objRef);

            // Entregamos el elemento HTML físico
            await JSRuntime.InvokeVoidAsync("visorGIS.initMap", mapaContenedor);
            await CargarMapa();
        }
    }

    private async Task CargarMapa()
    {
        prediosEspaciales = await PredioService.ObtenerEspacialesAsync(busquedaFiltro, tipoPredioFiltro);
        await JSRuntime.InvokeVoidAsync("visorGIS.loadPredios", prediosEspaciales);
        StateHasChanged();
    }

    private void OnBusquedaKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                await CargarMapa();
            });
        }, null, 350, Timeout.Infinite);
    }

    private async Task LimpiarFiltros()
    {
        busquedaFiltro = string.Empty;
        tipoPredioFiltro = null;
        await CargarMapa();
    }

    [JSInvokable]
    public void AbrirFichaDesdeMapa(string idPredio)
    {
        NavManager.NavigateTo($"/catastro/predios?buscarId={idPredio}");
    }

    public void Dispose()
    {
        _objRef?.Dispose();
        _debounceTimer?.Dispose();
    }
}