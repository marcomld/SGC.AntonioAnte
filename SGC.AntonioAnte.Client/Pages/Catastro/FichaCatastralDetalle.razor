@page "/catastro/predios/nueva"
@page "/catastro/predios/{Id:guid}"

@using SGC.AntonioAnte.Client.Services.Catastro.Contracts
@using SGC.AntonioAnte.Domain.Catastro.Enums
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Catalogos
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Predios
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Propietarios
@using SGC.AntonioAnte.Shared.DTOs.Common
@using System.Threading

@implements IDisposable

@inject IPredioService PredioService
@inject IPropietarioService PropietarioService
@inject ICatalogoService CatalogoService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<div class="container-fluid py-4 animate-fade-in">

    @if (cargandoInicial)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2 fw-medium">Cargando expediente predial...</p>
        </div>
    }
    else
    {
        <!-- BARRA DE ACCIONES SUPERIOR (LIMPIA Y OPTIMIZADA) -->
        <div class="card border-0 shadow-sm mb-4 bg-white rounded-4">
            <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm" @onclick="Volver" title="Regresar">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                    <div>
                        <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-journal-text text-primary"></i>
                            <span>Ficha Catastral: @(string.IsNullOrWhiteSpace(modeloCreacion.ClaveCatastral) ? "Nueva" : modeloCreacion.ClaveCatastral)</span>
                        </h4>
                    </div>
                    @if (Id.HasValue)
                    {
                        <span class="badge @(esModoVisualizacion ? "bg-info-subtle text-info border border-info-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") font-monospace px-3 py-1.5 fs-6">
                            <i class="bi @(esModoVisualizacion ? "bi-eye" : "bi-pencil-square") me-1"></i>
                            @(esModoVisualizacion ? "MODO LECTURA" : "MODO EDICIÓN")
                        </span>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (esModoVisualizacion && Id.HasValue)
                    {
                        <button class="btn btn-warning text-dark fw-semibold shadow-hover px-3 py-2 d-flex align-items-center gap-2" @onclick="HabilitarEdicion">
                            <i class="bi bi-pencil-square"></i> Modificar Ficha
                        </button>
                    }
                    <button class="btn btn-success fw-semibold shadow-hover px-3 py-2 d-flex align-items-center gap-2" disabled="@(!Id.HasValue)">
                        <i class="bi bi-printer-fill"></i> Descargar Ficha
                    </button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMensaje))
        {
            <div class="alert alert-danger border-0 shadow-sm small mb-4 rounded-3 py-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 vertical-align-middle"></i> @errorMensaje
            </div>
        }

        <!-- CUERPO DE LA FICHA: PESTAÑAS Y DISEÑO COMPACTO EMPRESARIAL -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="px-4 pt-4 pb-0 bg-white">
                <ul class="nav nav-pills nav-fill gap-2 p-1 bg-light rounded-3 border mb-0" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(tabActivo == 1 ? "active fw-bold shadow-sm" : "text-secondary")" @onclick="() => tabActivo = 1" type="button">
                            <i class="bi @(EsTerrenoValido ? "bi-check-circle-fill text-success" : "bi-geo-alt") me-1"></i> Identificación del Predio
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(tabActivo == 2 ? "active fw-bold shadow-sm" : "text-secondary")" @onclick="() => tabActivo = 2" type="button">
                            <i class="bi @(EsDominioValido ? "bi-check-circle-fill text-success" : "bi-people") me-1"></i> Información Legal
                            <span class="badge @(TotalPorcentajeDominios == 100.00m ? "bg-success" : (TotalPorcentajeDominios > 100.00m ? "bg-danger" : "bg-warning text-dark")) ms-1 font-monospace">
                                @TotalPorcentajeDominios.ToString("0.##")%
                            </span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(tabActivo == 3 ? "active fw-bold shadow-sm" : "text-secondary")" @onclick="() => tabActivo = 3" type="button">
                            <i class="bi bi-houses me-1"></i> Construcciones
                            @if (listaBloquesMemoria.Any())
                            {
                                <span class="badge bg-primary ms-1 font-monospace">@listaBloquesMemoria.Count</span>
                            }
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4 bg-white" style="min-height: 450px;">
                <EditForm Model="@modeloCreacion" OnValidSubmit="GuardarFichaCatastral">
                    <DataAnnotationsValidator />

                    <!-- ========================================== -->
                    <!-- TAB 1: IDENTIFICACIÓN DEL PREDIO           -->
                    <!-- ========================================== -->
                    <div class="@(tabActivo == 1 ? "animate-fade-in" : "d-none")">
                        <div class="row g-4">
                            <!-- COLUMNA IZQUIERDA: CAMPOS Y TABLAS COMPACTAS -->
                            <div class="col-xl-8">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Identificación y Ubicación</h6>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted dpa-label mb-1">Clasificación</label>
                                        <InputSelect class="form-select form-select-sm fw-bold text-dark" @bind-Value="modeloCreacion.TipoPredio" @bind-Value:after="OnTipoPredioCambiado" disabled="@(procesando || Id.HasValue)">
                                            <option value="@TipoPredio.Urbano">URBANO</option>
                                            <option value="@TipoPredio.Rural">RURAL</option>
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted dpa-label mb-1">Clave Anterior / Referencial</label>
                                        <InputText class="form-control form-control-sm font-monospace" @bind-Value="modeloCreacion.ClaveAnterior" disabled="@(procesando || esModoVisualizacion)" />
                                    </div>
                                </div>

                                <!-- WIDGET DPA COMPACTO -->
                                <div class="d-flex align-items-center mb-1 gap-2">
                                    <label class="form-label text-muted dpa-label mb-0">Clave Catastral DPA Actual (División Política)</label>

                                    <!-- 🔥 VALIDACIÓN VISUAL ESTRICTA DE LA CLAVE DPA 🔥 -->
                                    <span class="badge @(modeloCreacion.ClaveCatastral?.Length == TotalDigitosEsperados ? "bg-success" : "bg-danger") font-monospace ms-2">
                                        @(modeloCreacion.ClaveCatastral?.Length ?? 0) / @TotalDigitosEsperados Dígitos
                                    </span>

                                    @if (Id.HasValue && !esModoVisualizacion)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-2" style="font-size:0.60rem;">BLOQUEADO POR SEGURIDAD</span>
                                    }
                                </div>
                                <div class="table-responsive mb-3">
                                    <table class="table table-bordered table-sm text-center mb-0 align-middle">
                                        <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.70rem;">
                                            <tr>
                                                <th width="10%">Prov</th>
                                                <th width="10%">Cantón</th>
                                                <th width="10%">Parrq</th>
                                                <th width="10%">Zona</th>
                                                <th width="10%">Sector</th>
                                                <th width="12%">Mnza/Pol</th>
                                                <th width="12%">Predio</th>
                                                @if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
                                                {
                                                    <th width="10%">Bloque</th>
                                                    <th width="8%">Piso</th>
                                                }
                                                <th width="10%">Unidad</th>
                                            </tr>
                                        </thead>
                                        <tbody class="font-monospace fw-bold bg-white">
                                            <tr>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="2" value="@ccProvincia" @oninput="(e) => OnSegmentoInput(e, 1)" disabled="@(procesando || Id.HasValue)" /></td>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="2" value="@ccCanton" @oninput="(e) => OnSegmentoInput(e, 2)" disabled="@(procesando || Id.HasValue)" /></td>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="2" value="@ccParroquia" @oninput="(e) => OnSegmentoInput(e, 3)" disabled="@(procesando || Id.HasValue)" /></td>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="2" value="@ccZona" @oninput="(e) => OnSegmentoInput(e, 4)" disabled="@(procesando || Id.HasValue)" /></td>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="2" value="@ccSector" @oninput="(e) => OnSegmentoInput(e, 5)" disabled="@(procesando || Id.HasValue)" /></td>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="3" value="@ccManzanaPoligono" @oninput="(e) => OnSegmentoInput(e, 6)" disabled="@(procesando || Id.HasValue)" /></td>
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="3" value="@ccPredio" @oninput="(e) => OnSegmentoInput(e, 7)" disabled="@(procesando || Id.HasValue)" /></td>
                                                @if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
                                                {
                                                    <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="3" value="@ccBloque" @oninput="(e) => OnSegmentoInput(e, 8)" disabled="@(procesando || Id.HasValue)" /></td>
                                                    <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="2" value="@ccPiso" @oninput="(e) => OnSegmentoInput(e, 9)" disabled="@(procesando || Id.HasValue)" /></td>
                                                }
                                                <td><input type="text" class="form-control form-control-sm text-center border-0 text-primary fw-bold px-0" maxlength="3" value="@ccUnidad" @oninput="(e) => OnSegmentoInput(e, 10)" disabled="@(procesando || Id.HasValue)" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- TABLA DE ÁREAS COMPACTA -->
                                <div class="table-responsive mb-3" style="max-width: 500px;">
                                    <table class="table table-bordered table-sm mb-0 align-middle">
                                        <thead class="table-light text-uppercase font-monospace text-muted small text-center" style="font-size: 0.70rem;">
                                            <tr>
                                                <th>Componente</th>
                                                <th>Área Escritura (m²)</th>
                                                <th>Área GIS (m²)</th>
                                            </tr>
                                        </thead>
                                        <tbody class="font-monospace">
                                            <tr>
                                                <td class="fw-bold bg-light-subtle text-dark" style="font-size:0.75rem;">TERRENO</td>
                                                <td><input type="number" step="0.01" class="form-control form-control-sm text-end border-0 px-1 py-0 fw-bold" @bind="modeloCreacion.AreaTerrenoEscritura" disabled="@(procesando || esModoVisualizacion)" /></td>
                                                <td><input type="number" step="0.01" class="form-control form-control-sm text-end border-0 px-1 py-0 text-muted" @bind="modeloCreacion.AreaTerrenoGrafica" disabled="true" /></td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold bg-light-subtle text-dark" style="font-size:0.75rem;">CONSTRUCCIÓN</td>
                                                <td colspan="2" class="text-center text-muted bg-light">@TotalAreaConstruccion.ToString("N2")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-muted dpa-label mb-1">Ubicación / Dirección Exacta</label>
                                    <InputText class="form-control form-control-sm fw-medium text-dark" @bind-Value="modeloCreacion.Direccion" disabled="@(procesando || esModoVisualizacion)" />
                                </div>

                                <div>
                                    <label class="form-label text-muted dpa-label mb-1">Polígono Espacial (WKT)</label>
                                    <InputTextArea class="form-control font-monospace text-muted bg-light border" style="height: 60px; font-size:0.75rem;" @bind-Value="modeloCreacion.PoligonoWkt" disabled="true" />

                                    <!-- 🔥 BOTÓN DEL MINI-MAPA EN MODAL 🔥 -->
                                    <button type="button" class="btn btn-outline-primary btn-sm fw-semibold mt-2 shadow-sm" @onclick="AbrirModalMapa" disabled="@procesando">
                                        <i class="bi bi-map me-1"></i> @(esModoVisualizacion ? "Ver Polígono en Mapa" : "Dibujar/Ver Polígono en Mapa")
                                    </button>
                                </div>
                            </div>

                            <!-- COLUMNA DERECHA: FOTOGRAFÍA FRONTAL -->
                            <div class="col-xl-4 d-flex flex-column">
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Evidencia Gráfica</h6>
                                <div class="card border h-100 rounded-3 overflow-hidden bg-light d-flex flex-column justify-content-center align-items-center text-muted" style="min-height: 320px;">
                                    <div class="text-center p-4">
                                        <i class="bi bi-camera display-3 opacity-25 mb-3"></i>
                                        <div class="small fw-semibold text-dark">Fotografía Frontal del Predio</div>
                                        <div class="text-muted mt-1" style="font-size: 0.7rem;">Sin imagen registrada en el expediente</div>
                                        @if (!esModoVisualizacion)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary mt-3 shadow-sm">
                                                <i class="bi bi-upload me-1"></i> Subir Fotografía
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 2: INFORMACIÓN LEGAL (DOMINIOS)        -->
                    <!-- ========================================== -->
                    <div class="@(tabActivo == 2 ? "animate-fade-in" : "d-none")">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Datos de los Propietarios o Posesionarios</h6>

                        @if (!esModoVisualizacion)
                        {
                            <div class="card border @(dominioEnEdicion != null ? "border-warning bg-warning-subtle" : "bg-light-subtle") rounded-3 p-3 mb-4 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="fw-bold text-dark small">
                                        <i class="bi @(dominioEnEdicion != null ? "bi-pencil-square text-warning" : "bi-person-plus-fill text-primary") me-1"></i>
                                        @(dominioEnEdicion != null ? "Editando Sujeto de Derecho" : "Vincular Sujeto de Derecho al Predio")
                                    </div>
                                    @if (dominioEnEdicion != null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="CancelarEdicionDominio">Cancelar Edición</button>
                                    }
                                </div>

                                <div class="row g-2 align-items-center mb-3">
                                    <div class="col-md-5">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                            <input type="text" class="form-control font-monospace" placeholder="Cédula / RUC..." @bind="cedulaBusquedaDominio" @onkeyup="OnCedulaBusquedaKeyUp" disabled="@(dominioEnEdicion != null)" />
                                            <button class="btn btn-outline-primary" type="button" @onclick="BuscarPropietarioPorCedula" disabled="@(buscandoPropietario || dominioEnEdicion != null)">Buscar</button>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        @if (propietarioEncontrado != null)
                                        {
                                            <div class="p-2 bg-white rounded border d-flex align-items-center justify-content-between">
                                                <div>
                                                    <span class="badge bg-primary-subtle text-primary border me-2 font-monospace">@propietarioEncontrado.Identificacion</span>
                                                    <strong class="text-dark small">@propietarioEncontrado.NombreCompleto</strong>
                                                </div>
                                                @if (dominioEnEdicion == null)
                                                {
                                                    <button type="button" class="btn-close btn-sm" @onclick="() => propietarioEncontrado = null"></button>
                                                }
                                            </div>
                                        }
                                        else if (!string.IsNullOrEmpty(mensajeBusquedaPropietario))
                                        {
                                            <span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>@mensajeBusquedaPropietario</span>
                                        }
                                    </div>
                                </div>

                                @if (propietarioEncontrado != null)
                                {
                                    <div class="row g-2 align-items-end pt-2 border-top">
                                        <div class="col-md-4">
                                            <label class="form-label text-muted dpa-label mb-1">Tipo de Tenencia <span class="text-danger">*</span></label>
                                            <select class="form-select form-select-sm fw-medium" @bind="nuevoDominioTipoTenenciaId">
                                                <option value="">-- Seleccionar --</option>
                                                @foreach (var t in tiposTenencia)
                                                {
                                                    <option value="@t.Id">@t.Nombre</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-muted dpa-label mb-1">% Propiedad <span class="text-danger">*</span></label>
                                            <input type="number" step="0.01" class="form-control form-control-sm text-end font-monospace fw-bold" @bind="nuevoDominioPorcentaje" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-muted dpa-label mb-1">Notaría / Título</label>
                                            <input type="text" class="form-control form-control-sm" @bind="nuevoDominioNotaria" />
                                        </div>
                                        <div class="col-md-3 d-flex justify-content-end">
                                            <button type="button" class="btn btn-sm @(dominioEnEdicion != null ? "btn-warning text-dark" : "btn-primary") w-100 fw-bold shadow-sm" @onclick="GuardarDominioEnLista">
                                                <i class="bi @(dominioEnEdicion != null ? "bi-check-lg" : "bi-plus-lg") me-1"></i>
                                                @(dominioEnEdicion != null ? "Actualizar" : "Asignar")
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0 custom-table">
                                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                                    <tr>
                                        <th class="ps-4 py-3">Identificación</th>
                                        <th class="py-3">Propietario / Razón Social</th>
                                        <th class="py-3">Tipo Tenencia</th>
                                        <th class="py-3 text-end">% Propiedad</th>
                                        <th class="py-3">Notaría</th>
                                        @if (!esModoVisualizacion)
                                        {
                                            <th class="text-end pe-4 py-3">Acciones</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody style="font-size: 0.85rem;">
                                    @if (!listaDominiosMemoria.Any())
                                    {
                                        <tr><td colspan="@(esModoVisualizacion ? 5 : 6)" class="text-center py-4 text-muted">No existen propietarios registrados en esta ficha.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var d in listaDominiosMemoria)
                                        {
                                            <tr class="@(dominioEnEdicion == d ? "table-warning" : "")">
                                                <td class="ps-4 font-monospace fw-bold text-secondary">
                                                    @d.Identificacion @if (Id.HasValue && d.Id == null)
                                                    {
                                                        <span class="badge bg-success ms-1" style="font-size: 0.6rem;">NUEVO</span>
                                                    }
                                                </td>
                                                <td class="fw-bold text-dark">@d.NombrePropietario</td>
                                                <td><span class="badge badge-dep text-dark">@d.NombreTipoTenencia</span></td>
                                                <td class="text-end font-monospace fw-bold text-primary fs-6">@d.PorcentajePropiedad.ToString("0.00")%</td>
                                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(d.Notaria) ? "N/A" : d.Notaria)</td>
                                                @if (!esModoVisualizacion)
                                                {
                                                    <td class="text-end pe-4">
                                                        <div class="d-inline-flex gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-2 btn-action" title="Editar" @onclick="() => CargarDominioParaEdicion(d)"><i class="bi bi-pencil"></i></button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Quitar" @onclick="() => EliminarDominioDeLista(d)"><i class="bi bi-trash"></i></button>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            <div class="card-footer bg-light border-top py-2 px-4 d-flex justify-content-end align-items-center gap-3">
                                <span class="fw-bold text-muted small text-uppercase">Total Alícuota Asignada:</span>
                                <span class="fs-5 font-monospace fw-bold @(TotalPorcentajeDominios == 100.00m ? "text-success" : "text-danger")">
                                    @TotalPorcentajeDominios.ToString("0.00")%
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- TAB 3: CONSTRUCCIONES (BLOQUES)            -->
                    <!-- ========================================== -->
                    <div class="@(tabActivo == 3 ? "animate-fade-in" : "d-none")">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Inventario de Bloques Constructivos</h6>

                        @if (!esModoVisualizacion)
                        {
                            <div class="card border @(bloqueEnEdicion != null ? "border-warning bg-warning-subtle" : "bg-light-subtle") rounded-3 p-3 mb-4 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="fw-bold text-dark small">
                                        <i class="bi @(bloqueEnEdicion != null ? "bi-pencil-square text-warning" : "bi-plus-square-fill text-primary") me-1"></i>
                                        @(bloqueEnEdicion != null ? $"Editando Bloque Nro. {bloqueEnEdicion.NumeroBloque}" : "Caracterización de Bloque Constructivo")
                                    </div>
                                    @if (bloqueEnEdicion != null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0" @onclick="CancelarEdicionBloque">Cancelar Edición</button>
                                    }
                                </div>

                                <div class="row g-2 align-items-end">
                                    <div class="col-6 col-md-2">
                                        <label class="form-label text-muted dpa-label mb-1">Nro. Bloque <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control form-control-sm text-center font-monospace fw-bold" @bind="nuevoBloqueNumero" min="1" disabled="@(bloqueEnEdicion != null)" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label text-muted dpa-label mb-1">Tipo Estructura <span class="text-danger">*</span></label>
                                        <select class="form-select form-select-sm fw-medium" @bind="nuevoBloqueTipoEstructuraId">
                                            <option value="">-- Seleccionar --</option>
                                            @foreach (var est in tiposEstructura)
                                            {
                                                <option value="@est.Id">@est.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label text-muted dpa-label mb-1">Estado Conservación <span class="text-danger">*</span></label>
                                        <select class="form-select form-select-sm fw-medium" @bind="nuevoBloqueEstadoConservacionId">
                                            <option value="">-- Seleccionar --</option>
                                            @foreach (var cons in estadosConservacion)
                                            {
                                                <option value="@cons.Id">@cons.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label text-muted dpa-label mb-1">Pisos <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control form-control-sm text-center font-monospace" @bind="nuevoBloqueNumeroPisos" min="1" />
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label text-muted dpa-label mb-1">Año Const. <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control form-control-sm text-center font-monospace" @bind="nuevoBloqueAnioConstruccion" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label text-muted dpa-label mb-1">Área (m²) <span class="text-danger">*</span></label>
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end font-monospace fw-bold" @bind="nuevoBloqueAreaConstruccion" />
                                    </div>
                                    <div class="col-md-9 d-flex justify-content-end">
                                        <button type="button" class="btn btn-sm @(bloqueEnEdicion != null ? "btn-warning text-dark" : "btn-primary") px-4 fw-bold shadow-sm" @onclick="GuardarBloqueEnLista">
                                            <i class="bi @(bloqueEnEdicion != null ? "bi-check-lg" : "bi-plus-lg") me-1"></i>
                                            @(bloqueEnEdicion != null ? "Actualizar Bloque" : "Agregar Bloque")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0 custom-table">
                                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                                    <tr>
                                        <th class="ps-4 py-3 text-center">Bloque N°</th>
                                        <th class="py-3">Estructura</th>
                                        <th class="py-3">Estado Conservación</th>
                                        <th class="py-3 text-center">Pisos</th>
                                        <th class="py-3 text-center">Año</th>
                                        <th class="py-3 text-end">Área (m²)</th>
                                        @if (!esModoVisualizacion)
                                        {
                                            <th class="text-end pe-4 py-3">Acciones</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody style="font-size: 0.85rem;">
                                    @if (!listaBloquesMemoria.Any())
                                    {
                                        <tr><td colspan="@(esModoVisualizacion ? 6 : 7)" class="text-center py-4 text-muted">No se han registrado edificaciones para este predio.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var b in listaBloquesMemoria)
                                        {
                                            <tr class="@(bloqueEnEdicion == b ? "table-warning" : "")">
                                                <td class="ps-4 text-center font-monospace fw-bold text-primary">
                                                    #@b.NumeroBloque @if (Id.HasValue && b.Id == null)
                                                    {
                                                        <span class="badge bg-success ms-1" style="font-size: 0.6rem;">NUEVO</span>
                                                    }
                                                </td>
                                                <td class="fw-bold text-dark">@b.NombreTipoEstructura</td>
                                                <td><span class="badge badge-dep text-dark">@b.NombreEstadoConservacion</span></td>
                                                <td class="text-center font-monospace">@b.NumeroPisos</td>
                                                <td class="text-center font-monospace text-secondary">@b.AnioConstruccion</td>
                                                <td class="text-end font-monospace fw-bold fs-6">@b.AreaConstruccion.ToString("N2")</td>
                                                @if (!esModoVisualizacion)
                                                {
                                                    <td class="text-end pe-4">
                                                        <div class="d-inline-flex gap-1">
                                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-2 btn-action" title="Editar" @onclick="() => CargarBloqueParaEdicion(b)"><i class="bi bi-pencil"></i></button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Quitar" @onclick="() => EliminarBloqueDeLista(b)"><i class="bi bi-trash"></i></button>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            <div class="card-footer bg-light border-top py-2 px-4 d-flex justify-content-end align-items-center gap-3">
                                <span class="fw-bold text-muted small text-uppercase">Área Total Construida:</span>
                                <span class="fs-5 font-monospace fw-bold text-dark">
                                    @TotalAreaConstruccion.ToString("N2") m²
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- FOOTER DE GUARDADO (SOLO VISIBLE EN MODO EDICIÓN) -->
                    @if (!esModoVisualizacion)
                    {
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mt-5 pt-3 border-top gap-3 bg-white">
                            <div class="small">
                                @if (!EsTerrenoValido)
                                {
                                    <span class="text-danger fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>Datos de terreno incompletos o inválidos.</span>
                                }
                                else if (!EsDominioValido)
                                {
                                    <span class="text-warning text-dark fw-semibold"><i class="bi bi-pie-chart-fill me-1"></i>Propietarios deben sumar exactamente 100.00%.</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Ficha validada y lista para ser guardada.</span>
                                }
                            </div>
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-light fw-semibold text-muted px-4 border shadow-sm" @onclick="Volver" disabled="@procesando">Cancelar</button>
                                <button type="submit" class="btn btn-primary fw-bold shadow-sm px-5 py-2" disabled="@(!FormularioEsValido || procesando || dominioEnEdicion != null || bloqueEnEdicion != null)">
                                    @if (procesando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span> <span>Procesando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-save me-2"></i> <span>@(Id.HasValue ? "Guardar Cambios" : "Crear Expediente Predial")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                </EditForm>
            </div>
        </div>
    }
</div>

