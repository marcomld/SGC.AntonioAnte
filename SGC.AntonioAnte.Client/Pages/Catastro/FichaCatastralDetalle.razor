@code {
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromQuery] public string? modo { get; set; }

    private bool cargandoInicial = true;
    private bool procesando = false;
    private bool esModoVisualizacion = false;
    private bool esModoEdicion = false;
    private int tabActivo = 1;
    private string errorMensaje = string.Empty;

    // 🔥 REFERENCIAS DEL MODAL DEL MAPA 🔥
    private bool mostrarModalMapa = false;
    private DotNetObjectReference<FichaCatastralDetalle>? _objRef;

    private CreatePredioDto modeloCreacion = new();

    // DPA
    private string ccProvincia = "10"; private string ccCanton = "02"; private string ccParroquia = "50";
    private string ccZona = "01"; private string ccSector = "01"; private string ccManzanaPoligono = "001";
    private string ccPredio = "001"; private string ccBloque = "000"; private string ccPiso = "00"; private string ccUnidad = "000";

    private int TotalDigitosEsperados => modeloCreacion.TipoPredio == TipoPredio.Urbano ? 24 : 19;

    // 🔥 CORRECCIÓN: Validación Robusta de Longitud 🔥
    private bool EsTerrenoValido => (modeloCreacion.ClaveCatastral?.Length ?? 0) == TotalDigitosEsperados && modeloCreacion.AreaTerrenoEscritura > 0 && !string.IsNullOrWhiteSpace(modeloCreacion.Direccion);

    private bool EsDominioValido => listaDominiosMemoria.Any() && TotalPorcentajeDominios == 100.00m;
    private bool FormularioEsValido => EsTerrenoValido && EsDominioValido;

    private List<CatalogoDto> tiposTenencia = new();
    private List<CatalogoDto> tiposEstructura = new();
    private List<CatalogoDto> estadosConservacion = new();

    // Dominios
    private string cedulaBusquedaDominio = string.Empty;
    private bool buscandoPropietario = false;
    private string mensajeBusquedaPropietario = string.Empty;
    private PropietarioDto? propietarioEncontrado = null;
    private Guid? nuevoDominioTipoTenenciaId = null;
    private decimal nuevoDominioPorcentaje = 100.00m;
    private string nuevoDominioNotaria = string.Empty;
    private ItemDominioMemoria? dominioEnEdicion = null;

    public class ItemDominioMemoria { public Guid? Id { get; set; } public Guid PropietarioId { get; set; } public string Identificacion { get; set; } = string.Empty; public string NombrePropietario { get; set; } = string.Empty; public Guid TipoTenenciaId { get; set; } public string NombreTipoTenencia { get; set; } = string.Empty; public decimal PorcentajePropiedad { get; set; } public string? Notaria { get; set; } }
    private List<ItemDominioMemoria> listaDominiosMemoria = new();
    private decimal TotalPorcentajeDominios => listaDominiosMemoria.Sum(d => d.PorcentajePropiedad);

    // Bloques
    private int nuevoBloqueNumero = 1;
    private Guid? nuevoBloqueTipoEstructuraId = null;
    private Guid? nuevoBloqueEstadoConservacionId = null;
    private int nuevoBloqueNumeroPisos = 1;
    private int nuevoBloqueAnioConstruccion = DateTime.Now.Year;
    private decimal nuevoBloqueAreaConstruccion = 0.00m;
    private ItemBloqueMemoria? bloqueEnEdicion = null;

    public class ItemBloqueMemoria { public Guid? Id { get; set; } public int NumeroBloque { get; set; } public Guid TipoEstructuraId { get; set; } public string NombreTipoEstructura { get; set; } = string.Empty; public Guid EstadoConservacionId { get; set; } public string NombreEstadoConservacion { get; set; } = string.Empty; public int NumeroPisos { get; set; } public decimal AreaConstruccion { get; set; } public int AnioConstruccion { get; set; } }
    private List<ItemBloqueMemoria> listaBloquesMemoria = new();
    private decimal TotalAreaConstruccion => listaBloquesMemoria.Sum(b => b.AreaConstruccion);

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogos();

        if (Id.HasValue)
        {
            esModoVisualizacion = (modo != "editar");
            esModoEdicion = !esModoVisualizacion;
            await CargarFicha(Id.Value);
        }
        else
        {
            esModoVisualizacion = false;
            esModoEdicion = false;
            modeloCreacion = new CreatePredioDto { TipoPredio = TipoPredio.Urbano };
            ResetearSegmentos();
            SincronizarClaveDesdeSegmentos();
            cargandoInicial = false;
        }
    }

    // 🔥 FUNCIONES DEL MODAL DEL MAPA 🔥
    private async Task AbrirModalMapa()
    {
        mostrarModalMapa = true;
        StateHasChanged();

        await Task.Delay(150);

        _objRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("visorGIS.initMiniMap", "mini-mapa-ficha", _objRef, esModoEdicion || !Id.HasValue, modeloCreacion.PoligonoWkt);
    }

    private void CerrarModalMapa()
    {
        mostrarModalMapa = false;
    }

    [JSInvokable]
    public void ActualizarDatosEspaciales(string wkt, double areaGrafica)
    {
        modeloCreacion.PoligonoWkt = wkt;
        modeloCreacion.AreaTerrenoGrafica = (decimal)areaGrafica;
        StateHasChanged();
    }

    private void HabilitarEdicion()
    {
        esModoVisualizacion = false;
        esModoEdicion = true;
    }

    private async Task Volver()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    private async Task CargarCatalogos()
    {
        var taskTenencia = CatalogoService.ObtenerTiposTenenciaAsync();
        var taskEstructura = CatalogoService.ObtenerTiposEstructuraAsync();
        var taskConservacion = CatalogoService.ObtenerEstadosConservacionAsync();
        await Task.WhenAll(taskTenencia, taskEstructura, taskConservacion);
        tiposTenencia = await taskTenencia; tiposEstructura = await taskEstructura; estadosConservacion = await taskConservacion;
    }

    private async Task CargarFicha(Guid id)
    {
        var predioCompleto = await PredioService.ObtenerPorIdAsync(id);
        if (predioCompleto == null) { errorMensaje = "No se pudo cargar el predio."; cargandoInicial = false; return; }

        modeloCreacion = new CreatePredioDto { ClaveCatastral = predioCompleto.ClaveCatastral, ClaveAnterior = predioCompleto.ClaveAnterior, TipoPredio = predioCompleto.TipoPredio, AreaTerrenoEscritura = predioCompleto.AreaTerrenoEscritura, AreaTerrenoGrafica = predioCompleto.AreaTerrenoGrafica, Direccion = predioCompleto.Direccion, PoligonoWkt = predioCompleto.PoligonoWkt };
        ParsearClaveASegmentos(predioCompleto.ClaveCatastral);

        listaDominiosMemoria = (predioCompleto.Dominios ?? new()).Select(d => new ItemDominioMemoria { Id = d.Id, PropietarioId = d.PropietarioId, Identificacion = d.IdentificacionPropietario, NombrePropietario = d.NombrePropietario, TipoTenenciaId = d.TipoTenenciaId, NombreTipoTenencia = d.NombreTipoTenencia, PorcentajePropiedad = d.PorcentajePropiedad, Notaria = d.Notaria }).ToList();
        listaBloquesMemoria = (predioCompleto.Bloques ?? new()).Select(b => new ItemBloqueMemoria { Id = b.Id, NumeroBloque = b.NumeroBloque, TipoEstructuraId = b.TipoEstructuraId, NombreTipoEstructura = b.NombreTipoEstructura, EstadoConservacionId = b.EstadoConservacionId, NombreEstadoConservacion = b.NombreEstadoConservacion, NumeroPisos = b.NumeroPisos, AreaConstruccion = b.AreaConstruccion, AnioConstruccion = b.AnioConstruccion }).ToList();

        ResetearFormularioDominio(); ResetearFormularioBloque();
        cargandoInicial = false;
    }

    // LÓGICA DOMINIOS
    private async Task BuscarPropietarioPorCedula() { if (string.IsNullOrWhiteSpace(cedulaBusquedaDominio)) return; buscandoPropietario = true; mensajeBusquedaPropietario = ""; propietarioEncontrado = null; try { var p = await PropietarioService.ObtenerPorIdentificacionAsync(cedulaBusquedaDominio.Trim()); if (p != null) { propietarioEncontrado = p; if (!nuevoDominioTipoTenenciaId.HasValue && tiposTenencia.Any()) nuevoDominioTipoTenenciaId = tiposTenencia.First().Id; } else mensajeBusquedaPropietario = $"No existe '{cedulaBusquedaDominio}'."; } catch { } finally { buscandoPropietario = false; } }
    private async Task OnCedulaBusquedaKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await BuscarPropietarioPorCedula(); }
    private void CargarDominioParaEdicion(ItemDominioMemoria item) { dominioEnEdicion = item; cedulaBusquedaDominio = item.Identificacion; propietarioEncontrado = new PropietarioDto { Id = item.PropietarioId, Identificacion = item.Identificacion, NombreCompleto = item.NombrePropietario }; nuevoDominioTipoTenenciaId = item.TipoTenenciaId; nuevoDominioPorcentaje = item.PorcentajePropiedad; nuevoDominioNotaria = item.Notaria ?? ""; errorMensaje = ""; }
    private void CancelarEdicionDominio() { dominioEnEdicion = null; ResetearFormularioDominio(); }
    private void GuardarDominioEnLista() { if (propietarioEncontrado == null || !nuevoDominioTipoTenenciaId.HasValue) return; if (dominioEnEdicion == null && listaDominiosMemoria.Any(d => d.PropietarioId == propietarioEncontrado.Id)) { errorMensaje = "Propietario ya vinculado."; return; } decimal porcActual = dominioEnEdicion?.PorcentajePropiedad ?? 0; decimal suma = TotalPorcentajeDominios - porcActual + nuevoDominioPorcentaje; if (suma > 100.00m) { errorMensaje = $"Supera el 100.00% (Sumaría {suma:0.00}%)."; return; } var nomTen = tiposTenencia.FirstOrDefault(t => t.Id == nuevoDominioTipoTenenciaId.Value)?.Nombre ?? "Tenencia"; if (dominioEnEdicion != null) { dominioEnEdicion.PropietarioId = propietarioEncontrado.Id; dominioEnEdicion.Identificacion = propietarioEncontrado.Identificacion; dominioEnEdicion.NombrePropietario = propietarioEncontrado.NombreCompleto; dominioEnEdicion.TipoTenenciaId = nuevoDominioTipoTenenciaId.Value; dominioEnEdicion.NombreTipoTenencia = nomTen; dominioEnEdicion.PorcentajePropiedad = nuevoDominioPorcentaje; dominioEnEdicion.Notaria = nuevoDominioNotaria; dominioEnEdicion = null; } else { listaDominiosMemoria.Add(new ItemDominioMemoria { Id = null, PropietarioId = propietarioEncontrado.Id, Identificacion = propietarioEncontrado.Identificacion, NombrePropietario = propietarioEncontrado.NombreCompleto, TipoTenenciaId = nuevoDominioTipoTenenciaId.Value, NombreTipoTenencia = nomTen, PorcentajePropiedad = nuevoDominioPorcentaje, Notaria = nuevoDominioNotaria }); } ResetearFormularioDominio(); }
    private void EliminarDominioDeLista(ItemDominioMemoria item) => listaDominiosMemoria.Remove(item);
    private void ResetearFormularioDominio() { propietarioEncontrado = null; cedulaBusquedaDominio = ""; nuevoDominioNotaria = ""; errorMensaje = ""; decimal restante = 100.00m - TotalPorcentajeDominios; nuevoDominioPorcentaje = restante > 0 ? restante : 100.00m; }

    // LÓGICA BLOQUES
    private void CargarBloqueParaEdicion(ItemBloqueMemoria item) { bloqueEnEdicion = item; nuevoBloqueNumero = item.NumeroBloque; nuevoBloqueTipoEstructuraId = item.TipoEstructuraId; nuevoBloqueEstadoConservacionId = item.EstadoConservacionId; nuevoBloqueNumeroPisos = item.NumeroPisos; nuevoBloqueAreaConstruccion = item.AreaConstruccion; nuevoBloqueAnioConstruccion = item.AnioConstruccion; errorMensaje = ""; }
    private void CancelarEdicionBloque() { bloqueEnEdicion = null; ResetearFormularioBloque(); }
    private void GuardarBloqueEnLista() { if (!nuevoBloqueTipoEstructuraId.HasValue || !nuevoBloqueEstadoConservacionId.HasValue) return; var nomEst = tiposEstructura.FirstOrDefault(e => e.Id == nuevoBloqueTipoEstructuraId.Value)?.Nombre ?? "Estructura"; var nomCons = estadosConservacion.FirstOrDefault(c => c.Id == nuevoBloqueEstadoConservacionId.Value)?.Nombre ?? "Conservación"; if (bloqueEnEdicion != null) { bloqueEnEdicion.TipoEstructuraId = nuevoBloqueTipoEstructuraId.Value; bloqueEnEdicion.NombreTipoEstructura = nomEst; bloqueEnEdicion.EstadoConservacionId = nuevoBloqueEstadoConservacionId.Value; bloqueEnEdicion.NombreEstadoConservacion = nomCons; bloqueEnEdicion.NumeroPisos = nuevoBloqueNumeroPisos; bloqueEnEdicion.AreaConstruccion = nuevoBloqueAreaConstruccion; bloqueEnEdicion.AnioConstruccion = nuevoBloqueAnioConstruccion; bloqueEnEdicion = null; } else { listaBloquesMemoria.Add(new ItemBloqueMemoria { Id = null, NumeroBloque = nuevoBloqueNumero, TipoEstructuraId = nuevoBloqueTipoEstructuraId.Value, NombreTipoEstructura = nomEst, EstadoConservacionId = nuevoBloqueEstadoConservacionId.Value, NombreEstadoConservacion = nomCons, NumeroPisos = nuevoBloqueNumeroPisos, AreaConstruccion = nuevoBloqueAreaConstruccion, AnioConstruccion = nuevoBloqueAnioConstruccion }); } ResetearFormularioBloque(); }
    private void EliminarBloqueDeLista(ItemBloqueMemoria item) => listaBloquesMemoria.Remove(item);
    private void ResetearFormularioBloque() { nuevoBloqueNumero = listaBloquesMemoria.Any() ? listaBloquesMemoria.Max(b => b.NumeroBloque) + 1 : 1; nuevoBloqueAreaConstruccion = 0.00m; errorMensaje = string.Empty; }

    // 🔥 CORRECCIÓN: DPA SEGMENTOS 🔥
    private void OnTipoPredioCambiado() => SincronizarClaveDesdeSegmentos();
    private void OnSegmentoInput(ChangeEventArgs e, int segmentoIndex)
    {
        var raw = e.Value?.ToString() ?? "";
        var s = new string(raw.Where(char.IsDigit).ToArray());
        switch (segmentoIndex)
        {
            case 1: ccProvincia = s; break;
            case 2: ccCanton = s; break;
            case 3: ccParroquia = s; break;
            case 4: ccZona = s; break;
            case 5: ccSector = s; break;
            case 6: ccManzanaPoligono = s; break;
            case 7: ccPredio = s; break;
            case 8: ccBloque = s; break;
            case 9: ccPiso = s; break;
            case 10: ccUnidad = s; break;
        }
        SincronizarClaveDesdeSegmentos();
    }

    private void SincronizarClaveDesdeSegmentos()
    {
        string clave = "";
        if (modeloCreacion.TipoPredio == TipoPredio.Urbano)
            clave = $"{ccProvincia}{ccCanton}{ccParroquia}{ccZona}{ccSector}{ccManzanaPoligono}{ccPredio}{ccBloque}{ccPiso}{ccUnidad}";
        else
            clave = $"{ccProvincia}{ccCanton}{ccParroquia}{ccZona}{ccSector}{ccManzanaPoligono}{ccPredio}{ccUnidad}";

        // Forzamos a quitar los espacios si es que llegan a colarse
        modeloCreacion.ClaveCatastral = clave.Replace(" ", "");
    }

    private void ResetearSegmentos() { ccProvincia = "10"; ccCanton = "02"; ccParroquia = "50"; ccZona = "01"; ccSector = "01"; ccManzanaPoligono = "001"; ccPredio = "001"; ccBloque = "000"; ccPiso = "00"; ccUnidad = "000"; }

    private void ParsearClaveASegmentos(string c)
    {
        if (string.IsNullOrWhiteSpace(c) || c.Length < 19) { ResetearSegmentos(); return; }
        try
        {
            ccProvincia = c.Substring(0, 2); ccCanton = c.Substring(2, 2); ccParroquia = c.Substring(4, 2); ccZona = c.Substring(6, 2); ccSector = c.Substring(8, 2); ccManzanaPoligono = c.Substring(10, 3); ccPredio = c.Substring(13, 3);
            if (modeloCreacion.TipoPredio == TipoPredio.Urbano) { ccBloque = c.Substring(16, 3); ccPiso = c.Substring(19, 2); ccUnidad = c.Substring(21, 3); }
            else { ccUnidad = c.Substring(16, 3); ccBloque = "000"; ccPiso = "00"; }
        }
        catch { }
    }

    private async Task GuardarFichaCatastral()
    {
        SincronizarClaveDesdeSegmentos();

        // 🔥 VALIDACIÓN ESTRICTA ADICIONAL 🔥
        if (modeloCreacion.ClaveCatastral.Length != TotalDigitosEsperados)
        {
            errorMensaje = $"La clave DPA debe tener exactamente {TotalDigitosEsperados} dígitos. Revise que no haya casilleros en blanco.";
            return;
        }

        if (!FormularioEsValido) { errorMensaje = "Verifique datos de terreno y el 100% de dominios."; return; }

        procesando = true; errorMensaje = string.Empty;

        try
        {
            OperacionResultadoDto resultado;
            if (Id.HasValue && esModoEdicion)
            {
                var f = new UpdateFichaCatastralDto { Id = Id.Value, Predio = modeloCreacion, Dominios = listaDominiosMemoria.Select(d => new UpdateDominioDto { Id = d.Id, PropietarioId = d.PropietarioId, TipoTenenciaId = d.TipoTenenciaId, PorcentajePropiedad = d.PorcentajePropiedad, Notaria = d.Notaria, FechaInscripcion = DateTime.UtcNow }).ToList(), Bloques = listaBloquesMemoria.Select(b => new UpdateBloqueDto { Id = b.Id, NumeroBloque = b.NumeroBloque, TipoEstructuraId = b.TipoEstructuraId, EstadoConservacionId = b.EstadoConservacionId, NumeroPisos = b.NumeroPisos, AreaConstruccion = b.AreaConstruccion, AnioConstruccion = b.AnioConstruccion }).ToList() };
                resultado = await PredioService.ActualizarFichaCompletaAsync(Id.Value, f);
            }
            else
            {
                var f = new CreateFichaCatastralDto { Predio = modeloCreacion, Dominios = listaDominiosMemoria.Select(d => new AddDominioDto { PropietarioId = d.PropietarioId, TipoTenenciaId = d.TipoTenenciaId, PorcentajePropiedad = d.PorcentajePropiedad, Notaria = d.Notaria, FechaInscripcion = DateTime.UtcNow }).ToList(), Bloques = listaBloquesMemoria.Select(b => new AddBloqueDto { NumeroBloque = b.NumeroBloque, TipoEstructuraId = b.TipoEstructuraId, EstadoConservacionId = b.EstadoConservacionId, NumeroPisos = b.NumeroPisos, AreaConstruccion = b.AreaConstruccion, AnioConstruccion = b.AnioConstruccion }).ToList() };
                resultado = await PredioService.GuardarFichaCompletaAsync(f);
            }

            if (resultado.Exitoso) await Volver();
            else errorMensaje = resultado.Mensaje ?? "Ocurrió un error al procesar la ficha.";
        }
        catch (Exception ex) { errorMensaje = $"Error: {ex.Message}"; }
        finally { procesando = false; }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}