@page "/seguridad/roles"
@attribute [Authorize(Roles = "AdminSistemas,SuperAdmin")]
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Roles
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Usuarios
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using Microsoft.AspNetCore.Authorization

@inject IRoleService RoleService
@inject IUsuarioService UserService

<div class="container-fluid py-4 animate-fade-in">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock-fill me-2 text-primary"></i>Roles y Permisos Granulares
            </h2>
            <p class="text-muted small mb-0">Parametrización de niveles de acceso, matriz de claims y roles institucionales del GAD Municipal.</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-hover py-2 fw-semibold" @onclick="AbrirModalCrearRol">
            <i class="bi bi-shield-plus"></i>
            <span>Nuevo Rol</span>
        </button>
    </div>

    <!-- TOAST AUTOMÁTICO FLOTANTE -->
    @if (!string.IsNullOrEmpty(feedbackMensaje))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
            <div class="toast show shadow-lg border-0 bg-white" role="alert">
                <div class="toast-header @(esExitoFeedback ? "bg-success text-white" : "bg-danger text-white") border-0 py-2">
                    <i class="bi @(esExitoFeedback ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2 fs-6"></i>
                    <strong class="me-auto">@(esExitoFeedback ? "Éxito" : "Atención")</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => feedbackMensaje = null"></button>
                </div>
                <div class="toast-body fw-medium text-dark py-3">@feedbackMensaje</div>
            </div>
        </div>
    }

    <!-- CARGANDO... -->
    @if (cargando)
    {
        <div class="text-center py-5 my-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted fw-medium">Cargando matriz de roles y permisos...</p>
        </div>
    }
    else
    {
        <!-- TARJETAS DE ROLES -->
        <div class="row g-4">
            @foreach (var role in roles)
            {
                var usuariosDelRol = todosLosUsuarios.Count(u => u.Roles != null && u.Roles.Contains(role.Nombre));

                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-lg bg-white role-card rounded-4 overflow-hidden">
                        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>

                        <div class="card-header border-0 bg-transparent pt-4 pb-0 px-4 d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-3">
                                <div class="role-icon-box">
                                    <i class="bi bi-shield-shaded fs-4 text-white"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-dark mb-0">@role.Nombre</h5>
                                    <div class="d-flex gap-2 mt-1">
                                        @if (role.Nombre == "AdminSistemas" || role.Nombre == "SuperAdmin")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5">Sistema Base</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-dark border border-info-subtle rounded-pill px-2.5">Personalizado</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (role.Nombre != "AdminSistemas" && role.Nombre != "SuperAdmin")
                            {
                                <button class="btn btn-link text-muted p-0 hover-danger" @onclick="() => SolicitarEliminarRol(role)" title="Eliminar Rol">
                                    <i class="bi bi-trash fs-5"></i>
                                </button>
                            }
                        </div>

                        <div class="card-body px-4 py-3">
                            <p class="text-muted small mb-3 text-truncate-2" style="min-height: 2.5rem;">
                                @(string.IsNullOrWhiteSpace(role.Descripcion) ? "Rol parametrizado para acceso al sistema." : role.Descripcion)
                            </p>

                            <div class="d-flex justify-content-between align-items-center p-2.5 rounded-3 bg-light border">
                                <span class="small fw-bold text-secondary text-uppercase"><i class="bi bi-people-fill me-2 text-primary"></i>Funcionarios</span>
                                <span class="badge bg-white text-dark border shadow-sm rounded-pill px-3 py-1.5 fw-bold">
                                    @usuariosDelRol
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm fw-semibold d-flex align-items-center justify-content-center gap-2 py-2"
                                        @onclick="() => AbrirModalPermisos(role)">
                                    <i class="bi bi-key-fill"></i> Matriz de Permisos
                                </button>

                                <div class="btn-group w-100" role="group">
                                    <button type="button" class="btn btn-outline-success btn-sm fw-semibold w-50 py-1.5"
                                            @onclick="() => AbrirModalAsignar(role, true)">
                                        <i class="bi bi-person-plus-fill me-1"></i> Asignar
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold w-50 py-1.5"
                                            @onclick="() => AbrirModalAsignar(role, false)"
                                            disabled="@(usuariosDelRol == 0)">
                                        <i class="bi bi-person-dash-fill me-1"></i> Quitar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODAL 1: CREAR ROL -->
@if (mostrarModalCrear)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <!-- Eliminado modal-sm -->
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-shield-plus text-primary me-2"></i>Nuevo Rol</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>
                <div class="modal-body p-4">
                    <EditForm Model="@modeloNuevoRol" OnValidSubmit="EjecutarCrearRol">
                        <DataAnnotationsValidator />
                        <div class="form-floating mb-3">
                            <InputText id="txtNombreRol" class="form-control" @bind-Value="modeloNuevoRol.Nombre" placeholder="Nombre" disabled="@procesando" />
                            <label for="txtNombreRol">Nombre del Rol</label>
                            <ValidationMessage For="@(() => modeloNuevoRol.Nombre)" class="text-danger small mt-1" />
                        </div>
                        <div class="form-floating mb-4">
                            <InputText id="txtDescRol" class="form-control" @bind-Value="modeloNuevoRol.Descripcion" placeholder="Descripción" disabled="@procesando" />
                            <label for="txtDescRol">Descripción / Función</label>
                            <ValidationMessage For="@(() => modeloNuevoRol.Descripcion)" class="text-danger small mt-1" />
                        </div>

                        <!-- Botones horizontales alineados a la derecha -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light fw-semibold text-muted" @onclick="CerrarModales">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold shadow-sm px-4" disabled="@procesando">
                                @if (procesando)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar Rol</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 2: PERMISOS GRANULARES -->
@if (mostrarModalPermisos && rolSeleccionado != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1075;">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 bg-light p-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-sliders me-2 text-primary"></i>Configurar Permisos del Rol</h5>
                        <p class="text-muted small mb-0">Rol Objetivo: <span class="fw-bold text-primary">@rolSeleccionado.Nombre</span></p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>

                <div class="modal-body p-4">
                    @if (permisosRol == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                            <span class="text-muted fw-medium">Cargando matriz de permisos del rol...</span>
                        </div>
                    }
                    else if (!permisosRol.Any())
                    {
                        <div class="text-center py-4 bg-light rounded-3">
                            <p class="text-muted small mb-0">No hay permisos registrados en el catálogo maestro.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var grupo in permisosRol.GroupBy(p => string.IsNullOrWhiteSpace(p.Modulo) ? "General" : p.Modulo))
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 border bg-light-subtle rounded-3 shadow-sm">
                                        <div class="card-header bg-transparent fw-bold text-uppercase small text-secondary border-bottom-0 d-flex justify-content-between align-items-center py-3">
                                            <span><i class="bi bi-folder2-open me-2 text-primary"></i>Módulo: @grupo.Key</span>
                                            <span class="badge bg-secondary rounded-pill">@grupo.Count()</span>
                                        </div>
                                        <div class="card-body pt-0">
                                            @foreach (var perm in grupo)
                                            {
                                                string clavePermiso = ObtenerClavePermiso(perm);
                                                bool estaActivo = estadoPermisosSeleccionados.ContainsKey(clavePermiso) && estadoPermisosSeleccionados[clavePermiso];

                                                <div class="d-flex align-items-start py-2 px-3 my-2 rounded hover-bg-white border-bottom border-light">
                                                    <div class="form-check form-switch m-0 p-0 me-3">
                                                        <input class="form-check-input m-0 fs-5 mt-1 cursor-pointer" type="checkbox"
                                                               id="rol_perm_@clavePermiso"
                                                               checked="@estaActivo"
                                                               @onchange="@(e => AlternarPermiso(clavePermiso, e.Value))" />
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <label class="form-check-label cursor-pointer d-block" for="rol_perm_@clavePermiso">
                                                            <span class="fw-bold text-dark small d-block mb-1 lh-1">
                                                                @(string.IsNullOrWhiteSpace(perm.ValorClaim) ? perm.TipoClaim : perm.ValorClaim)
                                                            </span>
                                                            <span class="text-muted d-block" style="font-size: 0.75rem; line-height: 1.3;">@perm.Descripcion</span>
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer border-top-0 pt-3 pb-4 px-4 bg-light">
                    <button type="button" class="btn btn-light fw-semibold text-muted" @onclick="CerrarModales">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4 shadow-sm fw-semibold" @onclick="GuardarPermisos" disabled="@procesando">
                        @if (procesando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Cambios</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 3: ASIGNAR / QUITAR USUARIOS -->
@if (mostrarModalAsignar && rolSeleccionado != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1075;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold text-dark">
                            <i class="bi @(esModoAsignar ? "bi-person-plus-fill text-success" : "bi-person-dash-fill text-warning") me-2"></i>
                            @(esModoAsignar ? "Asignar Funcionarios" : "Remover Funcionarios")
                        </h5>
                        <p class="text-muted small mb-0">Rol: <span class="fw-bold text-primary">@rolSeleccionado.Nombre</span></p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CerrarModales"></button>
                </div>

                <div class="modal-body p-4">
                    @if (usuariosFiltradosBase.Any())
                    {
                        <div class="input-group mb-3">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control bg-light border-start-0" placeholder="Buscar funcionario por nombre o correo..." @bind="terminoBusquedaUsuario" @bind:event="oninput" />
                        </div>

                        <div class="list-group list-group-flush border rounded-3 overflow-auto custom-scroll" style="max-height: 280px;">
                            @foreach (var user in UsuariosFiltradosDisplay)
                            {
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"
                                        @onclick="() => SeleccionarUsuarioParaAccion(user)">
                                    <div>
                                        <div class="fw-bold text-dark">@user.Nombres @user.Apellidos</div>
                                        <div class="small text-muted">@user.Email | <span class="fw-medium">@user.NombreDepartamento</span></div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted"></i>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3">
                            <i class="bi bi-info-circle text-muted fs-4 mb-2 d-block"></i>
                            <p class="text-muted small mb-0">
                                @(esModoAsignar ? "Todos los funcionarios ya tienen este rol asignado." : "Ningún funcionario tiene asignado este rol.")
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 4: CONFIRMAR ACCIÓN USUARIO -->
@if (usuarioParaAccion != null && rolSeleccionado != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1080;">
        <!-- Eliminado modal-sm -->
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="rounded-circle @(esModoAsignar ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi @(esModoAsignar ? "bi-person-plus-fill" : "bi-person-dash-fill") fs-2"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark">¿Confirmar Acción?</h5>
                    <p class="text-muted small mb-0">
                        @(esModoAsignar ? "Asignarás" : "Quitarás") el rol <strong>@rolSeleccionado.Nombre</strong> <br> al funcionario <strong>@usuarioParaAccion.Nombres @usuarioParaAccion.Apellidos</strong>.
                    </p>

                    <!-- Botones horizontales y centrados -->
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-light fw-semibold text-muted px-4" @onclick="() => usuarioParaAccion = null">Cancelar</button>
                        <button class="btn @(esModoAsignar ? "btn-success" : "btn-warning") fw-semibold shadow-sm px-4" @onclick="EjecutarAccionUsuario">Sí, Confirmar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL 5: CONFIRMAR ELIMINAR ROL -->
@if (rolAEliminar != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1085;">
        <!-- Eliminado modal-sm -->
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-trash-fill fs-2"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark">¿Eliminar Rol?</h5>
                    <p class="text-muted small mb-0">
                        Se eliminará permanentemente <strong>@rolAEliminar.Nombre</strong> y se revocará de todos los usuarios asignados.
                    </p>

                    <!-- Botones horizontales y centrados -->
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-light fw-semibold text-muted px-4" @onclick="() => rolAEliminar = null">Cancelar</button>
                        <button class="btn btn-danger fw-semibold shadow-sm px-4" @onclick="EjecutarEliminarRol">Sí, Eliminar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .backdrop-blur {
        background-color: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
    }

    .card-accent-bar {
        height: 4px;
        width: 100%;
        background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
    }

    .role-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .role-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1) !important;
        }

    .role-icon-box {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #2563eb 0%, #1e293b 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.25);
    }

    .hover-danger:hover {
        color: #dc2626 !important;
    }

    .hover-bg-white:hover {
        background-color: #ffffff;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .shadow-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .shadow-hover:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.25);
        }

    .animate-fade-in {
        animation: fadeIn 0.25s ease-out;
    }

    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private List<RoleResponseDto> roles = new();
    private List<UsuarioResponseDto> todosLosUsuarios = new();
    private bool cargando = true;
    private bool procesando = false;

    // Toast
    private string? feedbackMensaje;
    private bool esExitoFeedback;
    private CancellationTokenSource? _toastCts;

    // Modales
    private bool mostrarModalCrear = false;
    private bool mostrarModalPermisos = false;
    private bool mostrarModalAsignar = false;

    // Modelos
    private CreateRoleDto modeloNuevoRol = new();
    private RoleResponseDto? rolSeleccionado;
    private RoleResponseDto? rolAEliminar;
    private UsuarioResponseDto? usuarioParaAccion;

    private List<PermissionDto>? permisosRol = null;
    private Dictionary<string, bool> estadoPermisosSeleccionados = new();
    private List<UsuarioResponseDto> usuariosFiltradosBase = new();
    private string terminoBusquedaUsuario = "";
    private bool esModoAsignar = true;

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            var resRoles = await RoleService.ObtenerTodosLosRolesAsync();
            var listaRoles = resRoles ?? new List<RoleResponseDto>();

            roles = listaRoles
                .OrderByDescending(r => r.Nombre == "AdminSistemas")
                .ThenBy(r => r.Nombre)
                .ToList();

            var resUsuarios = await UserService.ObtenerTodosLosUsuariosAsync();
            todosLosUsuarios = resUsuarios ?? new List<UsuarioResponseDto>();
        }
        catch (Exception ex)
        {
            MostrarError($"Error cargando matriz de roles: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalCrearRol() { modeloNuevoRol = new(); mostrarModalCrear = true; }

    private async Task EjecutarCrearRol()
    {
        procesando = true;
        var resultado = await RoleService.CrearRolAsync(modeloNuevoRol);
        if (resultado.Exitoso)
        {
            MostrarExito(resultado.Mensaje ?? "Rol institucional creado correctamente.");
            CerrarModales();
            await CargarDatos();
        }
        else MostrarError(resultado.Mensaje ?? "No se pudo crear el rol.");
        procesando = false;
    }

    private void SolicitarEliminarRol(RoleResponseDto role) { rolAEliminar = role; }

    private async Task EjecutarEliminarRol()
    {
        if (rolAEliminar == null) return;
        var resultado = await RoleService.EliminarRolAsync(rolAEliminar.Id);
        if (resultado.Exitoso)
        {
            MostrarExito(resultado.Mensaje ?? "Rol eliminado exitosamente.");
            rolAEliminar = null;
            await CargarDatos();
        }
        else MostrarError(resultado.Mensaje ?? "No se pudo eliminar el rol.");
    }

    // --- PERMISOS DE ROL ---
    private async Task AbrirModalPermisos(RoleResponseDto role)
    {
        rolSeleccionado = role;
        mostrarModalPermisos = true;
        permisosRol = null;

        var res = await RoleService.ObtenerPermisosRolAsync(role.Id);
        var listaCruda = res ?? new List<PermissionDto>();

        permisosRol = listaCruda
            .GroupBy(p => ObtenerClavePermiso(p))
            .Select(g => g.First())
            .ToList();

        estadoPermisosSeleccionados = permisosRol.ToDictionary(
            p => ObtenerClavePermiso(p),
            p => p.EstaActivo
        );
    }

    private string ObtenerClavePermiso(PermissionDto p)
    {
        if (string.IsNullOrWhiteSpace(p.ValorClaim))
            return p.TipoClaim;

        return p.ValorClaim;
    }

    private void AlternarPermiso(string clavePermiso, object? val)
    {
        if (val is bool isChecked)
        {
            estadoPermisosSeleccionados[clavePermiso] = isChecked;
        }
    }

    private async Task GuardarPermisos()
    {
        if (rolSeleccionado == null || permisosRol == null) return;
        procesando = true;

        var permisosAEnviar = permisosRol
            .Where(p => estadoPermisosSeleccionados.TryGetValue(ObtenerClavePermiso(p), out bool activo) && activo)
            .ToList();

        var dto = new RolePermissionDto
        {
            RolId = rolSeleccionado.Id,
            Permisos = permisosAEnviar
        };

        var resultado = await RoleService.AsignarPermisosRolAsync(dto);
        if (resultado.Exitoso)
        {
            MostrarExito(resultado.Mensaje ?? "Matriz de permisos del rol actualizada.");
            CerrarModales();
        }
        else MostrarError(resultado.Mensaje ?? "No se pudieron actualizar los permisos del rol.");
        procesando = false;
    }

    private void AbrirModalAsignar(RoleResponseDto role, bool asignando)
    {
        rolSeleccionado = role;
        esModoAsignar = asignando;
        terminoBusquedaUsuario = "";

        if (asignando)
            usuariosFiltradosBase = todosLosUsuarios.Where(u => u.Roles == null || !u.Roles.Contains(role.Nombre)).ToList();
        else
            usuariosFiltradosBase = todosLosUsuarios.Where(u => u.Roles != null && u.Roles.Contains(role.Nombre)).ToList();

        mostrarModalAsignar = true;
    }

    private IEnumerable<UsuarioResponseDto> UsuariosFiltradosDisplay =>
        string.IsNullOrWhiteSpace(terminoBusquedaUsuario)
            ? usuariosFiltradosBase
            : usuariosFiltradosBase.Where(u => $"{u.Nombres} {u.Apellidos}".Contains(terminoBusquedaUsuario, StringComparison.OrdinalIgnoreCase)
                                            || u.Email.Contains(terminoBusquedaUsuario, StringComparison.OrdinalIgnoreCase));

    private void SeleccionarUsuarioParaAccion(UsuarioResponseDto user)
    {
        usuarioParaAccion = user;
    }

    private async Task EjecutarAccionUsuario()
    {
        if (rolSeleccionado == null || usuarioParaAccion == null) return;

        var dto = new AssignRoleDto
        {
            UsuarioId = usuarioParaAccion.Id,
            NombreRol = rolSeleccionado.Nombre
        };

        var resultado = esModoAsignar
            ? await RoleService.AsignarRolUsuarioAsync(dto)
            : await RoleService.DesasignarRolUsuarioAsync(dto);

        if (resultado.Exitoso)
        {
            MostrarExito(resultado.Mensaje ?? (esModoAsignar ? "Rol asignado al funcionario." : "Rol removido del funcionario."));
            usuarioParaAccion = null;
            CerrarModales();
            await CargarDatos();
        }
        else MostrarError(resultado.Mensaje ?? "No se pudo realizar la asignación de rol.");
    }

    private void CerrarModales()
    {
        mostrarModalCrear = false;
        mostrarModalPermisos = false;
        mostrarModalAsignar = false;
        rolAEliminar = null;
        usuarioParaAccion = null;
        permisosRol = null;
    }

    private void MostrarExito(string msg) => LanzarToast(msg, true);
    private void MostrarError(string msg) => LanzarToast(msg, false);

    private void LanzarToast(string msg, bool esExito)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        feedbackMensaje = msg;
        esExitoFeedback = esExito;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                feedbackMensaje = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { }
        }, token);
    }
}