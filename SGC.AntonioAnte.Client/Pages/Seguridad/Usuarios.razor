@page "/seguridad/usuarios"
@attribute [Authorize(Roles = "AdminSistemas,SuperAdmin")]
@using System.Threading
@using Microsoft.AspNetCore.Authorization
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using SGC.AntonioAnte.Shared.DTOs.Common
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Departamentos
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Usuarios
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Roles

@inject IUsuarioService UsuarioService
@inject IDepartamentoService DepartamentoService
@inject IRoleService RoleService

<div class="container-fluid py-4 animate-fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1"><i class="bi bi-people-fill me-2 text-primary"></i>Gestión de Funcionarios</h1>
            <p class="text-muted small mb-0">Administración de la nómina municipal, roles, estado activo y asignación de permisos.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm" @onclick="CargarNominaUsuariosPaginada">
                <i class="bi bi-arrow-clockwise"></i> Refrescar
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-hover py-2 fw-semibold" @onclick="AbrirModalCrear">
                <i class="bi bi-person-plus-fill"></i> Registrar Funcionario
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(toastMensaje))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
            <div class="toast show shadow-lg border-0 bg-white" role="alert">
                <div class="toast-header @(toastEsExito ? "bg-success text-white" : "bg-danger text-white") border-0 py-2">
                    <i class="bi @(toastEsExito ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2 fs-6"></i>
                    <strong class="me-auto">@(toastEsExito ? "Éxito" : "Atención")</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="OcultarToast"></button>
                </div>
                <div class="toast-body fw-medium text-dark py-3">
                    @toastMensaje
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4 bg-white rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <label class="form-label text-muted small fw-bold mb-1">Búsqueda General</label>
                    <div class="position-relative">
                        <input type="text" class="form-control ps-5 py-2" placeholder="Buscar por cédula, nombre o correo..." @bind="busquedaFiltro" @bind:event="oninput" @onkeyup="OnBusquedaKeyUp" />
                        <i class="bi bi-search position-absolute start-0 top-50 translate-middle-y ms-3 text-muted"></i>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Departamento</label>
                    <select class="form-select py-2" @bind="filtroDepartamentoIdStr" @bind:after="OnFiltrosCambiados">
                        <option value="">-- Todos los Departamentos --</option>
                        @if (listaDepartamentos != null)
                        {
                            @foreach (var dep in listaDepartamentos)
                            {
                                <option value="@dep.Id.ToString()">@dep.Nombre</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Estado</label>
                    <select class="form-select py-2" @bind="filtroEstadoTexto" @bind:after="OnFiltrosCambiados">
                        <option value="TODOS">-- Todos los Estados --</option>
                        <option value="ACTIVO">Activos</option>
                        <option value="INACTIVO">Inactivos</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end mt-auto pt-2 pt-md-0">
                    <button class="btn btn-light text-danger border w-100 py-2 fw-semibold" @onclick="LimpiarFiltros" title="Limpiar Filtros">
                        <i class="bi bi-eraser-fill me-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg bg-white overflow-hidden rounded-4">
        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-4 py-3">Funcionario</th>
                        <th class="py-3">Identificación</th>
                        <th class="py-3">Correo Institucional</th>
                        <th class="py-3">Departamento</th>
                        <th class="py-3">Roles</th>
                        <th class="py-3 text-center">Estado</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted fw-medium">Consultando registros en el servidor...</span>
                            </td>
                        </tr>
                    }
                    else if (resultadoPaginado == null || !resultadoPaginado.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                <span class="small fw-semibold">No se encontraron funcionarios que coincidan con los criterios.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var funcionario in resultadoPaginado.Items)
                        {
                            <tr class="funcionario-row @(funcionario.EstadoActivo ? "" : "table-light opacity-75")">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-table">
                                            @(string.IsNullOrEmpty(funcionario.Nombres) ? "U" : funcionario.Nombres[0])@(string.IsNullOrEmpty(funcionario.Apellidos) ? "N" : funcionario.Apellidos[0])
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark lh-1 mb-1">@funcionario.Nombres @funcionario.Apellidos</div>
                                            <span class="text-muted font-monospace" style="font-size: 0.7rem;">ID: @ShortGuid(funcionario.Id)</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 font-monospace fw-semibold text-secondary">@funcionario.Identificacion</td>
                                <td class="py-3"><a href="mailto:@funcionario.Email" class="text-decoration-none">@funcionario.Email</a></td>
                                <td class="py-3">
                                    <span class="badge badge-dep text-dark">@funcionario.NombreDepartamento</span>
                                </td>
                                <td class="py-3">
                                    @if (funcionario.Roles != null && funcionario.Roles.Any())
                                    {
                                        @foreach (var rol in funcionario.Roles)
                                        {
                                            <span class="badge @GetRolBadgeClass(rol) me-1">@rol</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white small">Sin Rol</span>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    @if (funcionario.EstadoActivo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="d-inline-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary rounded-2 btn-action" title="Editar Funcionario" @onclick="() => AbrirModalEditar(funcionario)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary rounded-2 btn-action" title="Asignar Permisos Granulares Directos" @onclick="() => AbrirModalPermisosUsuario(funcionario)">
                                            <i class="bi bi-shield-lock"></i>
                                        </button>
                                        @if (funcionario.EstadoActivo)
                                        {
                                            <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar Funcionario (Soft Delete)" @onclick="() => SolicitarCambioEstado(funcionario)">
                                                <i class="bi bi-person-x-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Restaurar Funcionario" @onclick="() => SolicitarCambioEstado(funcionario)">
                                                <i class="bi bi-person-check-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (resultadoPaginado != null && resultadoPaginado.TotalRegistros > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Mostrando <strong>@(((paginaActual - 1) * registrosPorPagina) + 1)</strong> a
                    <strong>@(Math.Min(paginaActual * registrosPorPagina, resultadoPaginado.TotalRegistros))</strong> de
                    <strong>@resultadoPaginado.TotalRegistros</strong> funcionarios
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Filas:</span>
                        <select class="form-select form-select-sm" style="width: 70px;" value="@registrosPorPagina" @onchange="OnCambiarRegistrosPorPagina">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                        </select>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(resultadoPaginado.TienePaginaAnterior ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(1)" title="Primera página"><i class="bi bi-chevron-double-left"></i></button>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaAnterior ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual - 1)" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                            </li>

                            <li class="page-item disabled">
                                <span class="page-item-text">Página @paginaActual de @resultadoPaginado.TotalPaginas</span>
                            </li>

                            <li class="page-item @(resultadoPaginado.TienePaginaSiguiente ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual + 1)" title="Siguiente"><i class="bi bi-chevron-right"></i></button>
                            </li>
                            <li class="page-item @(resultadoPaginado.TienePaginaSiguiente ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(resultadoPaginado.TotalPaginas)" title="Última página"><i class="bi bi-chevron-double-right"></i></button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

@if (mostrarModalCrear)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus-fill me-2 text-primary"></i>Registrar Funcionario</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalCrear"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalCrearErrorMensaje))
                    {
                        <div class="alert alert-danger border-0 shadow-sm small mb-3 rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @modalCrearErrorMensaje
                        </div>
                    }

                    <EditForm Model="@modeloCreacion" OnValidSubmit="GuardarNuevoFuncionario">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtCedula" class="form-control" placeholder="100xxxxxxx" @bind-Value="modeloCreacion.Identificacion" maxlength="10" disabled="@procesandoModalCrear" />
                                    <label for="txtCedula">Identificación (Cédula)</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Identificacion)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtEmail" class="form-control" placeholder="nombre@antonioante.gob.ec" @bind-Value="modeloCreacion.Email" disabled="@procesandoModalCrear" />
                                    <label for="txtEmail">Correo Institucional</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Email)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtNombres" class="form-control" placeholder="Nombres" @bind-Value="modeloCreacion.Nombres" disabled="@procesandoModalCrear" />
                                    <label for="txtNombres">Nombres Completos</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Nombres)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputText id="txtApellidos" class="form-control" placeholder="Apellidos" @bind-Value="modeloCreacion.Apellidos" disabled="@procesandoModalCrear" />
                                    <label for="txtApellidos">Apellidos Completos</label>
                                    <ValidationMessage For="@(() => modeloCreacion.Apellidos)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputSelect id="ddlDepartamentoCrear" class="form-select" @bind-Value="modeloCreacion.DepartamentoId" disabled="@procesandoModalCrear">
                                        <option value="">-- Seleccionar --</option>
                                        @if (listaDepartamentos != null)
                                        {
                                            @foreach (var dep in listaDepartamentos.Where(d => d.EstadoActivo))
                                            {
                                                <option value="@dep.Id">@dep.Nombre</option>
                                            }
                                        }
                                    </InputSelect>
                                    <label for="ddlDepartamentoCrear">Departamento Municipal</label>
                                    <ValidationMessage For="@(() => modeloCreacion.DepartamentoId)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputSelect id="ddlRolCrear" class="form-select" @bind-Value="modeloCreacion.RolAsignado" disabled="@procesandoModalCrear">
                                        <option value="">-- Seleccionar --</option>
                                        @if (listaRoles != null)
                                        {
                                            @foreach (var rol in listaRoles)
                                            {
                                                <option value="@rol.Nombre">@rol.Nombre</option>
                                            }
                                        }
                                    </InputSelect>
                                    <label for="ddlRolCrear">Rol de Seguridad Base</label>
                                    <ValidationMessage For="@(() => modeloCreacion.RolAsignado)" class="text-danger small mt-1" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating position-relative">
                                    <InputText type="@(verPassword ? "text" : "password")" id="txtPassword" class="form-control" placeholder="Password" @bind-Value="modeloCreacion.Password" disabled="@procesandoModalCrear" />
                                    <label for="txtPassword">Contraseña Inicial Temporal</label>
                                    <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-2 me-2 text-muted z-3 text-decoration-none" @onclick="ToggleVerPassword" tabindex="-1" style="box-shadow: none;">
                                        <i class="bi @(verPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                    </button>
                                    <ValidationMessage For="@(() => modeloCreacion.Password)" class="text-danger small mt-1" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light fw-semibold text-muted px-4" @onclick="CerrarModalCrear" disabled="@procesandoModalCrear">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold shadow-sm px-4" disabled="@procesandoModalCrear">
                                @if (procesandoModalCrear)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar Funcionario</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalPermisos && usuarioSeleccionado != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1075;">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 bg-light p-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-sliders me-2 text-primary"></i>Permisos Granulares Especiales</h5>
                        <p class="text-muted small mb-0">
                            Funcionario: <span class="fw-bold text-primary">@usuarioSeleccionado.Nombres @usuarioSeleccionado.Apellidos</span> (@usuarioSeleccionado.Email)
                        </p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CerrarModalPermisos"></button>
                </div>
                <div class="modal-body p-4">
                    @if (permisosUsuario == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                            <span class="text-muted fw-medium">Cargando matriz de permisos del funcionario...</span>
                        </div>
                    }
                    else if (!permisosUsuario.Any())
                    {
                        <div class="text-center py-4 bg-light rounded-3">
                            <p class="text-muted small mb-0">No hay permisos registrados en el catálogo maestro.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var grupo in permisosUsuario.GroupBy(p => string.IsNullOrWhiteSpace(p.Modulo) ? "General" : p.Modulo))
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 border bg-light-subtle rounded-3 shadow-sm">
                                        <div class="card-header bg-transparent fw-bold text-uppercase small text-secondary border-bottom-0 d-flex justify-content-between align-items-center py-3">
                                            <span><i class="bi bi-folder2-open me-2 text-primary"></i>Módulo: @grupo.Key</span>
                                            <span class="badge bg-secondary rounded-pill">@grupo.Count()</span>
                                        </div>
                                        <div class="card-body pt-0">
                                            @foreach (var perm in grupo)
                                            {
                                                string clavePermiso = ObtenerClavePermiso(perm);
                                                bool esHeredado = perm.EsHeredadoDeRol;
                                                bool estaActivo = estadoPermisosSeleccionados.ContainsKey(clavePermiso) && estadoPermisosSeleccionados[clavePermiso];

                                                <div class="d-flex align-items-start py-2 px-3 my-2 rounded hover-bg-white border-bottom border-light">
                                                    <div class="form-check form-switch m-0 p-0 me-3">
                                                        <input class="form-check-input m-0 fs-5 mt-1 cursor-pointer" type="checkbox"
                                                               id="user_perm_@clavePermiso"
                                                               checked="@estaActivo"
                                                               disabled="@esHeredado"
                                                               @onchange="@(e => AlternarPermisoUsuario(clavePermiso, e.Value))" />
                                                    </div>
                                                    <div class="flex-grow-1 w-100">
                                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                                            <label class="form-check-label cursor-pointer fw-bold text-dark small lh-1" for="user_perm_@clavePermiso">
                                                                @(string.IsNullOrWhiteSpace(perm.ValorClaim) ? perm.TipoClaim : perm.ValorClaim)
                                                            </label>

                                                            @if (esHeredado)
                                                            {
                                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                                                                    <i class="bi bi-shield-check me-1"></i> Rol: @perm.NombreRolOrigen
                                                                </span>
                                                            }
                                                            else if (estaActivo)
                                                            {
                                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                                                                    <i class="bi bi-star-fill me-1"></i> Especial Directo
                                                                </span>
                                                            }
                                                        </div>
                                                        <label class="text-muted d-block cursor-pointer" for="user_perm_@clavePermiso" style="font-size: 0.75rem; line-height: 1.3;">@perm.Descripcion</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-3 pb-4 px-4 bg-light">
                    <button type="button" class="btn btn-light fw-semibold text-muted" @onclick="CerrarModalPermisos">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4 shadow-sm fw-semibold" @onclick="GuardarPermisosUsuario" disabled="@guardandoPermisos">
                        @if (guardandoPermisos)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Permisos</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (usuarioEditando != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Funcionario</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEditar"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(modalEditarErrorMensaje))
                    {
                        <div class="alert alert-danger border-0 shadow-sm small mb-3 rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @modalEditarErrorMensaje
                        </div>
                    }

                    <EditForm Model="@modeloEdicion" OnValidSubmit="GuardarEdicion">
                        <DataAnnotationsValidator />

                        <div class="form-floating mb-3">
                            <InputText id="txtEditNombres" class="form-control" @bind-Value="modeloEdicion.Nombres" placeholder="Nombres" />
                            <label for="txtEditNombres">Nombres Completos</label>
                            <ValidationMessage For="@(() => modeloEdicion.Nombres)" class="text-danger small mt-1" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText id="txtEditApellidos" class="form-control" @bind-Value="modeloEdicion.Apellidos" placeholder="Apellidos" />
                            <label for="txtEditApellidos">Apellidos Completos</label>
                            <ValidationMessage For="@(() => modeloEdicion.Apellidos)" class="text-danger small mt-1" />
                        </div>

                        <div class="form-floating mb-3">
                            <InputText id="txtEditEmail" class="form-control" @bind-Value="modeloEdicion.Email" placeholder="Email" />
                            <label for="txtEditEmail">Correo Institucional</label>
                            <ValidationMessage For="@(() => modeloEdicion.Email)" class="text-danger small mt-1" />
                        </div>

                        <div class="form-floating mb-4">
                            <InputSelect id="ddlEditDepartamento" class="form-select" @bind-Value="modeloEdicion.DepartamentoId">
                                <option value="">-- Seleccionar --</option>
                                @if (listaDepartamentos != null)
                                {
                                    @foreach (var dep in listaDepartamentos.Where(d => d.EstadoActivo))
                                    {
                                        <option value="@dep.Id">@dep.Nombre</option>
                                    }
                                }
                            </InputSelect>
                            <label for="ddlEditDepartamento">Departamento Municipal</label>
                            <ValidationMessage For="@(() => modeloEdicion.DepartamentoId)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light fw-semibold text-muted" @onclick="CerrarModalEditar" disabled="@procesandoModalEditar">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-semibold shadow-sm px-4" disabled="@procesandoModalEditar">
                                @if (procesandoModalEditar)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span> <span>Guardando...</span>
                                }
                                else
                                {
                                    <span>Guardar Cambios</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (usuarioAEstadoCambiar != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1080;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg rounded-4 border-0">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        @if (usuarioAEstadoCambiar.EstadoActivo)
                        {
                            <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-person-x-fill fs-2"></i>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="bi bi-person-check-fill fs-2"></i>
                            </div>
                        }
                    </div>
                    <h5 class="fw-bold text-dark mb-1">¿Estás seguro?</h5>
                    <p class="text-muted small mb-0">
                        @(usuarioAEstadoCambiar.EstadoActivo
                            ? $"Vas a desactivar el acceso del funcionario {usuarioAEstadoCambiar.Nombres} {usuarioAEstadoCambiar.Apellidos}."
                            : $"Vas a restaurar el acceso del funcionario {usuarioAEstadoCambiar.Nombres} {usuarioAEstadoCambiar.Apellidos}.")
                    </p>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button class="btn btn-light fw-semibold text-muted px-4" @onclick="() => usuarioAEstadoCambiar = null">Cancelar</button>
                        <button class="btn @(usuarioAEstadoCambiar.EstadoActivo ? "btn-danger" : "btn-success") fw-semibold shadow-sm px-4" @onclick="ConfirmarCambioEstado">
                            Sí, @(usuarioAEstadoCambiar.EstadoActivo ? "Desactivar" : "Activar")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

