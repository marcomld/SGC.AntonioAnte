@page "/seguridad/usuarios"
@attribute [Authorize(Roles = "AdminSistemas")]
@using SGC.AntonioAnte.Shared.DTOs.Seguridad
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using Microsoft.AspNetCore.Authorization
@inject IUsuarioService UsuarioService
@inject NavigationManager Navigation

<div class="container-fluid py-4 animate-fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1"><i class="bi bi-people-fill me-2 text-primary"></i>Gestión de Funcionarios</h1>
            <p class="text-muted small mb-0">Administración granular de usuarios, auditoría de credenciales corporativas y asignación de alcances catastrales.</p>
        </div>
        <a href="seguridad/registrar-usuario" class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-hover py-2 fw-semibold">
            <i class="bi bi-person-plus-fill"></i> Registrar Funcionario
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-10 col-md-4 position-relative">
                    <input type="text" class="form-control ps-5" placeholder="Buscar por cédula, nombre o correo..." @bind-value="busquedaFiltro" @bind-value:event="oninput" />
                    <i class="bi bi-search position-absolute start-0 top-0 mt-2.5 ms-4 text-muted"></i>
                </div>
                <div class="col-2 col-md-2">
                    <button class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2" @onclick="CargarNominaUsuarios">
                        <i class="bi bi-arrow-clockwise"></i> <span class="d-none d-md-inline">Refrescar</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-lg bg-white overflow-hidden">
        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-4 py-3">Funcionario</th>
                        <th class="py-3">Identificación</th>
                        <th class="py-3">Correo Institucional</th>
                        <th class="py-3">Departamento</th>
                        <th class="py-3">Rol Base</th>
                        <th class="text-end pe-4 py-3">Acciones de Seguridad</th>
                    </tr>
                </thead>
                <tbody>
                    @if (listaUsuariosFiltrada == null)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted fw-medium">Consultando registros auditados en el servidor...</span>
                            </td>
                        </tr>
                    }
                    else if (!listaUsuariosFiltrada.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                <span class="small fw-semibold">No se encontraron funcionarios activos que coincidan con la búsqueda.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var funcionario in listaUsuariosFiltrada)
                        {
                            <tr class="funcionario-row">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-table">@funcionario.Nombres[0]@funcionario.Apellidos[0]</div>
                                        <div>
                                            <div class="fw-bold text-dark lh-1 mb-1">@funcionario.Nombres @funcionario.Apellidos</div>
                                            <span class="text-muted" style="font-size: 0.75rem;">ID Interno: GUID Generado</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 font-monospace fw-semibold text-secondary">@funcionario.Identificacion</td>
                                <td class="py-3"><a href="mailto:@funcionario.Email" class="text-decoration-none">@funcionario.Email</a></td>
                                <td class="py-3">
                                    <span class="badge badge-dep text-dark">@funcionario.Departamento</span>
                                </td>
                                <td class="py-3">
                                    <span class="badge @GetRolBadgeClass(funcionario.RolAsignado)">@funcionario.RolAsignado</span>
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 shadow-sm rounded-2 btn-action" @onclick="@(() => IrAPermisos(funcionario.Identificacion))">
                                        <i class="bi bi-shield-lock"></i> Permisos
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-light-gray {
        background-color: #f8fafc;
    }

    .custom-table tbody tr {
        transition: background-color 0.15s ease;
    }

        .custom-table tbody tr:hover {
            background-color: #f8fafc;
        }

    .avatar-table {
        width: 2.4rem;
        height: 2.4rem;
        background-color: #e2e8f0;
        color: #0f172a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .badge-dep {
        background-color: #f1f5f9;
        border: 1px solid #e2e8f0;
        font-weight: 500;
        font-size: 0.8rem;
        padding: 0.35rem 0.6rem;
        border-radius: 0.5rem;
    }

    .shadow-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .shadow-hover:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.25);
        }

    .btn-action {
        font-size: 0.825rem;
        font-weight: 600;
        border-radius: 0.5rem;
    }

    .animate-fade-in {
        animation: fadeIn 0.25s ease-out;
    }
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private List<CreateUsuarioDto>? nominaUsuarios = null;
    private string busquedaFiltro = string.Empty;

    private IEnumerable<CreateUsuarioDto>? listaUsuariosFiltrada =>
        string.IsNullOrWhiteSpace(busquedaFiltro)
            ? nominaUsuarios
            : nominaUsuarios?.Where(u => u.Nombres.Contains(busquedaFiltro, StringComparison.OrdinalIgnoreCase) ||
                                         u.Apellidos.Contains(busquedaFiltro, StringComparison.OrdinalIgnoreCase) ||
                                         u.Identificacion.Contains(busquedaFiltro) ||
                                         u.Email.Contains(busquedaFiltro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CargarNominaUsuarios();
    }

    private async Task CargarNominaUsuarios()
    {
        nominaUsuarios = null;
        nominaUsuarios = await UsuarioService.ObtenerTodosLosUsuariosAsync();
    }

    private void IrAPermisos(string identificacion)
    {
        // Redirecciona pasando la identificación de resguardo para cargar los claims del funcionario
        Navigation.NavigateTo($"/seguridad/permisos?identificacion={Uri.EscapeDataString(identificacion)}");
    }

    private string GetRolBadgeClass(string rol) => rol.ToLower() switch
    {
        "adminsistemas" => "bg-danger text-white border-0 px-2 py-1.5 font-monospace rounded-2 small",
        "jefecatastro" => "bg-primary text-white border-0 px-2 py-1.5 font-monospace rounded-2 small",
        _ => "bg-success text-white border-0 px-2 py-1.5 font-monospace rounded-2 small"
    };
}