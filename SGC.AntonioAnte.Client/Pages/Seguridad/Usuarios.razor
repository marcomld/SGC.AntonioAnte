@code {
    private ResultadoPaginadoDto<UsuarioResponseDto>? resultadoPaginado = null;
    private bool cargando = true;

    // Filtros
    private string busquedaFiltro = string.Empty;
    private string filtroEstadoTexto = "TODOS";
    private string filtroDepartamentoIdStr = "";
    private Guid? filtroDepartamentoId => string.IsNullOrWhiteSpace(filtroDepartamentoIdStr) ? null : Guid.Parse(filtroDepartamentoIdStr);
    private int paginaActual = 1;
    private int registrosPorPagina = 10;
    private System.Threading.Timer? _debounceTimer;

    // Listas auxiliares
    private List<DepartamentoDto>? listaDepartamentos = null;
    private List<RoleResponseDto>? listaRoles = null;

    private string toastMensaje = string.Empty;
    private bool toastEsExito = true;
    private CancellationTokenSource? toastCts;

    // Estado Modales
    private bool mostrarModalCrear = false;
    private bool procesandoModalCrear = false;
    private string modalCrearErrorMensaje = string.Empty;
    private CreateUsuarioDto modeloCreacion = new();
    private bool verPassword = false;

    private bool mostrarModalPermisos = false;
    private bool guardandoPermisos = false;
    private UsuarioResponseDto? usuarioSeleccionado = null;
    private List<PermissionDto>? permisosUsuario = null;
    private Dictionary<string, bool> estadoPermisosSeleccionados = new();

    private UsuarioResponseDto? usuarioAEstadoCambiar = null;

    private UsuarioResponseDto? usuarioEditando = null;
    private UpdateUsuarioDto modeloEdicion = new();
    private string modalEditarErrorMensaje = string.Empty;
    private bool procesandoModalEditar = false;

    protected override async Task OnInitializedAsync()
    {
        listaDepartamentos = await DepartamentoService.ObtenerTodosAsync();
        listaRoles = await RoleService.ObtenerTodosLosRolesAsync();
        await CargarNominaUsuariosPaginada();
    }

    private async Task CargarNominaUsuariosPaginada()
    {
        cargando = true;
        bool? estadoActivo = filtroEstadoTexto switch
        {
            "ACTIVO" => true,
            "INACTIVO" => false,
            _ => null
        };

        resultadoPaginado = await UsuarioService.ObtenerUsuariosPaginadosAsync(
            busquedaFiltro,
            estadoActivo,
            filtroDepartamentoId,
            paginaActual,
            registrosPorPagina);

        cargando = false;
    }

    private void OnBusquedaKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                paginaActual = 1;
                await CargarNominaUsuariosPaginada();
                StateHasChanged();
            });
        }, null, 350, Timeout.Infinite);
    }

    private async Task OnFiltrosCambiados()
    {
        paginaActual = 1;
        await CargarNominaUsuariosPaginada();
    }

    private async Task LimpiarFiltros()
    {
        busquedaFiltro = string.Empty;
        filtroDepartamentoIdStr = string.Empty;
        filtroEstadoTexto = "TODOS";
        paginaActual = 1;
        await CargarNominaUsuariosPaginada();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || (resultadoPaginado != null && nuevaPagina > resultadoPaginado.TotalPaginas)) return;
        paginaActual = nuevaPagina;
        await CargarNominaUsuariosPaginada();
    }

    private async Task OnCambiarRegistrosPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoTam))
        {
            registrosPorPagina = nuevoTam;
            paginaActual = 1;
            await CargarNominaUsuariosPaginada();
        }
    }

    // --- MÉTODOS CREACIÓN FUNCIONARIO ---
    private void ToggleVerPassword() => verPassword = !verPassword;

    private void AbrirModalCrear()
    {
        modeloCreacion = new CreateUsuarioDto();
        modalCrearErrorMensaje = string.Empty;
        verPassword = false;
        mostrarModalCrear = true;
    }

    private void CerrarModalCrear() => mostrarModalCrear = false;

    private async Task GuardarNuevoFuncionario()
    {
        procesandoModalCrear = true;
        modalCrearErrorMensaje = string.Empty;

        try
        {
            var resultado = await UsuarioService.RegistrarFuncionarioAsync(modeloCreacion);

            if (resultado.Exitoso)
            {
                CerrarModalCrear();
                await CargarNominaUsuariosPaginada();
                await MostrarToast("Funcionario registrado correctamente.", true);
            }
            else
            {
                modalCrearErrorMensaje = resultado.Mensaje ?? "No se pudo registrar el funcionario.";
            }
        }
        catch (Exception ex)
        {
            modalCrearErrorMensaje = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            procesandoModalCrear = false;
        }
    }

    // --- MÉTODOS PERMISOS GRANULARES ---
    private async Task AbrirModalPermisosUsuario(UsuarioResponseDto usuario)
    {
        usuarioSeleccionado = usuario;
        mostrarModalPermisos = true;
        permisosUsuario = null;

        var res = await RoleService.ObtenerPermisosUsuarioAsync(usuario.Id);
        var listaCruda = res ?? new List<PermissionDto>();

        permisosUsuario = listaCruda
            .GroupBy(p => ObtenerClavePermiso(p))
            .Select(g => g.First())
            .ToList();

        estadoPermisosSeleccionados = permisosUsuario.ToDictionary(
            p => ObtenerClavePermiso(p),
            p => p.EstaActivo
        );
    }

    private string ObtenerClavePermiso(PermissionDto p)
    {
        if (string.IsNullOrWhiteSpace(p.ValorClaim))
            return p.TipoClaim;

        return p.ValorClaim;
    }

    private void AlternarPermisoUsuario(string clavePermiso, object? val)
    {
        if (val is bool isChecked)
        {
            estadoPermisosSeleccionados[clavePermiso] = isChecked;
        }
    }

    private async Task GuardarPermisosUsuario()
    {
        if (usuarioSeleccionado == null || permisosUsuario == null) return;
        guardandoPermisos = true;

        var permisosDirectosEspeciales = permisosUsuario
            .Where(p => !p.EsHeredadoDeRol && estadoPermisosSeleccionados.TryGetValue(ObtenerClavePermiso(p), out bool activo) && activo)
            .ToList();

        var dto = new RolePermissionDto
        {
            RolId = usuarioSeleccionado.Id,
            Permisos = permisosDirectosEspeciales
        };

        var resultado = await RoleService.AsignarPermisosUsuarioAsync(dto);

        if (resultado.Exitoso)
        {
            await MostrarToast(resultado.Mensaje ?? "Permisos granulares del funcionario actualizados correctamente.", true);
            CerrarModalPermisos();
        }
        else
        {
            await MostrarToast(resultado.Mensaje ?? "No se pudieron guardar los permisos granulares.", false);
        }

        guardandoPermisos = false;
    }

    private void CerrarModalPermisos()
    {
        mostrarModalPermisos = false;
        usuarioSeleccionado = null;
        permisosUsuario = null;
    }

    // --- MÉTODOS CAMBIO DE ESTADO ---
    private void SolicitarCambioEstado(UsuarioResponseDto funcionario)
    {
        usuarioAEstadoCambiar = funcionario;
    }

    private async Task ConfirmarCambioEstado()
    {
        if (usuarioAEstadoCambiar == null) return;

        var user = usuarioAEstadoCambiar;
        usuarioAEstadoCambiar = null;

        var resultado = await UsuarioService.CambiarEstadoFuncionarioAsync(user.Id);

        if (resultado.Exitoso)
        {
            await CargarNominaUsuariosPaginada();
            await MostrarToast(resultado.Mensaje ?? "Estado actualizado exitosamente.", true);
        }
        else
        {
            await MostrarToast(resultado.Mensaje ?? "No se pudo cambiar el estado del funcionario.", false);
        }
    }

    // --- MÉTODOS EDICIÓN FUNCIONARIO ---
    private void AbrirModalEditar(UsuarioResponseDto funcionario)
    {
        modalEditarErrorMensaje = string.Empty;
        usuarioEditando = funcionario;
        modeloEdicion = new UpdateUsuarioDto
        {
            Nombres = funcionario.Nombres,
            Apellidos = funcionario.Apellidos,
            Email = funcionario.Email,
            DepartamentoId = funcionario.DepartamentoId
        };
    }

    private void CerrarModalEditar()
    {
        usuarioEditando = null;
        modalEditarErrorMensaje = string.Empty;
        modeloEdicion = new UpdateUsuarioDto();
    }

    private async Task GuardarEdicion()
    {
        if (usuarioEditando == null) return;

        procesandoModalEditar = true;
        modalEditarErrorMensaje = string.Empty;

        var resultado = await UsuarioService.ActualizarFuncionarioAsync(usuarioEditando.Id, modeloEdicion);

        if (resultado.Exitoso)
        {
            CerrarModalEditar();
            await CargarNominaUsuariosPaginada();
            await MostrarToast("Datos del funcionario actualizados correctamente.", true);
        }
        else
        {
            modalEditarErrorMensaje = resultado.Mensaje ?? "No se pudo actualizar la información.";
        }

        procesandoModalEditar = false;
    }

    // --- UTILIDADES ---
    private async Task MostrarToast(string mensaje, bool esExito = true)
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        toastMensaje = mensaje;
        toastEsExito = esExito;
        StateHasChanged();

        try
        {
            await Task.Delay(4000, toastCts.Token);
            toastMensaje = string.Empty;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void OcultarToast() => toastMensaje = string.Empty;

    private string ShortGuid(Guid id) => id.ToString().Length > 8 ? id.ToString().Substring(0, 8) + "..." : id.ToString();

    private string GetRolBadgeClass(string rol) => rol.ToLower() switch
    {
        "adminsistemas" or "superadmin" => "bg-danger text-white border-0 px-2 py-1 font-monospace rounded-2 small",
        "jefecatastro" => "bg-primary text-white border-0 px-2 py-1 font-monospace rounded-2 small",
        _ => "bg-secondary text-white border-0 px-2 py-1 font-monospace rounded-2 small"
    };
}