@code {
    private ResultadoPaginadoDto<AuditLogResponseDto>? resultadoPaginado;
    private List<UsuarioResponseDto>? listaFuncionarios;
    private bool cargando = true;

    // Filtros
    private string busquedaRapida = string.Empty;
    private DateTime? filtroDesde = null;
    private DateTime? filtroHasta = null;
    private string filtroUsuarioIdStr = string.Empty;

    // Timer Debounce
    private System.Timers.Timer? debounceTimer;

    // Paginación
    private int paginaActual = 1;
    private int registrosPorPagina = 15;

    // Modal
    private AuditLogResponseDto? logSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        listaFuncionarios = await UsuarioService.ObtenerTodosLosUsuariosAsync();
        await CargarBitacora();
    }

    private async Task CargarBitacora()
    {
        cargando = true;

        Guid? usuarioGuid = string.IsNullOrWhiteSpace(filtroUsuarioIdStr) ? null : Guid.Parse(filtroUsuarioIdStr);

        resultadoPaginado = await AuditoriaService.ConsultarBitacoraAsync(
            filtroDesde,
            filtroHasta,
            usuarioGuid,
            null,
            null,
            busquedaRapida,
            paginaActual,
            registrosPorPagina
        );

        cargando = false;
    }

    private void OnInputBusqueda(ChangeEventArgs e)
    {
        busquedaRapida = e.Value?.ToString() ?? string.Empty;

        debounceTimer?.Stop();
        debounceTimer?.Dispose();

        debounceTimer = new System.Timers.Timer(350);
        debounceTimer.Elapsed += async (s, ev) =>
        {
            debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                paginaActual = 1;
                await CargarBitacora();
                StateHasChanged();
            });
        };
        debounceTimer.Start();
    }

    private async Task OnCambiarFechaDesde(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out DateTime fecha))
            filtroDesde = fecha;
        else
            filtroDesde = null;

        paginaActual = 1;
        await CargarBitacora();
    }

    private async Task OnCambiarFechaHasta(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out DateTime fecha))
            filtroHasta = fecha;
        else
            filtroHasta = null;

        paginaActual = 1;
        await CargarBitacora();
    }

    private async Task OnCambiarFuncionario(ChangeEventArgs e)
    {
        filtroUsuarioIdStr = e.Value?.ToString() ?? string.Empty;
        paginaActual = 1;
        await CargarBitacora();
    }

    private async Task LimpiarFiltros()
    {
        busquedaRapida = string.Empty;
        filtroDesde = null;
        filtroHasta = null;
        filtroUsuarioIdStr = string.Empty;
        paginaActual = 1;
        await CargarBitacora();
    }

    private async Task RefrescarBitacora() => await CargarBitacora();

    private async Task IrAPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || (resultadoPaginado != null && nuevaPagina > resultadoPaginado.TotalPaginas)) return;
        paginaActual = nuevaPagina;
        await CargarBitacora();
    }

    private async Task OnCambiarRegistrosPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoTam))
        {
            registrosPorPagina = nuevoTam;
            paginaActual = 1;
            await CargarBitacora();
        }
    }

    private void AbrirModalDetalle(AuditLogResponseDto log) => logSeleccionado = log;
    private void CerrarModalDetalle() => logSeleccionado = null;

    private string GetBadgeAccion(string accion) => accion.ToUpper() switch
    {
        string a when a.StartsWith("CREAR") || a.StartsWith("REGISTRAR") => "badge-audit badge-crear",
        string a when a.StartsWith("ACTUALIZAR") || a.StartsWith("EDITAR") => "badge-audit badge-actualizar",
        string a when a.StartsWith("ACTIVAR") => "badge-audit badge-activar",
        string a when a.StartsWith("ELIMINAR") || a.StartsWith("DESACTIVAR") || a.StartsWith("DESASIGNAR") => "badge-audit badge-eliminar",
        string a when a.StartsWith("ASIGNAR") || a.Contains("PERMISO") || a.Contains("CLAIM") => "badge-audit badge-asignar",
        string a when a.Contains("LOGIN") || a.Contains("LOGOUT") || a.Contains("PASSWORD") || a.Contains("TOKEN") => "badge-audit badge-login",
        _ => "badge-audit badge-otros"
    };

    public void Dispose()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
    }
}