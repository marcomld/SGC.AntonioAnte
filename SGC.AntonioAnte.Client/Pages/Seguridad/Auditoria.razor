@page "/seguridad/auditoria"
@attribute [Authorize(Roles = "AdminSistemas,SuperAdmin")]
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Auditoria
@using SGC.AntonioAnte.Shared.DTOs.Seguridad.Usuarios
@using SGC.AntonioAnte.Client.Services.Seguridad.Contracts
@using Microsoft.AspNetCore.Authorization

@inject IAuditoriaService AuditoriaService
@inject IUsuarioService UsuarioService

<div class="container-fluid py-4 animate-fade-in">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-journal-text me-2 text-primary"></i>Bitácora de Auditoría y Eventos
            </h1>
            <p class="text-muted small mb-0">Rastreo digital de todas las operaciones, deltas de datos y accesos del sistema municipal.</p>
        </div>
        <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-semibold" @onclick="RefrescarBitacora">
            <i class="bi bi-arrow-clockwise"></i> Refrescar
        </button>
    </div>

    <!-- PANEL DE FILTROS -->
    <div class="card border-0 shadow-sm bg-white mb-4 rounded-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold mb-1">Búsqueda General</label>
                    <div class="position-relative">
                        <input type="text" class="form-control ps-5 py-2" placeholder="Cédula, usuario, IP, acción..." @bind="busquedaRapida" @bind:event="oninput" @keyup="OnKeyUpBusqueda" />
                        <i class="bi bi-search position-absolute start-0 top-50 translate-middle-y ms-3 text-muted"></i>
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label text-muted small fw-bold mb-1">Desde</label>
                    <input type="date" class="form-control py-2" @bind="filtroDesde" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label text-muted small fw-bold mb-1">Hasta</label>
                    <input type="date" class="form-control py-2" @bind="filtroHasta" />
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label text-muted small fw-bold mb-1">Funcionario</label>
                    <select class="form-select py-2" @bind="filtroUsuarioIdStr">
                        <option value="">-- Todos --</option>
                        @if (listaFuncionarios != null)
                        {
                            @foreach (var f in listaFuncionarios)
                            {
                                <option value="@f.Id">@f.Nombres @f.Apellidos</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3 d-flex align-items-end gap-2 mt-auto pt-3 pt-md-0">
                    <button class="btn btn-primary fw-semibold w-100 py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm" @onclick="AplicarFiltros">
                        <i class="bi bi-funnel-fill"></i> Filtrar
                    </button>
                    <button class="btn btn-light text-muted fw-semibold py-2" @onclick="LimpiarFiltros" title="Limpiar Filtros">
                        <i class="bi bi-eraser-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE AUDITORÍA -->
    <div class="card border-0 shadow-lg bg-white overflow-hidden rounded-4">
        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-4 py-3">Timestamp / IP</th>
                        <th class="py-3">Funcionario Origen</th>
                        <th class="py-3 text-center">Acción</th>
                        <th class="py-3 text-center">Entidad</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargando)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                <span class="text-muted fw-medium">Consultando bitácora del servidor...</span>
                            </td>
                        </tr>
                    }
                    else if (resultadoPaginado == null || !resultadoPaginado.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-x display-6 d-block mb-2 opacity-50"></i>
                                <span class="small fw-semibold">No se encontraron eventos registrados con los criterios seleccionados.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in resultadoPaginado.Items)
                        {
                            <tr>
                                <!-- TIMESTAMP / IP -->
                                <td class="ps-4 py-3">
                                    <div class="font-monospace fw-bold text-dark lh-1 mb-1">
                                        @log.FechaCreacion.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </div>
                                    <div class="text-muted font-monospace small" style="font-size: 0.75rem;">
                                        <i class="bi bi-laptop me-1"></i>@log.DireccionIp
                                    </div>
                                </td>

                                <!-- FUNCIONARIO ORIGEN (Avatar gris neutro con separación limpia) -->
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-small flex-shrink-0">
                                            @(string.IsNullOrEmpty(log.NombreUsuario) ? "S" : log.NombreUsuario[0])
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small lh-1 mb-1">@log.NombreUsuario</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">
                                                @(string.IsNullOrEmpty(log.EmailUsuario) ? "Proceso Interno" : log.EmailUsuario)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- ACCIÓN -->
                                <td class="py-3 text-center">
                                    <span class="badge @GetBadgeAccion(log.Accion)">
                                        @log.Accion
                                    </span>
                                </td>

                                <!-- ENTIDAD (Icono de capas/módulos) -->
                                <td class="py-3 text-center">
                                    <span class="badge bg-light text-dark border font-monospace px-2.5 py-1.5 fw-semibold" style="font-size: 0.75rem;">
                                        <i class="bi bi-layers-half me-1 text-primary"></i>@log.Entidad
                                    </span>
                                </td>

                                <!-- BOTÓN DETALLES -->
                                <td class="text-end pe-4 py-3">
                                    <button class="btn btn-sm btn-outline-primary rounded-2 fw-semibold px-3" @onclick="() => AbrirModalDetalle(log)">
                                        <i class="bi bi-eye-fill me-1"></i> Ver Detalle
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- PIE DE PAGINACIÓN -->
        @if (resultadoPaginado != null && resultadoPaginado.TotalRegistros > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Mostrando <strong>@(((paginaActual - 1) * registrosPorPagina) + 1)</strong> a
                    <strong>@(Math.Min(paginaActual * registrosPorPagina, resultadoPaginado.TotalRegistros))</strong> de
                    <strong>@resultadoPaginado.TotalRegistros</strong> eventos auditados
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Filas:</span>
                        <select class="form-select form-select-sm" style="width: 70px;" value="@registrosPorPagina" @onchange="OnCambiarRegistrosPorPagina">
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                <button class="page-item-btn" @onclick="() => IrAPagina(1)" title="Primera página"><i class="bi bi-chevron-double-left"></i></button>
                            </li>
                            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                                <button class="page-item-btn" @onclick="() => IrAPagina(paginaActual - 1)" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                            </li>

                            <li class="page-item disabled">
                                <span class="page-item-text">Página @paginaActual de @resultadoPaginado.TotalPaginas</span>
                            </li>

                            <li class="page-item @(paginaActual >= resultadoPaginado.TotalPaginas ? "disabled" : "")">
                                <button class="page-item-btn" @onclick="() => IrAPagina(paginaActual + 1)" title="Siguiente"><i class="bi bi-chevron-right"></i></button>
                            </li>
                            <li class="page-item @(paginaActual >= resultadoPaginado.TotalPaginas ? "disabled" : "")">
                                <button class="page-item-btn" @onclick="() => IrAPagina(resultadoPaginado.TotalPaginas)" title="Última página"><i class="bi bi-chevron-double-right"></i></button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL DE DETALLE DEL EVENTO -->
@if (logSeleccionado != null)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1075;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark">
                            <i class="bi bi-info-circle-fill me-2 text-primary"></i>Detalle del Evento de Auditoría
                        </h5>
                        <p class="text-muted small mb-0">ID Auditoría: <span class="font-monospace text-primary fw-medium">@logSeleccionado.Id</span></p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CerrarModalDetalle"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <!-- INFORMACIÓN DE ORIGEN -->
                        <div class="col-md-6">
                            <div class="card h-100 border bg-light-subtle rounded-3 p-3">
                                <h6 class="fw-bold text-uppercase text-secondary small mb-3 border-bottom pb-2">
                                    <i class="bi bi-laptop me-1 text-primary"></i> Información de Origen
                                </h6>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Fecha y Hora:</span>
                                    <span class="fw-bold text-dark small font-monospace">@logSeleccionado.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Dirección IP:</span>
                                    <span class="fw-bold text-dark small font-monospace">@logSeleccionado.DireccionIp</span>
                                </div>
                                <div class="mt-2">
                                    <span class="text-muted small d-block mb-1">User Agent / Navegador:</span>
                                    <div class="p-2 bg-white border rounded text-muted font-monospace custom-scroll" style="font-size: 0.7rem; max-height: 65px; overflow-y: auto;">
                                        @logSeleccionado.Navegador
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CONTEXTO OPERATIVO -->
                        <div class="col-md-6">
                            <div class="card h-100 border bg-light-subtle rounded-3 p-3">
                                <h6 class="fw-bold text-uppercase text-secondary small mb-3 border-bottom pb-2">
                                    <i class="bi bi-person-badge me-1 text-primary"></i> Contexto Operativo
                                </h6>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Funcionario Ejecutor:</span>
                                    <span class="fw-bold text-dark small">@logSeleccionado.NombreUsuario</span>
                                    @if (!string.IsNullOrEmpty(logSeleccionado.IdentificacionUsuario))
                                    {
                                        <span class="text-muted small d-block font-monospace">Cédula: @logSeleccionado.IdentificacionUsuario</span>
                                    }
                                    @if (!string.IsNullOrEmpty(logSeleccionado.EmailUsuario))
                                    {
                                        <span class="text-muted small d-block font-monospace">@logSeleccionado.EmailUsuario</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2 pt-2 border-top">
                                    <span class="text-muted small">Acción:</span>
                                    <span class="badge @GetBadgeAccion(logSeleccionado.Accion)">@logSeleccionado.Accion</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small">Entidad Afectada:</span>
                                    <span class="fw-bold text-dark small">@logSeleccionado.Entidad</span>
                                </div>
                                @if (!string.IsNullOrEmpty(logSeleccionado.EntidadId))
                                {
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">ID Entidad:</span>
                                        <span class="font-monospace text-muted small" style="font-size: 0.7rem;">@logSeleccionado.EntidadId</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PAYLOAD / DATOS ADICIONALES -->
                    <label class="form-label fw-bold text-dark mb-1">Datos Adicionales (Payload / Delta Registrado)</label>
                    <div class="p-3 bg-dark text-light rounded-3 font-monospace small overflow-auto custom-scroll" style="max-height: 200px;">
                        <pre class="m-0 text-light" style="white-space: pre-wrap; word-break: break-all; font-size: 0.8rem;">@(string.IsNullOrWhiteSpace(logSeleccionado.DatosAdicionales) ? "Sin datos adicionales registrados." : logSeleccionado.DatosAdicionales)</pre>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0 pb-4 px-4 bg-transparent d-flex justify-content-end">
                    <button type="button" class="btn btn-primary px-4 fw-semibold shadow-sm" @onclick="CerrarModalDetalle">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .backdrop-blur {
        background-color: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(4px);
    }

    .card-accent-bar {
        height: 4px;
        width: 100%;
        background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
    }

    /* Avatar con fondo gris claro neutro y texto sombreado elegante */
    .avatar-small {
        width: 2.3rem;
        height: 2.3rem;
        background-color: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .custom-table tbody tr {
        transition: background-color 0.15s ease;
    }

        .custom-table tbody tr:hover {
            background-color: #f8fafc;
        }

    .page-item-btn {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        padding: 0.35rem 0.65rem;
        font-size: 0.85rem;
        border-radius: 0.375rem;
        transition: all 0.15s ease;
    }

        .page-item-btn:hover:not(:disabled) {
            background-color: #f1f5f9;
            color: #2563eb;
        }

    .page-item-text {
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
    }

    .page-item.disabled .page-item-btn {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .custom-scroll::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }

    .animate-fade-in {
        animation: fadeIn 0.25s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private ResultadoPaginadoAuditDto? resultadoPaginado;
    private List<UsuarioResponseDto>? listaFuncionarios;
    private bool cargando = true;

    // Filtros
    private string busquedaRapida = string.Empty;
    private DateTime? filtroDesde = DateTime.Now.AddDays(-30);
    private DateTime? filtroHasta = DateTime.Now;
    private string filtroUsuarioIdStr = string.Empty;

    // Paginación
    private int paginaActual = 1;
    private int registrosPorPagina = 15;

    // Modal
    private AuditLogResponseDto? logSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        listaFuncionarios = await UsuarioService.ObtenerTodosLosUsuariosAsync();
        await CargarBitacora();
    }

    private async Task CargarBitacora()
    {
        cargando = true;

        Guid? usuarioGuid = string.IsNullOrWhiteSpace(filtroUsuarioIdStr) ? null : Guid.Parse(filtroUsuarioIdStr);

        resultadoPaginado = await AuditoriaService.ConsultarBitacoraAsync(
            filtroDesde,
            filtroHasta,
            usuarioGuid,
            null,
            null,
            busquedaRapida,
            paginaActual,
            registrosPorPagina
        );

        cargando = false;
    }

    private async Task AplicarFiltros()
    {
        paginaActual = 1;
        await CargarBitacora();
    }

    private async Task LimpiarFiltros()
    {
        busquedaRapida = string.Empty;
        filtroDesde = DateTime.Now.AddDays(-30);
        filtroHasta = DateTime.Now;
        filtroUsuarioIdStr = string.Empty;
        paginaActual = 1;
        await CargarBitacora();
    }

    private async Task RefrescarBitacora() => await CargarBitacora();

    private async Task IrAPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || (resultadoPaginado != null && nuevaPagina > resultadoPaginado.TotalPaginas)) return;
        paginaActual = nuevaPagina;
        await CargarBitacora();
    }

    private async Task OnCambiarRegistrosPorPagina(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nuevoTam))
        {
            registrosPorPagina = nuevoTam;
            paginaActual = 1;
            await CargarBitacora();
        }
    }

    private async Task OnKeyUpBusqueda(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AplicarFiltros();
        }
    }

    private void AbrirModalDetalle(AuditLogResponseDto log) => logSeleccionado = log;
    private void CerrarModalDetalle() => logSeleccionado = null;

    private string GetBadgeAccion(string accion) => accion.ToUpper() switch
    {
        string a when a.Contains("CREAR") || a.Contains("REGISTRAR") || a.Contains("INSERT") => "bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-bold small",
        string a when a.Contains("ACTUALIZAR") || a.Contains("EDITAR") || a.Contains("UPDATE") => "bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-bold small",
        string a when a.Contains("ELIMINAR") || a.Contains("DESACTIVAR") || a.Contains("DELETE") => "bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-bold small",
        string a when a.Contains("LOGIN") || a.Contains("ACCESO") => "bg-info-subtle text-dark border border-info-subtle rounded-pill px-2.5 py-1 fw-bold small",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 fw-bold small"
    };
}