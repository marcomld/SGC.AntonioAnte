@page "/administracion/parametros-avaluos"
@attribute [Authorize(Roles = "AdminSistemas,SuperAdmin,JefeCatastro")]

@using System.Threading
@using Microsoft.AspNetCore.Authorization
@using SGC.AntonioAnte.Client.Services.Avaluos.Contracts
@using SGC.AntonioAnte.Client.Services.Catastro.Contracts
@using SGC.AntonioAnte.Domain.Catastro.Enums
@using SGC.AntonioAnte.Shared.DTOs.Avaluos.CostosReposicion
@using SGC.AntonioAnte.Shared.DTOs.Avaluos.FactoresAfectacion
@using SGC.AntonioAnte.Shared.DTOs.Avaluos.FactoresDepreciacion
@using SGC.AntonioAnte.Shared.DTOs.Avaluos.PreciosBaseSuelo
@using SGC.AntonioAnte.Shared.DTOs.Catastro.Catalogos
@using SGC.AntonioAnte.Shared.DTOs.Common

@inject IAvaluosParametrosService ParametrosService
@inject ICatalogoService CatalogoService

<div class="container-fluid py-4 animate-fade-in">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1"><i class="bi bi-cash-coin me-2 text-primary"></i>Parámetros Económicos</h1>
            <p class="text-muted small mb-0">Gestión de catálogos y factores de valoración por Año Fiscal.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="d-flex align-items-center gap-2 bg-white px-3 py-1 rounded-3 border shadow-sm me-2">
                <label class="fw-bold text-muted small mb-0">AÑO FISCAL:</label>
                <select class="form-select form-select-sm text-center fw-bold text-primary border-0 bg-transparent cursor-pointer shadow-none"
                        style="width: 95px; font-size: 1.05rem;"
                        @bind="anioFiscalGlobal"
                        @bind:after="OnAnioFiscalCambiado">
                    @for (int anio = DateTime.Now.Year + 2; anio >= 2010; anio--)
                    {
                        <option value="@anio">@anio</option>
                    }
                </select>
            </div>
            <button class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm" @onclick="CargarDatosTabActivo">
                <i class="bi bi-arrow-clockwise"></i> Refrescar
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2 px-4 shadow-hover py-2 fw-semibold" @onclick="AbrirModalCrearSegunTab">
                <i class="bi bi-plus-lg"></i> @TextoBotonNuevo
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(toastMensaje))
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
            <div class="toast show shadow-lg border-0 bg-white" role="alert">
                <div class="toast-header @(toastEsExito ? "bg-success text-white" : "bg-danger text-white") border-0 py-2">
                    <i class="bi @(toastEsExito ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2 fs-6"></i>
                    <strong class="me-auto">@(toastEsExito ? "Éxito" : "Atención")</strong>
                    <button type="button" class="btn-close btn-close-white" @onclick="OcultarToast"></button>
                </div>
                <div class="toast-body fw-medium text-dark py-3">
                    @toastMensaje
                </div>
            </div>
        </div>
    }

    <ul class="nav nav-tabs px-2" role="tablist" style="border-bottom: 2px solid #2563eb;">
        <li class="nav-item">
            <button class="nav-link rounded-top-2 px-4 @(tabActivo == 1 ? "active text-white bg-primary fw-bold" : "text-dark bg-white border")" @onclick="() => CambiarTab(1)" style="@(tabActivo == 1 ? "border-color: #2563eb;" : "margin-bottom: -2px;")">
                <i class="bi bi-bricks me-1"></i> Costos de Reposición
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-top-2 px-4 ms-1 @(tabActivo == 2 ? "active text-white bg-primary fw-bold" : "text-dark bg-white border")" @onclick="() => CambiarTab(2)" style="@(tabActivo == 2 ? "border-color: #2563eb;" : "margin-bottom: -2px;")">
                <i class="bi bi-geo-alt-fill me-1"></i> Precios de Suelo
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-top-2 px-4 ms-1 @(tabActivo == 3 ? "active text-white bg-primary fw-bold" : "text-dark bg-white border")" @onclick="() => CambiarTab(3)" style="@(tabActivo == 3 ? "border-color: #2563eb;" : "margin-bottom: -2px;")">
                <i class="bi bi-graph-down-arrow me-1"></i> Depreciación
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-top-2 px-4 ms-1 @(tabActivo == 4 ? "active text-white bg-primary fw-bold" : "text-dark bg-white border")" @onclick="() => CambiarTab(4)" style="@(tabActivo == 4 ? "border-color: #2563eb;" : "margin-bottom: -2px;")">
                <i class="bi bi-sliders me-1"></i> Afectación
            </button>
        </li>
    </ul>

    <div class="card border-0 shadow-lg bg-white overflow-hidden rounded-bottom-4 rounded-end-4">
        <div class="card-accent-bar" style="height: 4px; background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);"></div>
        <div class="table-responsive">

            <!-- ========================================== -->
            <!-- TAB 1: COSTOS DE REPOSICIÓN                -->
            <!-- ========================================== -->
            @if (tabActivo == 1)
            {
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4 py-3">Año Fiscal</th>
                            <th class="py-3">Tipo de Estructura</th>
                            <th class="py-3 text-end">Costo / m²</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargandoTab)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                    <span class="text-muted fw-medium">Consultando registros en el servidor...</span>
                                </td>
                            </tr>
                        }
                        else if (costosReposicionPaginado == null || !costosReposicionPaginado.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                    <span class="small fw-semibold">No se encontraron costos de reposición para el año @anioFiscalGlobal.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in costosReposicionPaginado.Items)
                            {
                                <tr class="@(item.EstadoActivo ? "" : "table-light opacity-75")">
                                    <td class="ps-4 py-3 font-monospace fw-bold text-secondary">@item.AnioFiscal</td>
                                    <td class="py-3 fw-bold text-dark">@item.TipoEstructuraNombre</td>
                                    <td class="py-3 text-end font-monospace fw-bold text-primary fs-6">$@item.ValorMetroCuadrado.ToString("N2")</td>
                                    <td class="py-3 text-center">
                                        @if (item.EstadoActivo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-sm btn-outline-secondary rounded-2 btn-action" title="Editar" @onclick="() => AbrirModalEditarCosto(item)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            @if (item.EstadoActivo)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar" @onclick="() => SolicitarCambioEstado(item.Id, item.TipoEstructuraNombre, item.EstadoActivo)">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Activar" @onclick="() => SolicitarCambioEstado(item.Id, item.TipoEstructuraNombre, item.EstadoActivo)">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- ========================================== -->
            <!-- TAB 2: PRECIOS BASE DE SUELO               -->
            <!-- ========================================== -->
            @if (tabActivo == 2)
            {
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4 py-3">Año Fiscal</th>
                            <th class="py-3">Clasificación</th>
                            <th class="py-3 text-center">Zona</th>
                            <th class="py-3 text-center">Sector</th>
                            <th class="py-3 text-center">Manzana / Polígono</th>
                            <th class="py-3 text-end">Valor / m²</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargandoTab)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                    <span class="text-muted fw-medium">Consultando registros en el servidor...</span>
                                </td>
                            </tr>
                        }
                        else if (preciosSueloPaginado == null || !preciosSueloPaginado.Items.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                    <span class="small fw-semibold">No se encontraron precios base de suelo para el año @anioFiscalGlobal.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in preciosSueloPaginado.Items)
                            {
                                <tr class="@(item.EstadoActivo ? "" : "table-light opacity-75")">
                                    <td class="ps-4 py-3 font-monospace fw-bold text-secondary">@item.AnioFiscal</td>
                                    <td class="py-3">
                                        <span class="badge @(item.TipoPredio == TipoPredio.Urbano ? "bg-primary-subtle text-primary border-primary-subtle" : "bg-success-subtle text-success border-success-subtle") border font-monospace">
                                            @item.TipoPredio.ToString().ToUpper()
                                        </span>
                                    </td>
                                    <td class="py-3 text-center font-monospace fw-bold text-dark">@item.Zona</td>
                                    <td class="py-3 text-center font-monospace fw-bold text-dark">@item.Sector</td>
                                    <td class="py-3 text-center font-monospace text-muted">@(string.IsNullOrWhiteSpace(item.ManzanaPoligono) ? "TODOS" : item.ManzanaPoligono)</td>
                                    <td class="py-3 text-end font-monospace fw-bold text-primary fs-6">$@item.ValorMetroCuadrado.ToString("N2")</td>
                                    <td class="py-3 text-center">
                                        @if (item.EstadoActivo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-sm btn-outline-secondary rounded-2 btn-action" title="Editar" @onclick="() => AbrirModalEditarPrecioSuelo(item)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            @if (item.EstadoActivo)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar" @onclick='() => SolicitarCambioEstado(item.Id, $"Zona {item.Zona} - Sector {item.Sector}", item.EstadoActivo)'>
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Activar" @onclick='() => SolicitarCambioEstado(item.Id, $"Zona {item.Zona} - Sector {item.Sector}", item.EstadoActivo)'>
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- ========================================== -->
            <!-- TAB 3: FACTORES DE DEPRECIACIÓN            -->
            <!-- ========================================== -->
            @if (tabActivo == 3)
            {
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4 py-3">Año Fiscal</th>
                            <th class="py-3">Estado de Conservación</th>
                            <th class="py-3 text-center">Rango de Edad (Años)</th>
                            <th class="py-3 text-end">Coeficiente</th>
                            <th class="py-3 text-center">Castigo Aplicado</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargandoTab)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                    <span class="text-muted fw-medium">Consultando registros en el servidor...</span>
                                </td>
                            </tr>
                        }
                        else if (factoresDepreciacionPaginado == null || !factoresDepreciacionPaginado.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                    <span class="small fw-semibold">No se encontraron factores de depreciación para el año @anioFiscalGlobal.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in factoresDepreciacionPaginado.Items)
                            {
                                <tr class="@(item.EstadoActivo ? "" : "table-light opacity-75")">
                                    <td class="ps-4 py-3 font-monospace fw-bold text-secondary">@item.AnioFiscal</td>
                                    <td class="py-3 fw-bold text-dark">
                                        <span class="badge badge-dep text-dark">@item.EstadoConservacionNombre</span>
                                    </td>
                                    <td class="py-3 text-center font-monospace fw-semibold text-dark">@item.EdadMinima a @item.EdadMaxima años</td>
                                    <td class="py-3 text-end font-monospace fw-bold text-primary fs-6">@item.Coeficiente.ToString("N4")</td>
                                    <td class="py-3 text-center font-monospace fw-semibold text-danger">-@((1m - item.Coeficiente).ToString("P1"))</td>
                                    <td class="py-3 text-center">
                                        @if (item.EstadoActivo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-sm btn-outline-secondary rounded-2 btn-action" title="Editar" @onclick="() => AbrirModalEditarDepreciacion(item)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            @if (item.EstadoActivo)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar" @onclick='() => SolicitarCambioEstado(item.Id, $"{item.EstadoConservacionNombre} ({item.EdadMinima}-{item.EdadMaxima} años)", item.EstadoActivo)'>
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Activar" @onclick='() => SolicitarCambioEstado(item.Id, $"{item.EstadoConservacionNombre} ({item.EdadMinima}-{item.EdadMaxima} años)", item.EstadoActivo)'>
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- ========================================== -->
            <!-- TAB 4: FACTORES DE AFECTACIÓN              -->
            <!-- ========================================== -->
            @if (tabActivo == 4)
            {
                <table class="table table-hover align-middle mb-0 custom-table">
                    <thead class="table-light text-uppercase font-monospace text-muted small" style="font-size: 0.75rem;">
                        <tr>
                            <th class="ps-4 py-3">Año Fiscal</th>
                            <th class="py-3">Tipo de Afectación Terreno</th>
                            <th class="py-3 text-end">Coeficiente</th>
                            <th class="py-3 text-center">Estado</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargandoTab)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                    <span class="text-muted fw-medium">Consultando registros en el servidor...</span>
                                </td>
                            </tr>
                        }
                        else if (factoresAfectacionPaginado == null || !factoresAfectacionPaginado.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-symlink-fill display-6 d-block mb-2 opacity-50"></i>
                                    <span class="small fw-semibold">No se encontraron factores de afectación para el año @anioFiscalGlobal.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in factoresAfectacionPaginado.Items)
                            {
                                <tr class="@(item.EstadoActivo ? "" : "table-light opacity-75")">
                                    <td class="ps-4 py-3 font-monospace fw-bold text-secondary">@item.AnioFiscal</td>
                                    <td class="py-3 fw-bold text-dark">@item.TipoAfectacion</td>
                                    <td class="py-3 text-end font-monospace fw-bold text-primary fs-6">@item.Coeficiente.ToString("N4")</td>
                                    <td class="py-3 text-center">
                                        @if (item.EstadoActivo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-x-circle-fill me-1"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-inline-flex gap-1">
                                            <button class="btn btn-sm btn-outline-secondary rounded-2 btn-action" title="Editar" @onclick="() => AbrirModalEditarAfectacion(item)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            @if (item.EstadoActivo)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-2 btn-action" title="Desactivar" @onclick="() => SolicitarCambioEstado(item.Id, item.TipoAfectacion, item.EstadoActivo)">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success rounded-2 btn-action" title="Activar" @onclick="() => SolicitarCambioEstado(item.Id, item.TipoAfectacion, item.EstadoActivo)">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- PAGINADOR TRANSVERSAL -->
        @if (!cargandoTab && TotalRegistrosActual > 0)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="small text-muted">
                    Mostrando <strong>@(((paginaActual - 1) * registrosPorPagina) + 1)</strong> a
                    <strong>@(Math.Min(paginaActual * registrosPorPagina, TotalRegistrosActual))</strong> de
                    <strong>@TotalRegistrosActual</strong> parámetros
                </div>

                <div class="d-flex align-items-center gap-3">
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(paginaActual > 1 ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual - 1)" title="Anterior"><i class="bi bi-chevron-left"></i></button>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-item-text">Página @paginaActual de @TotalPaginasCalculadas</span>
                            </li>
                            <li class="page-item @(paginaActual < TotalPaginasCalculadas ? "" : "disabled")">
                                <button class="page-item-btn" @onclick="() => CambiarPagina(paginaActual + 1)" title="Siguiente"><i class="bi bi-chevron-right"></i></button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: COSTOS DE REPOSICIÓN              -->
<!-- ========================================== -->
@if (mostrarModalFormulario && tabActivo == 1)
{
    <div class="modal fade show d-block backdrop-blur" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">
