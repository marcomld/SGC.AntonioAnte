    // ==========================================
    // GUARDADO POR PESTAÑA
    // ==========================================
    private async Task GuardarCostoReposicion()
    {
        if (modeloCosto.TipoEstructuraId == Guid.Empty)
        {
            modalErrorMensaje = "Debe seleccionar un tipo de estructura.";
            return;
        }

        await EjecutarGuardadoGenerico(
            modeloCosto.AnioFiscal,
            () => registroEnEdicionId.HasValue
                ? ParametrosService.ActualizarCostoReposicionAsync(registroEnEdicionId.Value, modeloCosto)
                : ParametrosService.CrearCostoReposicionAsync(modeloCosto),
            "Costo de reposición guardado correctamente."
        );
    }

    private async Task GuardarPrecioSuelo()
    {
        await EjecutarGuardadoGenerico(
            modeloPrecioSuelo.AnioFiscal,
            () => registroEnEdicionId.HasValue
                ? ParametrosService.ActualizarPrecioSueloAsync(registroEnEdicionId.Value, modeloPrecioSuelo)
                : ParametrosService.CrearPrecioSueloAsync(modeloPrecioSuelo),
            "Precio base de suelo guardado correctamente."
        );
    }

    private async Task GuardarFactorDepreciacion()
    {
        if (modeloDepreciacion.EstadoConservacionId == Guid.Empty)
        {
            modalErrorMensaje = "Debe seleccionar el estado de conservación.";
            return;
        }
        if (modeloDepreciacion.EdadMaxima < modeloDepreciacion.EdadMinima)
        {
            modalErrorMensaje = "La edad máxima no puede ser menor a la edad mínima.";
            return;
        }

        await EjecutarGuardadoGenerico(
            modeloDepreciacion.AnioFiscal,
            () => registroEnEdicionId.HasValue
                ? ParametrosService.ActualizarFactorDepreciacionAsync(registroEnEdicionId.Value, modeloDepreciacion)
                : ParametrosService.CrearFactorDepreciacionAsync(modeloDepreciacion),
            "Factor de depreciación guardado correctamente."
        );
    }

    private async Task GuardarFactorAfectacion()
    {
        await EjecutarGuardadoGenerico(
            modeloAfectacion.AnioFiscal,
            () => registroEnEdicionId.HasValue
                ? ParametrosService.ActualizarFactorAfectacionAsync(registroEnEdicionId.Value, modeloAfectacion)
                : ParametrosService.CrearFactorAfectacionAsync(modeloAfectacion),
            "Factor de afectación guardado correctamente."
        );
    }

    private async Task EjecutarGuardadoGenerico(int anioGuardado, Func<Task<OperacionResultadoDto>> accionServicio, string mensajeExitoFallback)
    {
        procesandoFormulario = true;
        modalErrorMensaje = string.Empty;

        try
        {
            var resultado = await accionServicio();
            if (resultado.Exitoso)
            {
                anioFiscalGlobal = anioGuardado;
                CerrarModalFormulario();
                await CargarDatosTabActivo();
                await MostrarToast(resultado.Mensaje ?? mensajeExitoFallback, true);
            }
            else
            {
                modalErrorMensaje = resultado.Mensaje ?? "No se pudo guardar el parámetro.";
            }
        }
        catch (Exception ex)
        {
            modalErrorMensaje = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            procesandoFormulario = false;
        }
    }

    // ==========================================
    // CAMBIO DE ESTADO UNIFICADO
    // ==========================================
    private void SolicitarCambioEstado(Guid id, string nombre, bool estadoActual)
    {
        idEstadoCambiar = id;
        nombreEstadoCambiar = nombre;
        estadoActualCambiar = estadoActual;
    }

    private async Task ConfirmarCambioEstado()
    {
        if (!idEstadoCambiar.HasValue) return;

        Guid id = idEstadoCambiar.Value;
        string nombre = nombreEstadoCambiar;
        bool estabaActivo = estadoActualCambiar;
        idEstadoCambiar = null;

        OperacionResultadoDto resultado = tabActivo switch
        {
            1 => await ParametrosService.CambiarEstadoCostoReposicionAsync(id),
            2 => await ParametrosService.CambiarEstadoPrecioSueloAsync(id),
            3 => await ParametrosService.CambiarEstadoFactorDepreciacionAsync(id),
            4 => await ParametrosService.CambiarEstadoFactorAfectacionAsync(id),
            _ => OperacionResultadoDto.Fallo("Pestaña no válida.")
        };

        if (resultado.Exitoso)
        {
            await CargarDatosTabActivo();
            bool mostrarVerde = !estabaActivo;
            string msgDefault = mostrarVerde
                ? $"Parámetro '{nombre}' activado correctamente."
                : $"Parámetro '{nombre}' desactivado correctamente.";

            await MostrarToast(resultado.Mensaje ?? msgDefault, mostrarVerde);
        }
        else
        {
            await MostrarToast(resultado.Mensaje ?? "No se pudo cambiar el estado del parámetro.", false);
        }
    }

    private async Task MostrarToast(string mensaje, bool esExito = true)
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        toastMensaje = mensaje;
        toastEsExito = esExito;
        StateHasChanged();

        try
        {
            await Task.Delay(4000, toastCts.Token);
            toastMensaje = string.Empty;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void OcultarToast() => toastMensaje = string.Empty;
}