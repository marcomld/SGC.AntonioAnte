@code {
    private int anioFiscalGlobal = DateTime.Now.Year;
    private int tabActivo = 1;
    private bool cargandoTab = true;
    private int paginaActual = 1;
    private int registrosPorPagina = 10;

    private string toastMensaje = string.Empty;
    private bool toastEsExito = true;
    private CancellationTokenSource? toastCts;

    // Listas Paginadas de las 4 Pestañas
    private ResultadoPaginadoDto<CostoReposicionDto>? costosReposicionPaginado;
    private ResultadoPaginadoDto<PrecioBaseSueloDto>? preciosSueloPaginado;
    private ResultadoPaginadoDto<FactorDepreciacionDto>? factoresDepreciacionPaginado;
    private ResultadoPaginadoDto<FactorAfectacionDto>? factoresAfectacionPaginado;

    // Catálogos Base
    private List<CatalogoDto> tiposEstructuraCatalogo = new();
    private List<CatalogoDto> estadosConservacionCatalogo = new();

    // Estado de Modales de Formulario
    private bool mostrarModalFormulario = false;
    private bool procesandoFormulario = false;
    private string modalErrorMensaje = string.Empty;
    private Guid? registroEnEdicionId = null;

    // Modelos de Formulario
    private UpdateCostoReposicionDto modeloCosto = new();
    private UpdatePrecioBaseSueloDto modeloPrecioSuelo = new();
    private UpdateFactorDepreciacionDto modeloDepreciacion = new();
    private UpdateFactorAfectacionDto modeloAfectacion = new();

    // Estado Modal Confirmación Activar/Desactivar
    private Guid? idEstadoCambiar = null;
    private string nombreEstadoCambiar = string.Empty;
    private bool estadoActualCambiar = false;

    private string TextoBotonNuevo => tabActivo switch
    {
        1 => "Nuevo Costo",
        2 => "Nuevo Precio Suelo",
        3 => "Nuevo Factor Dep.",
        4 => "Nuevo Factor Afec.",
        _ => "Nuevo Parámetro"
    };

    private int TotalRegistrosActual => tabActivo switch
    {
        1 => costosReposicionPaginado?.TotalRegistros ?? 0,
        2 => preciosSueloPaginado?.TotalRegistros ?? 0,
        3 => factoresDepreciacionPaginado?.TotalRegistros ?? 0,
        4 => factoresAfectacionPaginado?.TotalRegistros ?? 0,
        _ => 0
    };

    private int TotalPaginasCalculadas
    {
        get
        {
            if (TotalRegistrosActual == 0) return 1;
            int paginasServidor = tabActivo switch
            {
                1 => costosReposicionPaginado?.TotalPaginas ?? 0,
                2 => preciosSueloPaginado?.TotalPaginas ?? 0,
                3 => factoresDepreciacionPaginado?.TotalPaginas ?? 0,
                4 => factoresAfectacionPaginado?.TotalPaginas ?? 0,
                _ => 0
            };
            return paginasServidor > 0 ? paginasServidor : (int)Math.Ceiling((double)TotalRegistrosActual / registrosPorPagina);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var taskEstructuras = CatalogoService.ObtenerTiposEstructuraAsync();
        var taskConservacion = CatalogoService.ObtenerEstadosConservacionAsync();
        await Task.WhenAll(taskEstructuras, taskConservacion);

        tiposEstructuraCatalogo = await taskEstructuras;
        estadosConservacionCatalogo = await taskConservacion;

        await CargarDatosTabActivo();
    }

    private async Task CambiarTab(int tab)
    {
        tabActivo = tab;
        paginaActual = 1;
        CerrarModalFormulario();
        await CargarDatosTabActivo();
    }

    private async Task OnAnioFiscalCambiado()
    {
        paginaActual = 1;
        await CargarDatosTabActivo();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina < 1 || nuevaPagina > TotalPaginasCalculadas) return;
        paginaActual = nuevaPagina;
        await CargarDatosTabActivo();
    }

    private async Task CargarDatosTabActivo()
    {
        cargandoTab = true;

        switch (tabActivo)
        {
            case 1:
                costosReposicionPaginado = await ParametrosService.ObtenerCostosReposicionPaginadoAsync(anioFiscalGlobal, paginaActual, registrosPorPagina);
                break;
            case 2:
                preciosSueloPaginado = await ParametrosService.ObtenerPreciosSueloPaginadoAsync(anioFiscalGlobal, paginaActual, registrosPorPagina);
                break;
            case 3:
                factoresDepreciacionPaginado = await ParametrosService.ObtenerFactoresDepreciacionPaginadoAsync(anioFiscalGlobal, paginaActual, registrosPorPagina);
                break;
            case 4:
                factoresAfectacionPaginado = await ParametrosService.ObtenerFactoresAfectacionPaginadoAsync(anioFiscalGlobal, paginaActual, registrosPorPagina);
                break;
        }

        cargandoTab = false;
    }

