<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated != true)
                    {
                        <div class="alert alert-warning m-4 shadow-sm">
                            <i class="bi bi-exclamation-triangle"></i> Debes iniciar sesión para acceder.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger m-4 shadow-sm">
                            <i class="bi bi-shield-x"></i> No posees los permisos (Claims) necesarios para ver esta página.
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrado</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="alert alert-secondary m-4 shadow-sm">
                    <i class="bi bi-search"></i> Lo sentimos, no hay nada en esta dirección.
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>